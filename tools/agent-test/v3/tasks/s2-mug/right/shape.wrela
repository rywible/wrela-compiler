use std::field::{Surface, round_cone}

pub fn subject() -> Surface {
    let outer = round_cone(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.5, 0.0), r_top: 0.2, r_bottom: 0.2)
    let inner = round_cone(vec3(0.0, 0.2, 0.0), vec3(0.0, 0.7, 0.0), r_top: 0.17, r_bottom: 0.17)
    let cup = outer.smooth_subtract(inner, k: 0.005).named("cup")
    let top = round_cone(vec3(0.17, 0.36, 0.0), vec3(0.31, 0.36, 0.0), r_top: 0.022, r_bottom: 0.022)
    let side = round_cone(vec3(0.31, 0.14, 0.0), vec3(0.31, 0.36, 0.0), r_top: 0.022, r_bottom: 0.022)
    let low = round_cone(vec3(0.17, 0.14, 0.0), vec3(0.31, 0.14, 0.0), r_top: 0.022, r_bottom: 0.022)
    cup.union(top.union(side).union(low).named("handle"))
}
