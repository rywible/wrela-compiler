use std::field::{Surface, ellipsoid, round_cone}

pub fn subject() -> Surface {
    let tail = 0.4
    let body = ellipsoid(vec3(0.3, 0.15, 0.15)).named("body")
    let end = vec3(-0.3 - tail * 0.0, 0.05, 0.0)
    body.union(round_cone(vec3(-0.25, 0.0, 0.0), end, r_top: 0.04, r_bottom: 0.02).named("tail"))
}
