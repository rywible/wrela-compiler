use std::field::{Surface, round_cone, sphere}

pub fn subject() -> Surface {
    let body = sphere(radius: 0.3).named("body")
    let head = sphere(radius: 0.15).translate(vec3(0.0, 0.62, 0.0)).named("head")
    let neck = round_cone(vec3(0.0, 0.25, 0.0), vec3(0.0, 0.5, 0.0), r_top: 0.05, r_bottom: 0.05).named("neck")
    body.union(neck).union(head)
}
