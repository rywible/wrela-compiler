use shape::subject
use std::field::{Surface, View, coverage, round_cone, sphere}

/// The blueprint: the silhouette the brief describes.
fn blueprint() -> Surface {
    let low = sphere(radius: 0.3).translate(vec3(0.0, 0.3, 0.0))
    let mid = sphere(radius: 0.22).translate(vec3(0.0, 0.76, 0.0))
    let head = sphere(radius: 0.15).translate(vec3(0.0, 1.07, 0.0))
    let nose = round_cone(vec3(0.0, 1.07, 0.1), vec3(0.0, 1.07, 0.29), r_top: 0.035, r_bottom: 0.05).named("nose")
    low.union(mid).union(head).named("snow").union(nose)
}

@test
fn grade_inside_and_outside() {
    let f = subject()
    for p in [
        vec3(0, 0.3, 0),
        vec3(0, 0.76, 0),
        vec3(0, 1.07, 0),
        vec3(0, 1.07, 0.2),
    ] {
        assert(f.distance(p) < 0.0, f"{p.x}, {p.y}, {p.z} should be inside")
    }
    for p in [
        vec3(0, 1.3, 0),
        vec3(0.25, 0.6, 0),
        vec3(0, 1.07, 0.37),
    ] {
        assert(f.distance(p) > 0.0, f"{p.x}, {p.y}, {p.z} should be outside")
    }
}

/// Its front silhouette against the blueprint's: the root mean square difference of
/// their coverage over a 40 by 40 grid, under 0.1.
@test
fn grade_outline() {
    let (f, b) = (subject(), blueprint())
    let lo = vec2(-0.4, -0.05)
    let cell = (vec2(0.4, 1.3) - lo) / 40.0
    var sum = 0.0
    for j in 0..40 {
        for i in 0..40 {
            let c = lo + (vec2(f32(i), f32(j)) + vec2(0.5)) * cell
            let w = max(cell.x, cell.y)
            let d = coverage(f, View::Front, c, w, near: -0.35, far: 0.35) -
                coverage(b, View::Front, c, w, near: -0.35, far: 0.35)
            sum += d * d
        }
    }
    let miss = sqrt(sum / 1600.0)
    assert(miss < 0.1, f"its front outline misses the blueprint's by {miss}")
}
