use shape::subject
use std::field::{Surface, View, coverage, round_cone}

/// The blueprint: the silhouette the brief describes.
fn blueprint() -> Surface {
    let outer = round_cone(vec3(0.0, 0.0, 0.0), vec3(0.0, 0.5, 0.0), r_top: 0.2, r_bottom: 0.2)
    let inner = round_cone(vec3(0.0, 0.2, 0.0), vec3(0.0, 0.7, 0.0), r_top: 0.17, r_bottom: 0.17)
    let cup = outer.smooth_subtract(inner, k: 0.005).named("cup")
    let top = round_cone(vec3(0.17, 0.36, 0.0), vec3(0.31, 0.36, 0.0), r_top: 0.022, r_bottom: 0.022)
    let side = round_cone(vec3(0.31, 0.14, 0.0), vec3(0.31, 0.36, 0.0), r_top: 0.022, r_bottom: 0.022)
    let low = round_cone(vec3(0.17, 0.14, 0.0), vec3(0.31, 0.14, 0.0), r_top: 0.022, r_bottom: 0.022)
    cup.union(top.union(side).union(low).named("handle"))
}

@test
fn grade_inside_and_outside() {
    let f = subject()
    for p in [
        vec3(0.185, 0.25, 0),
        vec3(-0.185, 0.25, 0),
        vec3(0, 0.015, 0),
        vec3(0.31, 0.25, 0),
        vec3(0.25, 0.36, 0),
    ] {
        assert(f.distance(p) < 0.0, f"{p.x}, {p.y}, {p.z} should be inside")
    }
    for p in [
        vec3(0, 0.3, 0),
        vec3(0, 0.45, 0.1),
        vec3(0.26, 0.25, 0),
        vec3(0.0, 0.55, 0),
    ] {
        assert(f.distance(p) > 0.0, f"{p.x}, {p.y}, {p.z} should be outside")
    }
}

/// Its front silhouette against the blueprint's: the root mean square difference of
/// their coverage over a 40 by 40 grid, under 0.1.
@test
fn grade_outline() {
    let (f, b) = (subject(), blueprint())
    let lo = vec2(-0.3, -0.05)
    let cell = (vec2(0.45, 0.6) - lo) / 40.0
    var sum = 0.0
    for j in 0..40 {
        for i in 0..40 {
            let c = lo + (vec2(f32(i), f32(j)) + vec2(0.5)) * cell
            let w = max(cell.x, cell.y)
            let d = coverage(f, View::Front, c, w, near: -0.3, far: 0.3) -
                coverage(b, View::Front, c, w, near: -0.3, far: 0.3)
            sum += d * d
        }
    }
    let miss = sqrt(sum / 1600.0)
    assert(miss < 0.1, f"its front outline misses the blueprint's by {miss}")
}
