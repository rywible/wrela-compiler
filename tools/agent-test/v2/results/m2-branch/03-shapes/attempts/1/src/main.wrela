use std::math::PI

enum Shape: Copy {
    Circle { r: f32 },
    Rect { w: f32, h: f32 },
    Square { side: f32 },
}

fn area(s: Shape) -> f32 {
    match s {
        Shape::Circle { r } => PI * r * r,
        Shape::Rect { w, h } => w * h,
        Shape::Square { side } => side * side,
    }
}

pub fn total() -> f32 {
    area(Shape::Circle { r: 1.0 }) + area(Shape::Rect { w: 2.0, h: 3.0 }) + area(Shape::Square { side: 1.0 })
}

pub fn frame(time: f32, width: u32, height: u32) {}
