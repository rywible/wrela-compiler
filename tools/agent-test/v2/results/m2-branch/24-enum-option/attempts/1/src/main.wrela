enum Cmd: Copy {
    Move(vec2),
    Stop,
}

fn first_move(cmds: [Cmd]) -> Option<vec2> {
    for c in cmds {
        if let Cmd::Move(v) = c {
            return Some(v)
        }
    }
    None
}

pub fn where_first() -> vec2 {
    let cmds = [Cmd::Stop, Cmd::Move(vec2(1.0, 2.0)), Cmd::Move(vec2(3.0, 4.0))]
    match first_move(cmds) {
        Some(v) => v,
        None => vec2(0.0, 0.0),
    }
}

pub fn frame(time: f32, width: u32, height: u32) {}
