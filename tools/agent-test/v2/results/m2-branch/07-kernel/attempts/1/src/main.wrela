use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

struct Grid: Copy + GpuData {
    origin: vec3,
    cell: f32,
    n: u32,
    radius: f32,
}

/// One point of the grid per invocation: its distance to the sphere at the origin.
@compute(64)
fn sphere_distance(grid: Grid, out: mut Slots<f32>, id: GlobalId) {
    let i = id.x
    let c = vec3(f32(i % grid.n), f32((i / grid.n) % grid.n), f32(i / (grid.n * grid.n)))
    let p = grid.origin + c * grid.cell
    out[id] = length(p) - grid.radius
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(4096)
    let grid = Grid { origin: vec3(-1.0), cell: 0.125, n: 16, radius: 0.75 }
    dispatch(sphere_distance.bind(grid, mut out), over: 4096)
}
