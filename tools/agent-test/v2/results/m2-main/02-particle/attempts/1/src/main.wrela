/// A point mass: where it is and how fast it moves, in metres and metres per second.
struct Particle: Copy {
    position: vec3,
    velocity: vec3,
}

/// Advances the particle's position by its velocity over `dt` seconds.
fn step(p: mut Particle, dt: f32) {
    p.position += p.velocity * dt
}

/// A particle that starts at the origin with velocity (1, 2, 0), stepped `steps` times of `dt`.
/// Gives its final x.
pub fn simulate(steps: u32, dt: f32) -> f32 {
    var p = Particle { position: vec3(), velocity: vec3(1.0, 2.0, 0.0) }
    for _ in 0..steps {
        step(mut p, dt)
    }
    p.position.x
}

pub fn frame(time: f32, width: u32, height: u32) {}
