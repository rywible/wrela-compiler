// Raymarch: a unit sphere at the origin, seen from (0, 0, -3), sphere-traced in a fragment shader.
use std::field::{Surface, sphere}
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw}

/// What the fragment shader reads besides the field: the canvas size.
struct Scene: Copy + GpuData {
    resolution: vec2,
}

/// One triangle that covers the screen.
@vertex
fn cover(vertex: VertexIndex) -> ClipPosition {
    let x = f32(vertex.index % 2) * 4.0 - 1.0
    let y = f32(vertex.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

fn trace<F: Surface>(pixel: vec2, scene: Scene, field: F) -> vec4 {
    let eye = vec3(0.0, 0.0, -3.0)
    let uv = (pixel * 2.0 - scene.resolution) / scene.resolution.y
    let forward = vec3(0.0, 0.0, 1.0)
    let right = normalize(cross(forward, vec3(y: 1.0)))
    let up = cross(right, forward)
    let dir = normalize(forward * 1.6 + right * uv.x - up * uv.y)
    var t = 0.0
    var hit = false
    var i = 0
    while i < 64 && !hit && t < 10.0 {
        let d = field.distance(eye + dir * t)
        if d < 0.001 {
            hit = true
        } else {
            t += d
        }
        i += 1
    }
    if !hit {
        return vec4(0.1, 0.1, 0.1, 1.0)
    }
    let p = eye + dir * t
    let n = normalize(field.gradient(p))
    vec4(n * 0.5 + 0.5, 1.0)
}

@fragment
fn shade<F: Surface>(pixel: FragCoord, scene: Scene, field: F) -> vec4 {
    trace(pixel.position.xy, scene, field)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let scene = Scene { resolution: vec2(f32(width), f32(height)) }
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(screen, cover, shade.bind(scene: scene, field: sphere(radius: 1.0)), vertices: 3)
    screen.present()
}
