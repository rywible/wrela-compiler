fn sum(xs: [f32]) -> f32 {
    var total = 0.0
    for x in xs {
        total += x
    }
    total
}

fn largest(xs: [f32; 5]) -> f32 {
    var best = xs[0]
    for x in xs {
        best = max(best, x)
    }
    best
}

pub fn stats() -> vec2 {
    let data = [3.0, -1.0, 4.0, 1.0, 5.0]
    vec2(sum(data), largest(data))
}

pub fn frame(time: f32, width: u32, height: u32) {}
