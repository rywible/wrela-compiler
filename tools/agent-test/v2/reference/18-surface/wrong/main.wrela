use std::field::{Surface, sphere}

struct Cuboid: Copy + GpuData {
    half: vec3,
}

impl Surface for Cuboid {
    /// The exact signed distance of a box centred at the origin.
    fn distance(self, p: vec3) -> f32 {
        let q = abs(p) - self.half
        max(q.x, max(q.y, q.z))
    }
}

pub fn dist(x: f32, y: f32, z: f32) -> f32 {
    let shape = Cuboid { half: vec3(0.5, 0.3, 0.2) }
        .smooth_union(sphere(radius: 0.4).translate(vec3(0.5, 0.0, 0.0)), k: 0.05)
    shape.distance(vec3(x, y, z))
}

pub fn frame(time: f32, width: u32, height: u32) {}
