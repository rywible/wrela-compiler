struct World {
    values: [f32; 8],
}

fn element(w: mut World, i: u32) -> mut f32 {
    mut w.values[i]
}

pub fn bump_fourth() -> f32 {
    var world = World { values: [0.0; 8] }
    mut e = element(mut world, 3)
    e += 1.0
    world.values[4]
}

pub fn frame(time: f32, width: u32, height: u32) {}
