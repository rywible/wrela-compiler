use std::field::{Surface, sphere}
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw}

struct Scene: Copy + GpuData {
    resolution: vec2,
    eye: vec3,
}

/// One triangle over the whole screen.
@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32(v.index % 2) * 4.0 - 1.0
    let y = f32(v.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

@fragment
fn shade<F: Surface>(pixel: FragCoord, scene: Scene, field: F) -> vec4 {
    let uv = (pixel.position.xy * 2.0 - scene.resolution) / scene.resolution.y
    let dir = normalize(vec3(uv.x, -uv.y, 1.5))
    var t = 0.0
    var hit = false
    for _ in 0..64 {
        let d = field.distance(scene.eye + dir * t)
        if d < 0.001 {
            hit = true
            break
        }
        t += d
        if t > 10.0 {
            break
        }
    }
    if !hit {
        return vec4(0.1, 0.1, 0.1, 1.0)
    }
    let n = normalize(field.gradient(scene.eye + dir * t))
    vec4(n * 0.5 + 0.5, 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let scene = Scene { resolution: vec2(f32(width), f32(height)), eye: vec3(0.0, 0.0, -3.0) }
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(screen, cover, shade.bind(scene, sphere(radius: 1.0)), vertices: 3)
    screen.present()
}
