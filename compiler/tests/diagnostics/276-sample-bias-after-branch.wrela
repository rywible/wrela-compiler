// mistake: `sample_bias` after an early return that varies by pixel
// expect: E0608
// fix: no
use std::gpu::{FragCoord, Rgba8, Sampler, Texture}

@fragment
fn paint(pixel: FragCoord, image: Texture<Rgba8>, s: Sampler) -> vec4 {
    if pixel.position.x > 8.0 {
        return vec4(0.0)
    }
    image.sample_bias(s, vec2(0.5, 0.5), 1.0)
}
