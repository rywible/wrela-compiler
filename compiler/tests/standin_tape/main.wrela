// A stand-in that draws a field through its tape (language.md §18.12, plan stage J): `shade`
// marches a creature's compiled field, and its stand-in `shade_taped` marches the same
// creature's tape, read where it lies in a buffer (`std::stage::interpret_at`), the same way.
// The parameters match, so `shade_taped` stands in for `shade` while its pipeline compiles,
// and the first frames show the creature, not a flat colour. compiler/tests/tests/suite/
// standin.rs draws it both ways on the native host, and in Chrome with stand-ins.
use std::field::{Surface, ellipsoid, fbm, round_cone, sphere}
use std::gpu::{ClipPosition, GpuBuffer, VertexIndex, begin_screen_pass, buffer_of, draw}
use std::stage::{Tape, interpret_at}

/// The creature of examples/hello-field, mid-breath (as compiler/tests/fields' corpus has it).
fn creature() -> Surface {
    let body = ellipsoid(vec3(0.62, 0.435, 0.42))
    let neck = round_cone(vec3(0.35, 0.15, 0.0), vec3(0.75, 0.62, 0.0), r_top: 0.16, r_bottom: 0.1)
    let head = sphere(radius: 0.2).translate(vec3(0.82, 0.72, 0.0))
    body
        .smooth_union(neck, k: 0.12)
        .smooth_union(head, k: 0.08)
        .displace(fbm(freq: 6.0, octaves: 3, offset: vec3(3.0, 1.0, 7.0)), amp: 0.015)
}

pub struct State {
    tapes: GpuBuffer<Tape>,
}

pub fn init() -> State {
    State { tapes: buffer_of([creature().to_tape()]) }
}

struct Quad: Copy {
    pos: ClipPosition,
    uv: vec2,
}

/// The whole screen: one triangle past its corners.
@vertex
fn whole(v: VertexIndex) -> Quad {
    let corners = [vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0)]
    let c = corners[v.index]
    Quad { pos: ClipPosition { position: vec4(c, 0.5, 1.0) }, uv: c }
}

/// Where the ray from the pixel's place starts: rays along +z, the screen 2.4 m across round
/// the creature.
fn origin(uv: vec2) -> vec3 {
    vec3(0.2 + 1.2 * uv.x, 0.25 - 1.2 * uv.y, -2.0)
}

/// How far a ray from `o` travels before the creature's compiled field says it meets the
/// surface (4 if it doesn't).
fn march<F: Surface>(field: F, o: vec3) -> f32 {
    var t = 0.0
    for _ in 0..96 {
        let s = field.distance(o + vec3(0.0, 0.0, t))
        if s < 0.001 || t > 4.0 {
            break
        }
        t += s
    }
    min(t, 4.0)
}

/// `march` with the distance from the tape at `tapes[0]`: the same loop.
fn march_taped(tapes: [Tape], o: vec3) -> f32 {
    var t = 0.0
    for _ in 0..96 {
        let s = interpret_at(tapes, 0, o + vec3(0.0, 0.0, t))
        if s < 0.001 || t > 4.0 {
            break
        }
        t += s
    }
    min(t, 4.0)
}

/// Near is bright.
fn grey(t: f32) -> vec4 {
    let v = 1.0 - t / 4.0
    vec4(v, v, v, 1.0)
}

/// The creature, marched through its compiled field.
@fragment
@standin(shade_taped)
fn shade<F: Surface>(q: Quad, field: F, _tapes: [Tape]) -> vec4 {
    grey(march(field, origin(q.uv)))
}

/// The same picture through the field's tape, until `shade` is built.
@fragment
fn shade_taped<F: Surface>(q: Quad, _field: F, tapes: [Tape]) -> vec4 {
    grey(march_taped(tapes, origin(q.uv)))
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    let screen = begin_screen_pass(clear: vec4(0.0))
    draw(screen, whole.bind(), shade.bind(creature(), s.tapes), vertices: 3)
    screen.present()
}
