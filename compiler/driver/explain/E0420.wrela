// An associated constant of a type a build can't fold, or one called as a function. An
// associated constant (`const K: u32` in a trait, `const K: u32 = 4` in an impl) is a `bool`,
// `u32`, `i32`, `f32`, an enum whose variants hold nothing, or a `Text`, and it's named, not
// called: `S::K`. A larger value belongs in a `const` item, which a method can name.
// ---- wrong
trait Taps {
    const AT: vec2
}

struct Four {}

impl Taps for Four {
    const AT: vec2 = vec2(1.0, 2.0)
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
trait Taps {
    const AT_X: f32
    const AT_Y: f32
}

struct Four {}

impl Taps for Four {
    const AT_X: f32 = 1.0
    const AT_Y: f32 = 2.0
}

fn at<S: Taps>() -> vec2 {
    vec2(S::AT_X, S::AT_Y)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let _ = at::<Four>()
}
