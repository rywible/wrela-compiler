// A build's `--set NAME=VALUE` of a constant it can't override: a build sets a `pub const` of
// the program's `main.wrela` whose type is written and is a `bool`, `u32`, `i32`, `f32`, a
// `Text` or an enum whose variants hold nothing. This program is built with `--set TAPS=8`.
// ---- wrong
const TAPS: u32 = 4

pub fn frame(time: f32, width: u32, height: u32) {
    let _ = TAPS
}
// ---- fixed
pub const TAPS: u32 = 4

pub fn frame(time: f32, width: u32, height: u32) {
    let _ = TAPS
}
