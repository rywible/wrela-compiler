// A function that can't be derived (a gradient or an interval): it takes its own gradient
// without end, writes through a place that depends on its input, reads or writes heap memory
// (a `Vec`, a `String`, a `Box`), or calls something that has no derivation (a host call, an
// atomic). The message says which.
//
// Heap memory: a derivation can't follow a float through it, so a derived function reads and
// writes none, and no function it calls puts a value that depends on the input there (what
// read it back would read a constant: a derivative of 0). Keep what depends on the input in
// arrays and values, or make the heap value in a function that takes nothing that depends on
// the input and returns a value: that function isn't derived, and runs as it is.
// ---- wrong
use std::derive::gradient

pub fn tower(x: f32) -> f32 {
    if x > 10.0 {
        return x
    }
    gradient(tower, x + 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
use std::derive::gradient

fn square(x: f32) -> f32 {
    x * x
}

pub fn slope(x: f32) -> f32 {
    gradient(square, x)
}

pub fn frame(time: f32, width: u32, height: u32) {}
