// Lifted literals: a program's `f32` literals, read and changed while it runs, and solved for
// against specs (language.md §23). In a lifted build (`wrela build --lift <package>`), each
// `f32` literal of the chosen packages is read from a table, not built into the code, so a tool
// can change a number while the program runs: a write to the table, never a rebuild. The
// program's CPU code reads the table from memory, and its GPU code from a storage buffer that
// the next dispatch or draw after a change uploads.
//
// The build keeps where each literal is in the source, the text of the files they're in, and
// each file's hash when it was built, so a tool can show a literal's line and write a change
// back (`wrela edit`). In a build that isn't lifted there are no literals: `count()` is 0.

use std::derive::Trace
use std::fmt::{json_number, json_string}
use std::string::String

/// A lifted literal: its place in the table.
pub struct Literal: Copy + Eq + Ord + GpuData {
    pub index: u32,
}

/// Where a literal is: its file (an index, `file_name`), its bytes `start..end` in it, and the
/// line and column it starts at, from 1.
pub struct Source: Copy + Eq {
    pub file: u32,
    pub start: u32,
    pub end: u32,
    pub line: u32,
    pub column: u32,
    /// One unit of the written mantissa, including its exponent and suffix: `15cm` is 0.01,
    /// `2.5e-3cm` is 0.00001, and a plain decimal without an exponent is 1.
    pub unit: f64,
}

/// How many literals this build lifted.
pub fn count() -> u32 {
    literal_count()
}

/// Literal `i`, or `None` past the last.
pub fn literal(i: u32) -> Option<Literal> {
    if i < literal_count() { Some(Literal { index: i }) } else { None }
}

impl Literal {
    /// Its value now.
    pub fn value(self) -> f32 {
        check(self)
        literal_value(self.index)
    }

    /// The value the source gives it: what it had when the program was built.
    pub fn built_value(self) -> f32 {
        check(self)
        literal_built_value(self.index)
    }

    /// Changes its value: code reads the new one from now on, on the CPU and the GPU.
    pub fn set(self, value: f32) {
        check(self)
        set_literal(self.index, value)
    }

    /// Where it is in the source.
    pub fn source(self) -> Source {
        check(self)
        literal_source(self.index)
    }
}

fn check(l: Literal) {
    if l.index >= literal_count() {
        panic("no lifted literal has that index")
    }
}

/// How many source files hold lifted literals.
pub fn files() -> u32 {
    lifted_files()
}

/// File `i`'s name, as diagnostics name it (`[wolf] parts.wrela`).
pub fn file_name(i: u32) -> Text {
    lifted_file(i, 0)
}

/// File `i`'s path on disk, relative to the program's package.
pub fn file_path(i: u32) -> Text {
    lifted_file(i, 1)
}

/// File `i`'s text when the program was built.
pub fn file_text(i: u32) -> Text {
    lifted_file(i, 2)
}

/// File `i`'s hash when the program was built (FNV-1a 64 of its bytes, as 16 hex digits):
/// `wrela edit` refuses to change a file that has changed since.
pub fn file_hash(i: u32) -> Text {
    lifted_file(i, 3)
}

/// The value `f` gives, and how it changes with each literal of `which`, in order: its
/// derivative by each (a parameter gradient). Derived as `gradient` is, forward mode, through
/// everything `f` calls, building values from literals included (§14). It runs on the CPU. In
/// a build that isn't lifted, `which` can't name a literal, so `N` is 0.
@intrinsic
pub fn gradient<const N: u32>(f: fn() -> f32, which: [Literal; N]) -> (f32, [f32; N]) {}

/// `gradient` of a function that gives more than one number (an array of `f32`, a vector, a
/// struct of them): what `f` gives, and for each literal of `which`, in order, how every part of
/// it changes with that literal, as a value of the same type. One derived evaluation gives all of
/// them, where a `gradient` of each part would run `f` again for each.
@intrinsic
pub fn jacobian<const N: u32, R>(f: fn() -> R, which: [Literal; N]) -> (R, [R; N]) {}

/// `f()`, every operation on a literal's path recorded onto `trace`, the literals of `which` its
/// next nodes in order (none where `f` reads none): the value, and its node (as its bits).
@intrinsic
fn recorded<const N: u32>(f: fn() -> f32, which: [Literal; N], trace: mut Trace) -> (f32, f32) {}

/// `gradient` by reverse mode: `f`'s value and its derivative by each literal of `which`, from
/// one recorded evaluation and one sweep back through it (Griewank and Walther), at the cost of
/// a few evaluations however many literals, with no limit of 255 (§23.1). It takes `f` through a
/// parameter, as `Minimize` does, so the code `f` reaches is held to the heap rule alone.
pub fn reverse<const N: u32>(f: fn() -> f32, which: [Literal; N]) -> (f32, [f32; N]) {
    var trace = Trace::new()
    let (value, slot) = recorded(f, which, mut trace)
    (value, adjoints(trace, slot, N))
}

/// `reverse` of a sum of `n` terms, `term(i)` for each `i` below `n`: one record and sweep a
/// term, so the trace holds one term at a time.
pub fn reverse_sum<const N: u32>(
    n: u32,
    term: fn(u32) -> f32,
    which: [Literal; N],
) -> (f32, [f32; N]) {
    var trace = Trace::new()
    var sum = 0.0
    var g: [f32; N] = [0.0; N]
    for i in 0..n {
        trace.clear()
        let (value, slot) = recorded(|| term(i), which, mut trace)
        let d: [f32; N] = adjoints(trace, slot, N)
        sum += value
        for k in 0..N {
            g[k] += d[k]
        }
    }
    (sum, g)
}

/// The adjoints of a record's `N` literals, nodes 1 to `N`, by the value at node `slot`.
fn adjoints<const N: u32>(trace: Trace, slot: f32, n: u32) -> [f32; N] {
    let adj = trace.sweep(bitcast_u32(slot))
    var g: [f32; N] = [0.0; N]
    for k in 0..n {
        if k + 1 < adj.len() {
            g[k] = adj[k + 1]
        }
    }
    g
}

/// The literals `f`'s code can read, through everything it calls on the CPU, in index order:
/// those that can change what it gives. (GPU work it records reads its own literals when it
/// runs.)
@intrinsic
pub fn reads<T>(f: fn() -> T) -> [Literal] {}

/// How many changes the table has had since the program started (`set`, or a host's edit): a
/// program that cooks something from literals compares it with the count it cooked at, to
/// cook again when it changes (`Watch`). 0 in a build that isn't lifted.
pub fn generation() -> u32 {
    literal_generation()
}

/// Literals some work reads, and their values when it last ran: whether any has changed since
/// (`changed`). Made from `reads(f)` of the work.
pub struct Watch {
    literals: Vec<Literal>,
    values: Vec<f32>,
    generation: u32,
    changes: u32,
}

impl Watch {
    /// Watches `literals`, at their values now.
    pub fn new(literals: [Literal]) -> Watch {
        Watch {
            literals: Vec::from(literals),
            values: Vec::from_fn(literals.len(), |i| literals[i].value()),
            generation: generation(),
            changes: 0,
        }
    }

    /// How many times a literal it watches has had a new value, as of its last `changed`: a
    /// key for what's cooked from them (`std::cache::Stale`), which a change makes stale.
    pub fn version(self) -> u32 {
        self.changes
    }

    /// Whether a literal it watches has a new value since it was made or last changed: then it
    /// takes the values now, so it says so once for each change.
    pub fn changed(mut self) -> bool {
        let g = generation()
        if g == self.generation {
            return false
        }
        self.generation = g
        var any = false
        for i in 0..self.literals.len() {
            let v = self.literals[i].value()
            if bitcast_u32(v) != bitcast_u32(self.values[i]) {
                self.values[i] = v
                any = true
            }
        }
        if any {
            self.changes += 1
        }
        any
    }
}

// ---- specs (§23) ---------------------------------------------------------------------------
//
// A spec is what a program's numbers should come to, written as code: `near(name, value,
// target)` and its kin, in a function generic over `Checks`. Run with a `Report`, it says how
// each check stands; with a `Loss`, it's one number a solver (`wrela solve --spec`) makes small
// by changing lifted literals, through `gradient`. `Loss` touches no memory, so the function a
// gradient derives may call it.
//
//     pub fn spec<C: Checks>(c: mut C) {
//         let f = wolf().field()
//         c.near("withers height", top(f, 0.0, 0.20), 0.80)
//         c.at_most("chest width / depth", width(f, 0.55, 0.15) / (top(f, 0.0, 0.15) - bottom(f, 0.0, 0.15)), 0.6)
//     }

/// What a spec's checks go to: a `Report` or a `Loss`.
pub trait Checks {
    /// A check of `value` against `target`, of kind `kind` ("near", "at least" or "at most"):
    /// `miss` is how far it misses (0 where it holds exactly), and `within` how far it may.
    fn check(mut self, name: Text, kind: Text, value: f32, target: f32, miss: f32, within: f32)

    /// `value` should be `target`, give or take `within`.
    fn near(mut self, name: Text, value: f32, target: f32, within: f32 = 0.005) {
        self.check(name, "near", value, target, value - target, within)
    }

    /// `value` should be at least `low` (`within` scales how much a shortfall counts).
    fn at_least(mut self, name: Text, value: f32, low: f32, within: f32 = 0.005) {
        self.check(name, "at least", value, low, min(value - low, 0.0), within)
    }

    /// `value` should be at most `high`.
    fn at_most(mut self, name: Text, value: f32, high: f32, within: f32 = 0.005) {
        self.check(name, "at most", value, high, max(value - high, 0.0), within)
    }
}

/// A spec's checks as one number: the sum of each check's miss over its `within`, squared.
/// 0 when every check holds exactly.
pub struct Loss: Copy {
    pub total: f32,
}

impl Loss {
    /// A loss of 0, before any check.
    pub fn new() -> Loss {
        Loss { total: 0.0 }
    }
}

impl Checks for Loss {
    fn check(mut self, name: Text, kind: Text, value: f32, target: f32, miss: f32, within: f32) {
        let e = miss / max(within, 0.000001)
        self.total += e * e
    }
}

/// A spec's checks as JSON: each one's name, value, target and miss, and whether it holds
/// (within `within`), in the order checked.
pub struct Report {
    pub json: String,
    pub held: u32,
    pub missed: u32,
}

impl Report {
    /// A report with no checks yet.
    pub fn new() -> Report {
        Report { json: String::new(), held: 0, missed: 0 }
    }

    /// The report as one JSON object: the checks, and how many hold.
    pub fn done(self) -> String {
        f"{{\"checks\":[{self.json}],\"held\":{self.held},\"missed\":{self.missed}}}"
    }
}

impl Checks for Report {
    fn check(mut self, name: Text, kind: Text, value: f32, target: f32, miss: f32, within: f32) {
        let ok = abs(miss) <= within
        if ok {
            self.held += 1
        } else {
            self.missed += 1
        }
        if self.json.len() > 0 {
            self.json.push_str(",")
        }
        self.json.push_str("{\"name\":")
        json_string(mut self.json, name)
        self.json.push_str(",\"check\":")
        json_string(mut self.json, kind)
        self.json.push_str(",\"value\":")
        json_number(mut self.json, value)
        self.json.push_str(",\"target\":")
        json_number(mut self.json, target)
        self.json.push_str(",\"miss\":")
        json_number(mut self.json, miss)
        self.json.push_str(",\"within\":")
        json_number(mut self.json, within)
        self.json.push_str(f",\"holds\":{ok}}}".as_str())
    }
}

// ---- minimizing (`wrela solve`) ---------------------------------------------------------------

/// A function of the literals made as small as it gets by changing some of them (`wrela solve`,
/// §23), from their values now:
/// - `run`, any function: BFGS, each step along a line searched until the value falls enough
///   (Armijo's rule), the derivatives from `gradient`, 16 literals at a time.
/// - `fit`, a sum of squares (the function gives the numbers squared): Levenberg–Marquardt, the
///   derivatives of every number from `jacobian`, 16 literals at a time. Each step has what BFGS
///   learns over many, so it takes far fewer.
///
/// Neither tries a step that moves a literal farther than its own size (`within_reach`): its
/// size now, or where the solve began if that was larger, or 1 if it began at 0. A step that
/// would is shortened whole, by the one factor that brings its farthest-reaching literal to its
/// size, so it keeps its direction (the quasi-Newton step's, or Levenberg–Marquardt's).
///
/// Then the literals are rounded to their sources' decimals: all at once where that costs no
/// more than 5% of the solved value; else one at a time, the one that changed most first and
/// the rest solved again with it held, a literal getting more decimals while rounding would
/// cost more than 5% of the value (the last one, against the solved value; each before it, up
/// to three more, against the value before rounding it). Where no number of decimals keeps the
/// cost within that, the literal gets the fewest whose value is within 5% of the least any of
/// them gives: more decimals are kept only for what they buy. Where the rounded literals leave
/// the value above the one before the solve, they stay where they began.
pub struct Minimize {
    free: Vec<Literal>,
    decimals: Vec<u32>,
    units: Vec<f64>,
    start: Vec<f32>,
    finish: Vec<f32>,
    changes: Vec<bool>,
    before: f32,
    solved: f32,
    after: f32,
    steps: u32,
}

impl Minimize {
    /// Nothing free yet.
    pub fn new() -> Minimize {
        Minimize {
            free: Vec::new(),
            decimals: Vec::new(),
            units: Vec::new(),
            start: Vec::new(),
            finish: Vec::new(),
            changes: Vec::new(),
            before: 0.0,
            solved: 0.0,
            after: 0.0,
            steps: 0,
        }
    }

    /// Lets `l` change. Its text has `decimals` decimals of `unit` (`15cm`: 0 decimals of 0.01;
    /// `0.25`: 2 of 1), which rounding keeps.
    pub fn free(mut self, l: Literal, decimals: u32, unit: f64) {
        self.free.push(l)
        self.decimals.push(decimals)
        self.units.push(unit)
    }

    /// Makes `f` as small as it gets over the free literals, in `steps` steps of BFGS at most,
    /// then rounds them to their decimals unless `exact`. The literals are left where it ends.
    pub fn run(mut self, f: fn() -> f32, steps: u32, exact: bool) {
        let n = self.free.len()
        self.start = Vec::from_fn(n, |i| self.free[i].value())
        self.changes = Vec::filled(n, value: false)
        self.before = f32(loss_at(self.free, f, self.start))
        let (x, taken) = bfgs(
            self.free,
            f,
            self.start,
            began: self.start,
            moves: Vec::filled(n, value: true),
            steps: steps,
            changes: mut self.changes,
        )
        self.steps = taken
        self.solved = f32(loss_at(self.free, f, x))
        self.finish = if exact { take x } else {
            round_solution(
                self.free,
                self.start,
                self.decimals,
                self.units,
                before: f64(self.before),
                solved: f64(self.solved),
                solved_x: x,
                steps: steps,
                f: f,
                numbers: || [0.0],
                fit: false,
                changes: mut self.changes,
            )
        }
        self.after = f32(loss_at(self.free, f, self.finish))
    }

    /// Makes the sum of the squares of the numbers `f` gives as small as it gets over the free
    /// literals (a least-squares fit: each number is how far something misses), in `steps`
    /// steps of Levenberg–Marquardt at most, then rounds them to their decimals unless `exact`.
    /// The literals are left where it ends. `before`, `solved` and `after` are that sum.
    pub fn fit<const M: u32>(mut self, f: fn() -> [f32; M], steps: u32, exact: bool) {
        let n = self.free.len()
        self.start = Vec::from_fn(n, |i| self.free[i].value())
        self.changes = Vec::filled(n, value: false)
        self.before = f32(squares_at(self.free, f, self.start))
        if steps == 0 {
            // No step takes the derivatives: once here, for `changes`.
            jacobian_at(
                self.free,
                f,
                self.start,
                moves: Vec::filled(n, value: true),
                changes: mut self.changes,
            )
        }
        let (x, taken) = least_squares(
            self.free,
            f,
            self.start,
            began: self.start,
            moves: Vec::filled(n, value: true),
            steps: steps,
            changes: mut self.changes,
        )
        self.steps = taken
        self.solved = f32(squares_at(self.free, f, x))
        self.finish = if exact { take x } else {
            round_solution(
                self.free,
                self.start,
                self.decimals,
                self.units,
                before: f64(self.before),
                solved: f64(self.solved),
                solved_x: x,
                steps: steps,
                f: || 0.0,
                numbers: f,
                fit: true,
                changes: mut self.changes,
            )
        }
        self.after = f32(squares_at(self.free, f, self.finish))
    }

    /// What was made small (`f`'s value, or a fit's sum of squares) at the literals' values
    /// before.
    pub fn before(self) -> f32 {
        self.before
    }

    /// It where the solve stopped, before rounding.
    pub fn solved(self) -> f32 {
        self.solved
    }

    /// It where the solve ended, rounded.
    pub fn after(self) -> f32 {
        self.after
    }

    /// The steps the solve took before rounding.
    pub fn steps(self) -> u32 {
        self.steps
    }

    /// Free literal `i`'s value before (in the order they were freed).
    pub fn start(self, i: u32) -> f32 {
        self.start[i]
    }

    /// Free literal `i`'s value where it ended.
    pub fn finish(self, i: u32) -> f32 {
        self.finish[i]
    }

    /// Whether what was made small changed with free literal `i` anywhere the solve took its
    /// derivatives (each step's point, and each solve again while rounding): `false` when its
    /// derivative by the literal was 0 every time, so the solve left the literal where it was.
    /// Then nothing on the function's path reads the literal, or the function doesn't change
    /// with it anywhere the solve went.
    pub fn changes(self, i: u32) -> bool {
        self.changes[i]
    }
}

/// What a solve makes small, with the literals `free` set to `x`: `f`'s value, or for a `fit`
/// the sum of the squares of `numbers`'. (Both are passed, since a closure can't hold either:
/// the one that isn't the solve's is never called.)
fn value_at<const M: u32>(
    free: [Literal],
    x: [f32],
    f: fn() -> f32,
    numbers: fn() -> [f32; M],
    fit: bool,
) -> f64 {
    if fit { squares_at(free, numbers, x) } else { loss_at(free, f, x) }
}

/// The solve again from `x`, over the literals `moves` lets change: where it stops. `changes`
/// notes the literals a derivative it takes isn't 0 by.
fn solved_again<const M: u32>(
    free: [Literal],
    x: [f32],
    began: [f32],
    moves: [bool],
    steps: u32,
    f: fn() -> f32,
    numbers: fn() -> [f32; M],
    fit: bool,
    changes: mut Vec<bool>,
) -> Vec<f32> {
    if fit {
        let (again, _) = least_squares(free, numbers, x, began, moves, steps, mut changes)
        take again
    } else {
        let (again, _) = bfgs(free, f, x, began, moves, steps, mut changes)
        take again
    }
}

/// The solution `solved_x` rounded (`rounded`), or the literals where they began (`start`,
/// whose value is `before`) where rounding left the value above `before`: a solve never leaves
/// what it makes small larger than it found it.
fn round_solution<const M: u32>(
    free: [Literal],
    start: [f32],
    decimals: [u32],
    units: [f64],
    before: f64,
    solved: f64,
    solved_x: [f32],
    steps: u32,
    f: fn() -> f32,
    numbers: fn() -> [f32; M],
    fit: bool,
    changes: mut Vec<bool>,
) -> Vec<f32> {
    let x = rounded(
        free,
        start,
        decimals,
        units,
        solved,
        solved_x,
        steps,
        f,
        numbers,
        fit,
        mut changes,
    )
    if !(value_at(free, x, f, numbers, fit) <= before) {
        return Vec::from(start)
    }
    x
}

/// The solution `solved_x` (whose value is `solved`) rounded to the literals' `decimals` of
/// their `units`. All at once, where that leaves the value within `rounding_limit` of `solved`:
/// one evaluation. Else a literal at a time, as `Minimize` says, the rest solved again each
/// time (`value_at`'s `f`, `numbers` and `fit` say what is solved).
fn rounded<const M: u32>(
    free: [Literal],
    start: [f32],
    decimals: [u32],
    units: [f64],
    solved: f64,
    solved_x: [f32],
    steps: u32,
    f: fn() -> f32,
    numbers: fn() -> [f32; M],
    fit: bool,
    changes: mut Vec<bool>,
) -> Vec<f32> {
    let n = solved_x.len()
    var x = Vec::from(solved_x)
    // A literal the solve didn't move keeps its value.
    var held = Vec::from_fn(n, |i| {
        abs(f64(x[i]) - f64(start[i])) <= 1.0e-7 * max(abs(f64(start[i])), 1.0)
    })
    var left = 0
    for i in 0..n {
        if held[i] {
            x[i] = start[i]
        } else {
            left += 1
        }
    }
    let all: Vec<f32> = Vec::from_fn(n, |i| {
        if held[i] { x[i] } else { round_to(x[i], decimals[i], units[i]) }
    })
    if value_at(free, all, f, numbers, fit) <= rounding_limit(solved) {
        return all
    }
    while left > 0 {
        left -= 1
        // The one that changed most (the last of those that changed as much).
        var k = n
        for i in 0..n {
            let change = abs(f64(x[i]) - f64(start[i]))
            if !held[i] && (k == n || change >= abs(f64(x[k]) - f64(start[k]))) {
                k = i
            }
        }
        if k == n {
            break
        }
        var d = decimals[k]
        let unit = units[k]
        var v = round_to(x[k], d, unit)
        let (enough, most) = if left == 0 {
            (rounding_limit(solved), 7)
        } else {
            (rounding_limit(value_at(free, x, f, numbers, fit)), min(d + 3, 7))
        }
        // The value at each number of decimals that isn't within `enough`, from its own.
        var over: Vec<f64> = Vec::new()
        var met = false
        while d < most {
            var trial = x.clone()
            trial[k] = v
            let value = value_at(free, trial, f, numbers, fit)
            if value <= enough {
                met = true
                break
            }
            over.push(value)
            d += 1
            v = round_to(x[k], d, unit)
        }
        if !met && over.len() > 0 {
            var trial = x.clone()
            trial[k] = v
            let value = value_at(free, trial, f, numbers, fit)
            if !(value <= enough) {
                // No number of decimals is within `enough`: the fewest whose value is within
                // the limit of the least any gives, so none is spent on a value out of reach.
                over.push(value)
                let fewest = fewest_decimals(over)
                if fewest < over.len() {
                    d = decimals[k] + fewest
                    v = round_to(x[k], d, unit)
                }
            }
        }
        x[k] = v
        held[k] = true
        if left > 0 {
            let moves = Vec::from_fn(n, |i| !held[i])
            x = solved_again(free, x, start, moves, steps, f, numbers, fit, mut changes)
        }
    }
    x
}

/// Of `values` (a literal's value at each number of decimals, from its own), the first within
/// `rounding_limit` of the least: how many more decimals than its own buy something. Their
/// count where none is a number.
fn fewest_decimals(values: [f64]) -> u32 {
    let n = values.len()
    var least = n
    for j in 0..n {
        let value = values[j]
        if value - value == 0.0 && (least == n || value < values[least]) {
            least = j
        }
    }
    if least == n {
        return n
    }
    let limit = rounding_limit(values[least])
    for j in 0..least {
        if values[j] <= limit {
            return j
        }
    }
    least
}

/// The largest loss rounding may leave: five percent of the loss's magnitude above it. Using
/// the magnitude matters when the objective is negative; multiplying it by 1.05 would instead
/// demand an impossible five-percent improvement.
fn rounding_limit(loss: f64) -> f64 {
    loss + 0.05 * abs(loss) + 1.0e-9
}

/// Sets the literals `free` to `x`, and gives `f` there.
fn loss_at(free: [Literal], f: fn() -> f32, x: [f32]) -> f64 {
    for i in 0..free.len() {
        free[i].set(x[i])
    }
    f64(f())
}

/// From how many free literals a gradient is taken by reverse mode (`reverse`): one recorded
/// evaluation and a sweep for each 256, in place of forward mode's 16 at a time. Measured on a
/// wolf's spec solve on the M4: 1.0 times as fast at 18 literals, 1.32 at 65, 2.66 at 259.
pub const REVERSE_FROM: u32 = 65

/// `f`'s derivative by each of the literals `free` at `x`, 16 at a time by forward mode, or
/// past `REVERSE_FROM` of them 256 at a time by reverse mode; 0 for those `moves` holds still.
/// `changes` notes each literal the derivative isn't 0 by, held still or not.
fn gradient_at(
    free: [Literal],
    f: fn() -> f32,
    x: [f32],
    moves: [bool],
    changes: mut Vec<bool>,
) -> Vec<f64> {
    for i in 0..free.len() {
        free[i].set(x[i])
    }
    let n = free.len()
    var g: Vec<f64> = Vec::new()
    var k = 0
    let reversed = n >= REVERSE_FROM
    let chunk = if reversed { 256 } else { 16 }
    while k < n {
        let m = min(chunk, n - k)
        if reversed {
            // The chunk's first literal fills the rest: a literal named twice is derived once.
            var which = [free[k]; 256]
            for j in 1..m {
                which[j] = free[k + j]
            }
            let (_, d) = reverse(f, which)
            for j in 0..m {
                note(mut g, mut changes, moves[k + j], d[j], k + j)
            }
        } else {
            var which = [free[k]; 16]
            for j in 1..m {
                which[j] = free[k + j]
            }
            let (_, d) = gradient(f, which)
            for j in 0..m {
                note(mut g, mut changes, moves[k + j], d[j], k + j)
            }
        }
        k += chunk
    }
    g
}

/// A literal's derivative into the gradient (0 if it doesn't move), and whether it changes.
fn note(g: mut Vec<f64>, changes: mut Vec<bool>, moves: bool, d: f32, at: u32) {
    if d != 0.0 {
        changes[at] = true
    }
    g.push(if moves { f64(d) } else { 0.0 })
}

/// BFGS from `x0` over the literals `moves` lets change, `steps` steps at most: where it
/// stopped, and the steps it took. `changes` notes the literals a gradient it takes isn't 0 by.
/// `began` is where the whole solve began, for each literal's size (`within_reach`).
fn bfgs(
    free: [Literal],
    f: fn() -> f32,
    x0: [f32],
    began: [f32],
    moves: [bool],
    steps: u32,
    changes: mut Vec<bool>,
) -> (Vec<f32>, u32) {
    let n = x0.len()
    var x: Vec<f64> = Vec::from_fn(n, |i| f64(x0[i]))
    var fx = loss_at(free, f, narrowed(x))
    var g = gradient_at(free, f, narrowed(x), moves, mut changes)
    // The inverse Hessian's estimate, row-major: the identity to begin with.
    var h = identity(n)
    var taken = 0
    for _ in 0..steps {
        let gg = dot(g, g)
        if gg < 1.0e-24 || !(gg - gg == 0.0) {
            break
        }
        var p: Vec<f64> = Vec::from_fn(n, |i| -row_dot(h, i, g))
        var slope = dot(p, g)
        if slope >= 0.0 {
            // Not a way down: the steepest one, and the estimate starts again.
            p = Vec::from_fn(n, |i| -g[i])
            slope = -gg
            h = identity(n)
        }
        // Armijo's rule along the step, halved from 1, the step shortened whole where a literal
        // would go past its own size (`within_reach`). A try the same as the last (the step
        // still shortened to the same literal's size) is passed over, and isn't one of the 40.
        var t: f64 = 1.0
        var x1: Vec<f64> = Vec::new()
        var f1: f64 = 0.0
        var last: Vec<f64> = Vec::new()
        var tries = 0
        while tries < 40 && t > 0.0 {
            let step = within_reach(x, began, p, t)
            if same(step, last) {
                t *= 0.5
                continue
            }
            tries += 1
            let trial: Vec<f64> = Vec::from_fn(n, |i| x[i] + step[i])
            let ft = loss_at(free, f, narrowed(trial))
            // The slope along what was tried: the step's own, where no literal was held.
            let down = if whole(step, p, t) { t * slope } else { dot(step, g) }
            if ft - ft == 0.0 && down < 0.0 && ft <= fx + 1.0e-4 * down {
                x1 = take trial
                f1 = ft
                break
            }
            last = take step
            t *= 0.5
        }
        if x1.len() == 0 {
            break
        }
        let g1 = gradient_at(free, f, narrowed(x1), moves, mut changes)
        let s: Vec<f64> = Vec::from_fn(n, |i| x1[i] - x[i])
        let y: Vec<f64> = Vec::from_fn(n, |i| g1[i] - g[i])
        let sy = dot(s, y)
        taken += 1
        let improved = fx - f1
        x = take x1
        fx = f1
        g = take g1
        if sy > 1.0e-20 {
            // H ← (I − ρ s yᵀ) H (I − ρ y sᵀ) + ρ s sᵀ
            let rho = 1.0 / sy
            let hy: Vec<f64> = Vec::from_fn(n, |i| row_dot(h, i, y))
            let yhy = dot(y, hy)
            for i in 0..n {
                for j in 0..n {
                    h[i * n + j] += rho *
                        ((1.0 + rho * yhy) * s[i] * s[j] - hy[i] * s[j] - s[i] * hy[j])
                }
            }
        }
        if abs(improved) <= 1.0e-12 * max(abs(fx), 1.0e-30) {
            break
        }
    }
    (narrowed(x), taken)
}

/// How far a literal at `x` goes in one step of a solve it began at `began`: its size now, or
/// where the solve began if that was larger (so it can cross 0), or 1 if it began at 0.
fn size(x: f64, began: f32) -> f64 {
    let from = abs(f64(began))
    max(abs(x), if from == 0.0 { 1.0 } else { from })
}

/// `t` of the step `p` from `x`, shortened whole, by one factor, until no literal's part of it
/// is longer than the literal's own `size`.
/// The function's derivatives say nothing of it farther off than that, and a step can be far
/// longer than any literal: BFGS's first is as long as the gradient (its estimate starts as
/// the identity), which for a loss of 1,149 that rises 164 for a thousandth of a second of a
/// key's time was a time of -164,460 s, where one evaluation ran for hours. A literal can
/// still double each step, so one that has far to go gets there in a few.
///
/// The whole step is shortened by one factor, not each literal clamped by itself: a clamp of
/// each changes the step's direction, and the quasi-Newton direction is what the solve learned
/// (on the humanoid's hook with six literals free, clamping each ended at a loss of 36.4 with
/// 38 of 41 checks held; one factor ends at 0.36 with all 41). A literal that began at 0 is
/// sized from where the solve began (`began`), so a re-solve doesn't hold everything to the
/// hair it has moved, which, not the one factor, stopped a solve of ten literals against two
/// outlines at a loss of 52 before.
///
/// A step held to a box and searched by Armijo's rule along what is left of it: D. P.
/// Bertsekas, "On the Goldstein-Levitin-Polyak gradient projection method", IEEE Transactions
/// on Automatic Control 21 (1976). The box as the most a step may go: J. E. Dennis and R. B.
/// Schnabel, "Numerical Methods for Unconstrained Optimization and Nonlinear Equations"
/// (1983), §6.3 and algorithm A6.3.1 (`maxstep`), there one length for the whole step.
fn within_reach(x: [f64], began: [f32], p: [f64], t: f64) -> Vec<f64> {
    var k = 1.0
    for i in 0..x.len() {
        let step = abs(t * p[i])
        let most = size(x[i], began[i])
        if step > most {
            k = min(k, most / step)
        }
    }
    Vec::from_fn(x.len(), |i| k * t * p[i])
}

/// Whether `step` is all of `t` of `p`: no literal's part was held.
fn whole(step: [f64], p: [f64], t: f64) -> bool {
    for i in 0..step.len() {
        if step[i] != t * p[i] {
            return false
        }
    }
    true
}

/// Whether two steps are the same, number for number.
fn same(a: [f64], b: [f64]) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn narrowed(x: [f64]) -> Vec<f32> {
    Vec::from_fn(x.len(), |i| f32(x[i]))
}

fn dot(a: [f64], b: [f64]) -> f64 {
    var sum: f64 = 0.0
    for i in 0..a.len() {
        sum += a[i] * b[i]
    }
    sum
}

/// Row `i` of the square matrix `m` (row-major) times `v`.
fn row_dot(m: [f64], i: u32, v: [f64]) -> f64 {
    let n = v.len()
    var sum: f64 = 0.0
    for j in 0..n {
        sum += m[i * n + j] * v[j]
    }
    sum
}

/// The `n` by `n` identity, row-major.
fn identity(n: u32) -> Vec<f64> {
    Vec::from_fn(n * n, |k| if k % (n + 1) == 0 { 1.0 } else { 0.0 })
}

/// The sum of the squares of the numbers `f` gives with the literals `free` set to `x`.
fn squares_at<const M: u32>(free: [Literal], f: fn() -> [f32; M], x: [f32]) -> f64 {
    for i in 0..free.len() {
        free[i].set(x[i])
    }
    let r = f()
    var sum: f64 = 0.0
    for i in 0..M {
        sum += f64(r[i]) * f64(r[i])
    }
    sum
}

/// The numbers `f` gives with the literals `free` set to `x`, and each one's derivative by each
/// literal (`jacobian`, 16 literals at a time), row by row: number `i`'s by literal `k` is at
/// `i * free.len() + k`, 0 for a literal `moves` holds still. `changes` notes each literal some
/// number's derivative isn't 0 by, held still or not.
fn jacobian_at<const M: u32>(
    free: [Literal],
    f: fn() -> [f32; M],
    x: [f32],
    moves: [bool],
    changes: mut Vec<bool>,
) -> (Vec<f64>, Vec<f64>) {
    for i in 0..free.len() {
        free[i].set(x[i])
    }
    let n = free.len()
    var r: Vec<f64> = Vec::filled(M, value: 0.0)
    var j: Vec<f64> = Vec::filled(M * n, value: 0.0)
    var k = 0
    while k < n {
        var which = [free[k]; 16]
        for c in 1..min(16, n - k) {
            which[c] = free[k + c]
        }
        let (v, d) = jacobian(f, which)
        if k == 0 {
            for i in 0..M {
                r[i] = f64(v[i])
            }
        }
        for c in 0..min(16, n - k) {
            for i in 0..M {
                if d[c][i] != 0.0 {
                    changes[k + c] = true
                }
            }
            if moves[k + c] {
                for i in 0..M {
                    j[i * n + k + c] = f64(d[c][i])
                }
            }
        }
        k += 16
    }
    (r, j)
}

/// The step `d` of (A + λ D) d = −g over the literals `live` (0 for the others), `a` the `n` by
/// `n` matrix A, row-major: by its LDLᵀ factors. D is diagonal: for each literal, the mean of
/// its own entry of A's diagonal and all the live literals' mean (`least_squares` says why).
/// Empty where the matrix isn't positive definite as computed, which more damping mends.
fn damped_step(a: [f64], g: [f64], n: u32, live: [u32], lambda: f64) -> Vec<f64> {
    let k = live.len()
    var c: Vec<f64> = Vec::from_fn(k * k, |t| a[live[t / k] * n + live[t % k]])
    var mean: f64 = 0.0
    for p in 0..k {
        mean += c[p * k + p] / f64(k)
    }
    for p in 0..k {
        c[p * k + p] += lambda * 0.5 * (c[p * k + p] + mean)
    }
    // A unit lower triangle L below the diagonal, and D on it.
    for p in 0..k {
        var dp = c[p * k + p]
        for t in 0..p {
            dp -= c[p * k + t] * c[p * k + t] * c[t * k + t]
        }
        if !(dp > 0.0) {
            return Vec::new()
        }
        c[p * k + p] = dp
        for q in p + 1..k {
            var v = c[q * k + p]
            for t in 0..p {
                v -= c[q * k + t] * c[p * k + t] * c[t * k + t]
            }
            c[q * k + p] = v / dp
        }
    }
    // L y = −g, then D Lᵀ d = y.
    var y: Vec<f64> = Vec::filled(k, value: 0.0)
    for p in 0..k {
        var v = -g[live[p]]
        for t in 0..p {
            v -= c[p * k + t] * y[t]
        }
        y[p] = v
    }
    var d: Vec<f64> = Vec::filled(n, value: 0.0)
    var p = k
    while p > 0 {
        p -= 1
        var v = y[p] / c[p * k + p]
        for t in p + 1..k {
            v -= c[t * k + p] * d[live[t]]
        }
        d[live[p]] = v
    }
    d
}

/// Levenberg–Marquardt from `x0` over the literals `moves` lets change, `steps` steps at most:
/// where it stopped, and the steps it took. Each step solves the numbers' linear model at `x`
/// (A = JᵀJ, g = Jᵀr), damped by λ D; a step that doesn't lower the sum is tried again with
/// four times the damping, and one that does leaves a tenth of it. It stops when a step lowers
/// the sum by less than a millionth of it, or no damping finds a way down.
///
/// D is half Marquardt's damping (each literal's own entry of A's diagonal, so a literal's
/// units don't matter) and half Levenberg's (one value for all, here the diagonal's mean).
/// With Marquardt's alone, a literal the numbers barely change with (the angle of a bump that
/// has no height yet) moves as freely as one they depend on, and settles before the form it
/// belongs to has: on two fits of a limb's form to a sampled reference, of 72 and of 138
/// literals, that ended 3% farther from the reference (rms) than with this D, which ended
/// within 1% of where BFGS did.
///
/// K. Levenberg, "A method for the solution of certain non-linear problems in least squares",
/// Quarterly of Applied Mathematics 2 (1944); D. W. Marquardt, "An algorithm for least-squares
/// estimation of nonlinear parameters", SIAM Journal 11 (1963).
fn least_squares<const M: u32>(
    free: [Literal],
    f: fn() -> [f32; M],
    x0: [f32],
    began: [f32],
    moves: [bool],
    steps: u32,
    changes: mut Vec<bool>,
) -> (Vec<f32>, u32) {
    let n = x0.len()
    var x: Vec<f64> = Vec::from_fn(n, |i| f64(x0[i]))
    var fx = squares_at(free, f, narrowed(x))
    var lambda: f64 = 1.0e-3
    var taken = 0
    for _ in 0..steps {
        if !(fx - fx == 0.0) {
            break
        }
        let (r, j) = jacobian_at(free, f, narrowed(x), moves, mut changes)
        // A's upper triangle and g, a number at a time (most of a row is 0: a number changes
        // with few literals).
        var a: Vec<f64> = Vec::filled(n * n, value: 0.0)
        var g: Vec<f64> = Vec::filled(n, value: 0.0)
        for i in 0..M {
            let row = i * n
            for p in 0..n {
                let jp = j[row + p]
                if jp == 0.0 {
                    continue
                }
                g[p] += jp * r[i]
                for q in p..n {
                    a[p * n + q] += jp * j[row + q]
                }
            }
        }
        for p in 0..n {
            for q in 0..p {
                a[p * n + q] = a[q * n + p]
            }
        }
        // The literals the numbers change with at all.
        var most: f64 = 0.0
        for p in 0..n {
            most = max(most, a[p * n + p])
        }
        var live: Vec<u32> = Vec::new()
        for p in 0..n {
            if moves[p] && a[p * n + p] > 1.0e-18 * most {
                live.push(p)
            }
        }
        if live.len() == 0 {
            break
        }
        var x1: Vec<f64> = Vec::new()
        var f1: f64 = 0.0
        for _ in 0..40 {
            let d = damped_step(a, g, n, live, lambda)
            if d.len() == n {
                let step = within_reach(x, began, d, 1.0)
                let trial: Vec<f64> = Vec::from_fn(n, |i| x[i] + step[i])
                let ft = squares_at(free, f, narrowed(trial))
                if ft - ft == 0.0 && ft < fx {
                    x1 = take trial
                    f1 = ft
                    break
                }
            }
            lambda *= 4.0
        }
        if x1.len() == 0 {
            break
        }
        taken += 1
        let improved = fx - f1
        x = take x1
        fx = f1
        lambda = max(0.1 * lambda, 1.0e-12)
        if improved <= 1.0e-6 * max(fx, 1.0e-30) {
            break
        }
    }
    (narrowed(x), taken)
}

/// `v` rounded to `decimals` decimals of `unit`, halves away from 0 (`15cm`'s 0 decimals are
/// whole centimetres). An underflowed written unit keeps a finite `v`; an overflowed one
/// rounds it to zero.
pub fn round_to(v: f32, decimals: u32, unit: f64) -> f32 {
    if v == 0.0 { return 0.0 }
    var step = unit
    for _ in 0..decimals {
        step /= 10.0
    }
    if step == 0.0 { return v }
    let scaled = f64(v) / step
    if scaled == 0.0 { return 0.0 }
    // A step this small cannot change the f32 value; avoid overflowing an intermediate.
    if abs(scaled) >= 4503599627370496.0 { return v }
    let whole = if scaled < 0.0 { -floor(-scaled + 0.5) } else { floor(scaled + 0.5) }
    let r = f32(whole * step)
    if r == 0.0 { 0.0 } else { r }
}

@test
fn rounding_zero_keeps_zero_with_an_extreme_written_exponent() {
    // Both 0e-999 and 0e999 are finite zero literals, even though their units are not
    // representable as finite positive f64s.
    let infinity: u64 = 0x7ff0000000000000
    for unit in [0.0, bitcast_f64(infinity)] {
        assert(round_to(v: 0.0, decimals: 0, unit: unit) == 0.0)
    }
    assert(round_to(v: 0.156, decimals: 0, unit: 0.0) == 0.156)
    assert(round_to(v: 0.156, decimals: 0, unit: bitcast_f64(infinity)) == 0.0)
    assert(round_to(v: 1.0e30, decimals: 10, unit: 1.0e-300) == 1.0e30)
    assert(abs(round_to(v: 0.156, decimals: 0, unit: 0.01) - 0.16) < 1.0e-7)
}

@test
fn reports_are_json_for_strings_and_nonfinite_numbers() {
    var r = Report::new()
    let nan = bitcast_f32(0x7fc00000)
    let inf = bitcast_f32(0x7f800000)
    r.check("quote\" slash\\ line\n", "near", nan, inf, nan, 0.5)
    assert(
        r.done() ==
            "{\"checks\":[{\"name\":\"quote\\\" slash\\\\ line\\n\",\"check\":\"near\",\"value\":null,\"target\":null,\"miss\":null,\"within\":0.5,\"holds\":false}],\"held\":0,\"missed\":1}",
    )
}

@test
fn a_gradient_by_no_literals_gives_the_value_and_an_empty_gradient() {
    let none: [Literal; 0] = []
    let x = 1.5
    let (v, d) = gradient(|| x * x + 1.0, none)
    assert(v == 3.25)
    assert(d.len() == 0)
}

@test
fn a_jacobian_by_no_literals_gives_the_value_and_no_derivatives() {
    let none: [Literal; 0] = []
    let x = 1.5
    let (v, d) = jacobian(|| [x * x, x + 1.0], none)
    assert(v[0] == 2.25 && v[1] == 2.5)
    assert(d.len() == 0)
}

@test
fn a_damped_step_solves_its_equations() {
    // (A + λ diag A) d = −g with A = [[4, 1], [1, 3]], λ = 0 and g = [−1, −2]: d = [1/11, 7/11].
    let d = damped_step([4.0, 1.0, 1.0, 3.0], [-1.0, -2.0], 2, [0, 1], 0.0)
    assert(abs(d[0] - 1.0 / 11.0) < 1.0e-12 && abs(d[1] - 7.0 / 11.0) < 1.0e-12)
    // Over the second literal alone, the first is left where it is.
    let one = damped_step([4.0, 1.0, 1.0, 3.0], [-1.0, -2.0], 2, [1], 0.0)
    assert(one[0] == 0.0 && abs(one[1] - 2.0 / 3.0) < 1.0e-12)
    // A matrix that isn't positive definite has no step.
    assert(damped_step([1.0, 2.0, 2.0, 1.0], [-1.0, -2.0], 2, [0, 1], 0.0).len() == 0)
}

@test
fn a_step_moves_no_literal_farther_than_its_size() {
    // A step within every literal's size is taken whole.
    let small = within_reach([0.5, -32.0], [0.5, -32.0], [0.25, 20.0], 1.0)
    assert(small[0] == 0.25 && small[1] == 20.0 && whole(small, [0.25, 20.0], 1.0))
    // A key's time of 0.5 s and a step as long as its gradient: 0.5 s of it, at any `t` that
    // still leaves it longer.
    let long = within_reach([0.5], [0.5], [-164460.0], 1.0)
    assert(long[0] == -0.5 && !whole(long, [-164460.0], 1.0))
    assert(same(long, within_reach([0.5], [0.5], [-164460.0], 0.5)))
    assert(abs(within_reach([0.5], [0.5], [-164460.0], 0.000001)[0] + 0.16446) < 1.0e-12)
    // One literal's size holds the whole step to it, so the step keeps its direction: the other
    // goes the same fraction of its part.
    let one = within_reach([2.0, 100.0], [2.0, 100.0], [-8.0, 50.0], 1.0)
    assert(one[0] == -2.0 && one[1] == 12.5)
    // One that has come near 0 can still move as far as it began from it, and so cross it.
    assert(within_reach([0.125], [0.5], [-2.0], 1.0)[0] == -0.5)
    // One that began at 0 has no size to go by: 1.
    assert(within_reach([0.0], [0.0], [5.0], 1.0)[0] == 1.0)
    // A step that isn't a number is neither whole nor the same as itself: a search tries it,
    // finds no value there and halves.
    let quiet: u64 = 0x7ff8000000000000
    let nan = within_reach([1.0], [1.0], [bitcast_f64(quiet)], 1.0)
    assert(!whole(nan, [bitcast_f64(quiet)], 1.0) && !same(nan, nan))
}

@test
fn decimals_are_kept_only_for_what_they_buy() {
    // More decimals lower the value by a hair: its own are within 5% of the least.
    assert(fewest_decimals([0.3719011, 0.371805, 0.371805, 0.37180242]) == 0)
    // One more decimal buys most of it, and the rest a hair.
    assert(fewest_decimals([5.0, 1.1, 1.06, 1.06]) == 1)
    // The least itself, where nothing before it is near.
    assert(fewest_decimals([5.0, 3.0, 2.0, 1.0]) == 3)
    // A negative value's limit is above it.
    assert(fewest_decimals([-90.0, -99.0, -100.0]) == 1)
    // A value that isn't a number is no value: passed over, and all of them is no answer.
    let quiet: u64 = 0x7ff8000000000000
    let nan = bitcast_f64(quiet)
    assert(fewest_decimals([nan, 2.0, 1.99]) == 1)
    assert(fewest_decimals([nan, nan]) == 2)
}

@test
fn rounding_tolerance_is_sign_safe() {
    assert(abs(rounding_limit(100.0) - 105.0) < 0.000001)
    assert(abs(rounding_limit(-100.0) + 95.0) < 0.000001)
    assert(rounding_limit(0.0) > 0.0)
}

