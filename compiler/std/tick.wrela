// The ticker: a simulation step at a fixed rate, on a thread of its own (language.md §16.2).
// `start` moves a state, a step and a hash to the ticker's thread, where the host steps
// the state `hz` times a second. Each tick gets its number, its length and the input events
// the host stamped at its start (its records), and nothing else: no clock, and nothing that
// depends on timing. So given the first state and every tick's records, every tick's state is
// fixed, on any host. The host can ask for the state's hash after each step: to record
// a tick log, or to check one. The frames can put a value into the ticks (`post`): the host
// stamps it into the next tick's records, as an input event, so a tick log holds it too.
//
// The host runs each tick through the thread entry `tick` (wrela_abi's `__tick`), with the
// tick's records at `TICK_RECORDS`.

use std::abi::{EVENT_SIZE, MAX_TICK_RECORDS, TICK_HASH, TICK_ORIGIN, TICK_RECORDS, TICK_WANT_HASH}
use std::alloc::place
use std::hash::StateHash
use std::host::request
use std::input::{Event, RawEvent, event_of, posted_of}
use std::mem::{load_u32, read, run_task, store_u32, task}
use std::serialize::{Serialize, Writer}

/// One tick, as the step gets it.
pub struct Ticked: Clone {
    /// Its number, from 0.
    pub tick: u32,
    /// Its length, in seconds: 1 / hz.
    pub dt: f32,
    /// The input events the host stamped at its start, oldest first: at most 256 (the host
    /// keeps the rest for the next tick).
    pub records: Vec<Event>,
    /// The records the program posted (`post`) that the host stamped at its start, oldest
    /// first. They count toward the 256.
    pub posts: Vec<Posted>,
}

/// A record the program posted into its ticks (`post`): its tag, which says what it is, and
/// two values, whose meaning is the program's.
pub struct Posted: Copy + Eq + StateHash + Serialize {
    pub tag: u32,
    pub a: u64,
    pub b: u64,
}

/// Posts a record into the program's own ticks: the host stamps it into the records of the next
/// tick it runs, as it does an input event that arrives then, and that tick's step gets it in
/// `Ticked.posts`. A tick log keeps it among the tick's records, so a replay gives the ticks the
/// same records, and a host that replays a log drops what the program posts. So a sim learns
/// what only the frames know, such as a saved game read from storage after `init`, and its
/// ticks stay a function of their records. A post made before `start`, or in a program with no
/// ticker, fails the call's commands. In lockstep (test mode), what frame `i` posts is a record
/// of the first tick that runs for frame `i + 1`, before that frame's input.
///
/// ```wrela
/// use std::tick::{Ticked, post, start}
///
/// /// What the saved game says, posted under this tag: a bit for each level the player opened.
/// const OPENED: u32 = 1
///
/// /// A level map, on the ticker: the levels it lets the player into.
/// struct Map: Clone {
///     open: u64,
/// }
///
/// @deterministic
/// fn step(map: mut Map, t: Ticked) {
///     for p in t.posts {
///         if p.tag == OPENED {
///             map.open = p.a
///         }
///     }
/// }
///
/// @deterministic
/// fn hash(map: Map) -> u64 {
///     map.open
/// }
///
/// pub struct Game {
///     posted: bool,
/// }
///
/// pub fn init() -> Game {
///     start(Map { open: 1 }, hz: 60, step: step, hash: hash)
///     Game { posted: false }
/// }
///
/// pub fn frame(game: mut Game, time: f32, width: u32, height: u32) {
///     if !game.posted {
///         post(OPENED, a: 7, b: 0)   // levels 0, 1 and 2, as the saved game says
///         game.posted = true
///     }
/// }
/// ```
@client
pub fn post(tag: u32, a: u64, b: u64) {
    var w = Writer::new()
    w.write_u32(tag)
    w.write_u64(a)
    w.write_u64(b)
    // The host answers no post: its record is the ticks'.
    let _ = request("tick/post", take w.into_bytes())
}

/// The ticker's state, its step and its hash, and its rate: what its thread owns.
struct Ticker<S, F, H> {
    state: S,
    step: F,
    hash: H,
    hz: u32,
}

/// Starts the program's ticker: `state` moves to a thread of its own, where `step(mut state,
/// ticked)` runs `hz` times a second, tick after tick. `step` and `hash` are functions, or
/// closures that capture only values, since they move there too; both are `@deterministic`, so
/// a tick's state is a function of the first state and the ticks' records. `hash` gives the
/// state's hash, which the host asks for when it records the ticks (a tick log) or checks them.
/// A program has one ticker: a second `start` panics.
///
/// ```wrela
/// use std::tick::{Ticked, start}
///
/// /// A data logger: it samples a signal at 100 Hz and keeps a running mean, on its own thread,
/// /// while the program's thread draws and answers its user.
/// struct Logger: Clone {
///     samples: u32,
///     mean: f32,
/// }
///
/// @deterministic
/// fn sample(log: mut Logger, t: Ticked) {
///     let x = sin(f32(t.tick) * t.dt * 6.2831855)   // the signal at this tick's time
///     log.samples += 1
///     log.mean += (x - log.mean) / f32(log.samples)
/// }
///
/// @deterministic
/// fn checksum(log: Logger) -> u64 {
///     u64(log.samples) * 4294967296 + u64(bitcast_u32(log.mean))
/// }
///
/// pub fn init() -> u32 {
///     start(Logger { samples: 0, mean: 0.0 }, hz: 100, step: sample, hash: checksum)
///     0
/// }
///
/// pub fn frame(state: mut u32, time: f32, width: u32, height: u32) {}
/// ```
@client
pub fn start<S, F: @deterministic fn(mut S, Ticked), H: @deterministic fn(S) -> u64>(
    state: take S,
    hz: u32,
    step: F,
    hash: H,
) {
    assert(hz > 0, "a ticker ticks at least once a second")
    unsafe {
        // The first state's hash, for a tick log's header: before the state moves.
        if load_u32(TICK_WANT_HASH) != 0 {
            report(hash(state))
        }
        let at = place(Ticker { state, step, hash, hz })
        start_ticker(task(run_tick::<S, F, H>), at, hz)
    }
}

/// Makes task `task`, with the ticker at `ticker` as its context, the ticker thread's, `hz`
/// times a second (`wrela.tick`). A second panics.
@intrinsic
@effects(io)
pub(package) fn start_ticker(task: u32, ticker: u32, hz: u32) {}

/// Leaves a state's hash where the host reads it.
fn report(h: u64) {
    unsafe {
        store_u32(TICK_HASH, u32(h))
        store_u32(TICK_HASH + 4, u32(h >> 32))
    }
}

/// Tick `k`: the step, with the tick's records, then the state's hash if the host wants it.
fn run_tick<S, F: @deterministic fn(mut S, Ticked), H: @deterministic fn(S) -> u64>(
    k: u32,
    t: mut Ticker<S, F, H>,
) {
    let (records, posts) = records()
    let ticked = Ticked { tick: k, dt: 1.0 / f32(t.hz), records, posts }
    borrow step = t.step
    step(mut t.state, ticked)
    unsafe {
        if load_u32(TICK_WANT_HASH) != 0 {
            borrow hash = t.hash
            report(hash(t.state))
        }
    }
}

/// The records of the tick about to run, which the host wrote: its input, and what the program
/// posted (`post`).
fn records() -> (Vec<Event>, Vec<Posted>) {
    unsafe {
        let n = min(load_u32(TICK_RECORDS), MAX_TICK_RECORDS)
        var events: Vec<Event> = Vec::with_capacity(n)
        var posts: Vec<Posted> = Vec::new()
        for i in 0..n {
            let r = read::<RawEvent>(TICK_RECORDS + 4 + EVENT_SIZE * i)
            if let Some((tag, a, b)) = posted_of(r) {
                posts.push(Posted { tag, a, b })
            } else if let Some(e) = event_of(r) {
                events.push(e)
            }
        }
        (events, posts)
    }
}

/// The ticker thread's entry (wrela_abi's `__tick`): tick `k` of the ticker at `ticker`, whose
/// task is `task`.
@thread_entry
pub(package) fn tick(thread: u32, task: u32, ticker: u32, k: u32) {
    unsafe {
        std::alloc::reach_heap()
        run_task(task, ticker, k)
    }
}

/// The sim clock's origin: the frame time, in seconds, at which tick 0 was due, so tick `k` is
/// due at `origin() + k / hz`. A frame uses it to place the newest tick in time. The host moves
/// it forward when it drops ticks it couldn't run in time, or the page was hidden. It's
/// `nondet` (§8): it depends on timing.
@effects(nondet)
pub fn origin() -> f64 {
    unsafe { read::<f64>(TICK_ORIGIN) }
}
