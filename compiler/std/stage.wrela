// Fields built while the program runs, as a tape of operations that `interpret` evaluates
// (language.md §14.4). A field the program assembles while it runs, from an edit log or a
// sculpting tool, has no code of its own to compile; its tape is data. And a compiled field
// becomes one (`std::derive::tape`), so one kernel that interprets tapes serves every field. A
// tape is a `Surface` like any compiled field, on the CPU and the GPU, and its gradient and
// interval are derived from `interpret`'s own code, as any function's are (§14).
//
// Each operation writes its own register, the one at its index, from earlier registers, a
// constant, or the tape's table of constants (`consts`); the last register is the field's
// value. A tape is fixed-size, so it's `GpuData` and passes to a kernel as a uniform, or as a
// read-only storage binding past 64 KiB: a `Tape` holds `TAPE_LEN` operations, a `ShortTape`
// `TAPE_SHORT`, both a `Taped` of their sizes.

use std::derive::{Box2, Box3, Interval, interval}
use std::math::is_finite
use std::field::{Surface, lattice, lattice_coord, smin, value_noise, value_noise_box}
use std::hash::pcg

/// The most operations a `Tape` holds, and the most constants in its table.
pub const TAPE_LEN: u32 = 4096
/// The most constants in a `Tape`'s table.
pub const TAPE_CONSTS: u32 = 2048
/// A `ShortTape`'s: a pruned tape's, which a block's work reads from a uniform.
pub const TAPE_SHORT: u32 = 256
/// The most constants in a `ShortTape`'s table.
pub const TAPE_SHORT_CONSTS: u32 = 256

// The operations. Each reads registers `a` and `b` and, for the ternary ones, a third register
// held in the code's high 16 bits; or a constant `c`; or the table.
/// The point's x, less `c`.
pub const X: u32 = 0
/// The point's y, less `c`.
pub const Y: u32 = 1
/// The point's z, less `c`.
pub const Z: u32 = 2
/// The constant `c`.
pub const CONST: u32 = 3
/// `a + b`.
pub const ADD: u32 = 4
/// `a - b`.
pub const SUB: u32 = 5
/// `a * b`.
pub const MUL: u32 = 6
/// `a / b`.
pub const DIV: u32 = 7
/// `min(a, b)`.
pub const MIN: u32 = 8
/// `max(a, b)`.
pub const MAX: u32 = 9
/// `smin(a, b, c)`: a smooth minimum `c` wide.
pub const SMIN: u32 = 10
/// `-a`.
pub const NEG: u32 = 11
/// `abs(a)`.
pub const ABS: u32 = 12
/// `sqrt(a)`.
pub const SQRT: u32 = 13
/// `sin(a)`.
pub const SIN: u32 = 14
/// `cos(a)`.
pub const COS: u32 = 15
/// `exp(a)`.
pub const EXP: u32 = 16
/// `a`, copied.
pub const COPY: u32 = 17
/// `floor(a)`.
pub const FLOOR: u32 = 18
/// `fract(a)`.
pub const FRACT: u32 = 19
/// `a < b ? 1 : 0`.
pub const STEP: u32 = 20
/// `a > 0 ? b : t`, `t` the third register.
pub const SELECT: u32 = 21
/// `a + (b - a) * t`.
pub const MIX: u32 = 22
/// `saturate(a)`.
pub const CLAMP01: u32 = 23
/// `pow(a, c)`.
pub const POW: u32 = 24
/// `log(a)`.
pub const LOG: u32 = 25
/// `a - b * floor(a / b)`.
pub const MOD: u32 = 26
/// `consts[c + clamp(floor(a), 0, n - 1)]`, `n` the table's entries from `c` (held where a
/// ternary operation's third register is): a constant table read at a computed index.
pub const LOAD: u32 = 27
/// Between `consts[c + i]` and `consts[c + i + 1]`, linearly, at `a` clamped to `[0, n - 1]`
/// (`i` its floor), `n` as `LOAD`'s.
pub const LERP_LOAD: u32 = 28
/// `value_noise(vec3(a, b, t) * c)`: std::field's own noise, so a tape and a compiled field
/// agree bit for bit.
pub const NOISE3: u32 = 29
/// `fbm(consts[c], octaves: consts[c + 1]).value(vec3(a, b, t))`, each octave's amplitude
/// `consts[c + 2]` of the last's (std::field's `Fbm` takes 0.5).
pub const FBM3: u32 = 30
/// `lattice(lattice_coord(floor(a)), lattice_coord(floor(b)), lattice_coord(floor(t)))`: the
/// lattice's hash of a cell, in [-1, 1].
pub const HASH: u32 = 31
/// `dot(r[a..a+3], r[b..b+3])`: two vectors, each three registers in a row.
pub const DOT3: u32 = 32
/// `length(r[a..a+3])`.
pub const LEN3: u32 = 33
/// Component `c` (0, 1 or 2) of `normalize(r[a..a+3])`.
pub const NORM3: u32 = 34
/// `atan2(a, b)`.
pub const ATAN2: u32 = 35
// Integers: a 32-bit integer is two registers in a row, its high and its low 16 bits (each a
// whole number from 0 to 65535, exact as an `f32`), and an integer operation reads two such
// pairs, `a..a+2` and `b..b+2`. Those that give an integer write one half each (`c` 0, the high;
// 1, the low), so each is two operations in a row: wrapping `+ - *`, `& | ^`, `<< >>` (by the
// amount mod 32; `ISHR` keeps an `i32`'s sign), `/ %` (0 where they'd trap: a tape runs both
// sides of a branch on the point), `min` and `max` (`IMIN`, `IMAX` of `i32`s). `ULT` and `ILT`
// (`<` of `u32`s and `i32`s) and `IEQ` give 1 or 0; `I2F` and `U2F` an integer's value as an
// `f32`; `F2I` and `F2U` the half `c` of a float register `a` toward zero (`F2I` wrapped to the
// low 32 bits past `i32`'s range, as `std::field::lattice_coord` wraps; `F2U` 0 out of range).
// How a field hashes the lattice cells its point is in, exactly, on both targets.
/// `a + b`, wrapping.
pub const IADD: u32 = 36
/// `a - b`, wrapping.
pub const ISUB: u32 = 37
/// `a * b`, wrapping.
pub const IMUL: u32 = 38
/// `a & b`.
pub const AND: u32 = 39
/// `a | b`.
pub const OR: u32 = 40
/// `a ^ b`.
pub const XOR: u32 = 41
/// `a << b`, by `b` mod 32.
pub const SHL: u32 = 42
/// `a >> b` of a `u32`, by `b` mod 32.
pub const USHR: u32 = 43
/// `a >> b` of an `i32`, its sign kept, by `b` mod 32.
pub const ISHR: u32 = 44
/// `a / b` of `u32`s; 0 for a `b` of 0.
pub const UDIV: u32 = 45
/// `a / b` of `i32`s; 0 for a `b` of 0, and `-a` (wrapping) for one of -1.
pub const IDIV: u32 = 46
/// `a % b` of `u32`s; 0 for a `b` of 0.
pub const UREM: u32 = 47
/// `a % b` of `i32`s; 0 for a `b` of 0 or -1.
pub const IREM: u32 = 48
/// `min(a, b)` of `i32`s.
pub const IMIN: u32 = 49
/// `max(a, b)` of `i32`s.
pub const IMAX: u32 = 50
/// `min(a, b)` of `u32`s.
pub const UMIN: u32 = 51
/// `max(a, b)` of `u32`s.
pub const UMAX: u32 = 52
/// `a < b` of `u32`s: 1 or 0.
pub const ULT: u32 = 53
/// `a < b` of `i32`s: 1 or 0.
pub const ILT: u32 = 54
/// `a == b`: 1 or 0.
pub const IEQ: u32 = 55
/// An `i32`'s value as an `f32`.
pub const I2F: u32 = 56
/// A `u32`'s value as an `f32`.
pub const U2F: u32 = 57
/// Float register `a` as an `i32`, toward zero (0 out of range): half `c` of it.
pub const F2I: u32 = 58
/// Float register `a` as a `u32`, toward zero (0 out of range): half `c` of it.
pub const F2U: u32 = 59
/// `std::hash::pcg(a)`, of an integer: a lattice hash's last steps.
pub const PCG: u32 = 60
/// `a * b + t` of integers (wrapping; `t` the third register's pair): a hash's mixing.
pub const IMAD: u32 = 61
/// `value_noise_box(r[a..a+3], r[b..b+3])`: value noise averaged over the box round a point
/// (`std::field::value_noise_box`), a filtered field's noise seen a width wide.
pub const BOXNOISE3: u32 = 62

/// How many registers an operation reads (`a`, `b`, then the third), the vector operations
/// aside (`reads`).
fn arity(code: u32) -> u32 {
    if code < ADD {
        0
    } else if code <= SMIN ||
        code == STEP ||
        code == MOD ||
        code == ATAN2 ||
        (code >= IADD && code < I2F) {
        2
    } else if code == SELECT ||
        code == MIX ||
        code == NOISE3 ||
        code == FBM3 ||
        code == HASH ||
        code == IMAD {
        3
    } else if code == LOAD || code == LERP_LOAD || code == NORM3 || code == LEN3 {
        1
    } else if two_vectors(code) {
        2
    } else {
        1
    }
}

/// Whether an operation reads two vectors, `a..a+3` and `b..b+3`.
fn two_vectors(code: u32) -> bool {
    code == DOT3 || code == BOXNOISE3
}

/// Whether an operation reads its operands as integers: register pairs, `a..a+2` (and `b..b+2`,
/// and the third's).
fn pair_op(code: u32) -> bool {
    (code >= IADD && code < F2I) || code == PCG || code == IMAD
}

/// Whether an operation is an integer one (`IADD` to `IMAD`): its registers are integers' halves
/// or comparisons, and a box noise past them is a float's.
fn integer_op(code: u32) -> bool {
    code >= IADD && code <= IMAD
}

/// Whether an operation writes half an integer (`c` says which).
fn half_op(code: u32) -> bool {
    (code >= IADD && code < ULT) || (code >= F2I && code <= IMAD)
}

/// Whether an operation reads its registers three in a row: `a..a+3` (and `b..b+3`).
fn vector_op(code: u32) -> bool {
    code == DOT3 || code == LEN3 || code == NORM3 || code == BOXNOISE3
}

/// One operation: its register gets `code` (the opcode in the low 16 bits; a ternary
/// operation's third register, or a table read's entry count, in the high 16) of registers `a`
/// and `b`, or of the constant `c` (a coordinate's offset, a constant's value, a smooth
/// minimum's width, a table's first entry).
pub struct Op: Copy + GpuData {
    code: u32,
    a: u32,
    b: u32,
    c: f32,
}

impl Op {
    /// Its opcode.
    pub fn opcode(self) -> u32 {
        self.code & 65535
    }

    /// Its third register, or a table read's entry count.
    pub fn third(self) -> u32 {
        self.code >> 16
    }

    /// Its registers `a` and `b`, and its constant `c`.
    pub fn operands(self) -> (u32, u32, f32) {
        (self.a, self.b, self.c)
    }
}

/// A value on a tape: the register an operation writes.
pub struct Reg: Copy {
    index: u32,
}

/// A field built at runtime: up to `N` operations over the point, and a table of up to `K`
/// constants. Build one with its methods, each of which adds an operation and returns its
/// register; the last one added is the field's value. `Tape` and `ShortTape` are its sizes.
pub struct Taped<const N: u32, const K: u32>: Copy + GpuData {
    ops: [Op; N],
    len: u32,
    consts: [f32; K],
    nconsts: u32,
    /// How many of its last registers are what it gives: 1, its value; or for a tape of
    /// `tape_with`, its value and the floats beside it, which `prune` keeps too.
    keep: u32,
}

/// A tape of up to `TAPE_LEN` operations and `TAPE_CONSTS` constants: 72 KiB, which a kernel
/// binds as read-only storage.
pub type Tape = Taped<4096, 2048>

/// A tape of up to `TAPE_SHORT` operations and constants (5 KiB): a pruned tape, which a kernel
/// reads from a uniform-sized block.
pub type ShortTape = Taped<256, 256>

/// The value of `tape`'s field at `p`: its last register. (Its loop is `run`'s, written out, as
/// measured fastest.)
pub fn interpret<const N: u32, const K: u32>(tape: Taped<N, K>, p: vec3) -> f32 {
    var r = [0.0; N]
    for i in 0..tape.len {
        let op = tape.ops[i]
        let code = op.opcode()
        // The integers first: one comparison for every float operation.
        r[i] = if code >= IADD && pair_op(code) {
            let t = if code == IMAD { whole(r[op.third()], r[op.third() + 1]) } else { 0 }
            integer(op, whole(r[op.a], r[op.a + 1]), whole(r[op.b], r[op.b + 1]), t)
        } else if vector_op(code) {
            let u = vec3(r[op.a], r[op.a + 1], r[op.a + 2])
            if code == DOT3 {
                dot(u, vec3(r[op.b], r[op.b + 1], r[op.b + 2]))
            } else if code == BOXNOISE3 {
                value_noise_box(u, vec3(r[op.b], r[op.b + 1], r[op.b + 2]))
            } else if code == LEN3 {
                length(u)
            } else {
                vector_component(normalize(u), op.c)
            }
        } else if code == LOAD || code == LERP_LOAD {
            table(tape, op, r[op.a])
        } else if code == FBM3 {
            fbm3(tape, op, vec3(r[op.a], r[op.b], r[op.third()]))
        } else {
            apply(op, p, r[op.a], r[op.b], r[op.third()])
        }
    }
    if tape.len == 0 { 0.0 } else { r[tape.len - 1] }
}

/// `interpret` without a box noise's loops (`register_interval`'s, which derives an interval
/// through it only for a tape that has none).
fn interpret_unboxed<const N: u32, const K: u32>(tape: Taped<N, K>, p: vec3) -> f32 {
    var r = [0.0; N]
    for i in 0..tape.len {
        let op = tape.ops[i]
        let code = op.opcode()
        // The integers first: one comparison for every float operation.
        r[i] = if code >= IADD && pair_op(code) {
            let t = if code == IMAD { whole(r[op.third()], r[op.third() + 1]) } else { 0 }
            integer(op, whole(r[op.a], r[op.a + 1]), whole(r[op.b], r[op.b + 1]), t)
        } else if vector_op(code) {
            let u = vec3(r[op.a], r[op.a + 1], r[op.a + 2])
            if code == DOT3 {
                dot(u, vec3(r[op.b], r[op.b + 1], r[op.b + 2]))
            } else if code == BOXNOISE3 {
                // Never reached: `register_interval` doesn't derive through a box noise.
                0.0
            } else if code == LEN3 {
                length(u)
            } else {
                vector_component(normalize(u), op.c)
            }
        } else if code == LOAD || code == LERP_LOAD {
            table(tape, op, r[op.a])
        } else if code == FBM3 {
            fbm3(tape, op, vec3(r[op.a], r[op.b], r[op.third()]))
        } else {
            apply(op, p, r[op.a], r[op.b], r[op.third()])
        }
    }
    if tape.len == 0 { 0.0 } else { r[tape.len - 1] }
}

/// Each of `tape`'s registers at `p`, into `r` (written in place: returned, they'd be copied).
fn run<const N: u32, const K: u32>(tape: Taped<N, K>, p: vec3, r: mut [f32; N]) {
    for i in 0..tape.len {
        let op = tape.ops[i]
        let code = op.opcode()
        // The integers first: one comparison for every float operation.
        r[i] = if code >= IADD && pair_op(code) {
            let t = if code == IMAD { whole(r[op.third()], r[op.third() + 1]) } else { 0 }
            integer(op, whole(r[op.a], r[op.a + 1]), whole(r[op.b], r[op.b + 1]), t)
        } else if vector_op(code) {
            let u = vec3(r[op.a], r[op.a + 1], r[op.a + 2])
            if code == DOT3 {
                dot(u, vec3(r[op.b], r[op.b + 1], r[op.b + 2]))
            } else if code == BOXNOISE3 {
                value_noise_box(u, vec3(r[op.b], r[op.b + 1], r[op.b + 2]))
            } else if code == LEN3 {
                length(u)
            } else {
                vector_component(normalize(u), op.c)
            }
        } else if code == LOAD || code == LERP_LOAD {
            table(tape, op, r[op.a])
        } else if code == FBM3 {
            fbm3(tape, op, vec3(r[op.a], r[op.b], r[op.third()]))
        } else {
            apply(op, p, r[op.a], r[op.b], r[op.third()])
        }
    }
}

// ---- building a tape from a compiled field (`std::derive::tape`) -------------------------------

/// How many slots `Building` finds its operations in: twice a `Tape`'s room.
const SEEN: u32 = 8192

/// A tape that `std::derive::tape` is building: the tape, where each of its operations is by its
/// hash (its register plus one, or 0 for none), so an operation the tape has already is found
/// rather than added again, and how many operations were asked for past its room. Each
/// operation is a function of its registers, so two of the same give the same value.
pub struct Building<const N: u32, const K: u32>: Copy {
    tape: Taped<N, K>,
    seen: [u32; SEEN],
    past: u32,
}

/// `op`'s hash.
fn op_hash(op: Op) -> u32 {
    mix(mix(mix(op.code ^ 0x9e3779b9) ^ op.a) ^ op.b) ^ mix(bitcast_u32(op.c))
}

/// Whether two operations are the same: their constants' bits too.
fn same_op(x: Op, y: Op) -> bool {
    x.code == y.code && x.a == y.a && x.b == y.b && bitcast_u32(x.c) == bitcast_u32(y.c)
}

impl<const N: u32, const K: u32> Building<N, K> {
    /// The register of `op` on the tape (with `next`, of `op` and `next` in a row), or where
    /// `seen` has room for it: its slot. A pair is found by both its operations' hashes: many
    /// pairs begin alike (a small integer's high half is 0).
    fn find(self, op: Op, next: Option<Op>) -> (Option<u32>, u32) {
        let h = match next {
            Some(n) => op_hash(op) ^ mix(op_hash(n) + 1),
            None => op_hash(op),
        }
        var s = h & (SEEN - 1)
        for _ in 0..SEEN {
            let r = self.seen[s]
            if r == 0 {
                return (None, s)
            }
            let at = r - 1
            let follows = match next {
                Some(n) => at + 1 < self.tape.len && same_op(self.tape.ops[at + 1], n),
                None => true,
            }
            if same_op(self.tape.ops[at], op) && follows {
                return (Some(at), s)
            }
            s = (s + 1) & (SEEN - 1)
        }
        (None, SEEN)
    }

    /// Adds `op` (past the tape's room, counts it): its register.
    fn add(mut self, op: Op) -> u32 {
        if self.tape.len >= N {
            self.past += 1
            return N + self.past - 1
        }
        self.tape.ops[self.tape.len] = op
        self.tape.len += 1
        self.tape.len - 1
    }

    /// Notes that `op` is at register `r`, in slot `s` if it's free.
    fn note(mut self, s: u32, r: u32) {
        if s < SEEN && r < N && self.seen[s] == 0 {
            self.seen[s] = r + 1
        }
    }
}

/// The register of the operation `code` (the third register in its high 16 bits) of `a` and
/// `b`, or of `c`: one the tape has, or a new one.
pub fn push_one<const N: u32, const K: u32>(
    t: mut Building<N, K>,
    code: u32,
    a: u32,
    b: u32,
    c: f32,
) -> f32 {
    let op = Op { code, a, b, c }
    let (found, s) = t.find(op, None)
    if let Some(r) = found {
        return f32(r)
    }
    let r = t.add(op)
    t.note(s, r)
    f32(r)
}

/// The first register of two operations in a row (an integer's halves): two the tape has in
/// a row, or two new ones.
pub fn push_two<const N: u32, const K: u32>(
    t: mut Building<N, K>,
    code: u32,
    a: u32,
    b: u32,
    c: f32,
    code2: u32,
    a2: u32,
    b2: u32,
    c2: f32,
) -> f32 {
    let (first, second) = (Op { code, a, b, c }, Op { code: code2, a: a2, b: b2, c: c2 })
    let (found, s) = t.find(first, Some(second))
    if let Some(r) = found {
        return f32(r)
    }
    let r = t.add(first)
    let _ = t.add(second)
    t.note(s, r)
    f32(r)
}

/// A new register for an operation that must be where it's put (one of three in a row that a
/// vector operation reads, or one of the value's at the tape's end): never one the tape has.
pub fn push_new<const N: u32, const K: u32>(
    t: mut Building<N, K>,
    code: u32,
    a: u32,
    b: u32,
    c: f32,
) -> f32 {
    f32(t.add(Op { code, a, b, c }))
}

/// The tape built, the operations its value and its last `keep` registers don't use dropped:
/// a panic, with its counts, if it's past its room.
pub fn finish<const N: u32, const K: u32>(t: Building<N, K>, keep: u32) -> Taped<N, K> {
    if t.past > 0 || t.tape.nconsts > K {
        let ops = t.tape.len + t.past
        panic(
            f"a tape of {ops} operations and {t.tape.nconsts} constants, past its room for {N} and {K}: tape a smaller part of the field, or prune it to a box",
        )
    }
    t.tape.drop_unused(t.tape.ops, keep)
}

/// The value of a tape of `tape_with` at `p`, and the `M` floats beside it: its last `1 + M`
/// registers.
pub fn interpret_with<const N: u32, const K: u32, const M: u32>(
    tape: Taped<N, K>,
    p: vec3,
) -> (f32, [f32; M]) {
    var r = [0.0; N]
    run(tape, p, mut r)
    var rest = [0.0; M]
    if tape.len < M + 1 {
        return (0.0, rest)
    }
    let base = tape.len - M
    for k in 0..M {
        rest[k] = r[base + k]
    }
    (r[base - 1], rest)
}

/// `a` toward zero as an `i32`'s bits, wrapped to its low 32 bits past `i32`'s range, 0 for an
/// infinity or NaN: `std::field::lattice_coord`'s, which `F2I` stands for in a tape.
fn wrapped(a: f32) -> u32 {
    if abs(a) < 2147483648.0 {
        return u32(i32(a))
    }
    // Exact: at |a| >= 2^31 an f32 is a multiple of 2^8, and so is this, below 2^32.
    let low = a - 4294967296.0 * floor(a / 4294967296.0)
    if low == low { u32(low) } else { 0 }
}

/// Component `c` (0, 1 or 2) of `v`.
fn vector_component(v: vec3, c: f32) -> f32 {
    if c < 0.5 { v.x } else if c < 1.5 { v.y } else { v.z }
}

/// A table read (`LOAD`, `LERP_LOAD`) at `at`.
fn table<const N: u32, const K: u32>(tape: Taped<N, K>, op: Op, at: f32) -> f32 {
    let base = u32(op.c)
    let last = f32(max(op.third(), 1) - 1)
    let t = clamp(at, 0.0, last)
    let i = floor(t)
    let lo = tape.consts[base + u32(i)]
    if op.opcode() == LOAD {
        return lo
    }
    let next = min(i + 1.0, last)
    let hi = tape.consts[base + u32(next)]
    lo + (hi - lo) * (t - i)
}

/// `FBM3` at `q`: std::field's `Fbm::value`, octave by octave, as it sums them.
fn fbm3<const N: u32, const K: u32>(tape: Taped<N, K>, op: Op, q: vec3) -> f32 {
    let base = u32(op.c)
    var s = 0.0
    var a = 1.0
    var fr = tape.consts[base]
    let octaves = u32(tape.consts[base + 1])
    let gain = tape.consts[base + 2]
    for o in 0..octaves {
        s += a * value_noise(q * fr + f32(o) * 17.0)
        a *= gain
        fr *= 2.0
    }
    s
}

/// What a scalar operation `op` writes at `p`, given the values `a`, `b` and `t` of its
/// registers: one step of `interpret`, and `Taped::prune`'s step of the registers' intervals.
fn apply(op: Op, p: vec3, a: f32, b: f32, t: f32) -> f32 {
    match op.opcode() {
        X => p.x - op.c,
        Y => p.y - op.c,
        Z => p.z - op.c,
        CONST => op.c,
        ADD => a + b,
        SUB => a - b,
        MUL => a * b,
        DIV => a / b,
        MIN => min(a, b),
        MAX => max(a, b),
        SMIN => smin(a, b, op.c),
        NEG => -a,
        ABS => abs(a),
        SQRT => sqrt(a),
        SIN => sin(a),
        COS => cos(a),
        EXP => exp(a),
        FLOOR => floor(a),
        FRACT => fract(a),
        STEP => if a < b { 1.0 } else { 0.0 },
        SELECT => if a > 0.0 { b } else { t },
        MIX => a + (b - a) * t,
        CLAMP01 => saturate(a),
        POW => pow(a, op.c),
        LOG => log(a),
        MOD => a - b * floor(a / b),
        NOISE3 => value_noise(vec3(a, b, t) * op.c),
        HASH => lattice(lattice_coord(floor(a)), lattice_coord(floor(b)), lattice_coord(floor(t))),
        ATAN2 => atan2(a, b),
        F2I => half(op, wrapped(a)),
        F2U => half(op, if a > -1.0 && a < 4294967296.0 { u32(a) } else { 0 }),
        _ => a,
    }
}

/// The integer a register pair holds, from its high and low halves.
fn whole(hi: f32, lo: f32) -> u32 {
    let h = if hi >= 0.0 && hi < 65536.0 { u32(hi) } else { 0 }
    let l = if lo >= 0.0 && lo < 65536.0 { u32(lo) } else { 0 }
    (h << 16) | l
}

/// The half of `x` that `op` writes: the high 16 bits for `c` 0, the low for 1.
fn half(op: Op, x: u32) -> f32 {
    if op.c < 0.5 { f32(x >> 16) } else { f32(x & 65535) }
}

/// Integer operation `op` (`IADD` to `U2F`, `PCG`, `IMAD`) of the integers `x`, `y` and (for
/// `IMAD`) `z`: the half it writes, or its value as an `f32`.
fn integer(op: Op, x: u32, y: u32, z: u32) -> f32 {
    let (i, j) = (i32(x), i32(y))
    let one = |c: bool| if c { 1.0 } else { 0.0 }
    let s = y & 31
    match op.opcode() {
        ULT => one(x < y),
        ILT => one(i < j),
        IEQ => one(x == y),
        I2F => f32(i),
        U2F => f32(x),
        code => half(op, match code {
            IADD => x.wrapping_add(y),
            ISUB => x.wrapping_sub(y),
            IMUL => x.wrapping_mul(y),
            AND => x & y,
            OR => x | y,
            XOR => x ^ y,
            SHL => x << s,
            USHR => x >> s,
            ISHR => u32(i >> s),
            UDIV => if y == 0 { 0 } else { x / y },
            // `i32::MIN / -1` overflows: it wraps, as negating it does.
            IDIV => if j == 0 { 0 } else if j == -1 { 0.wrapping_sub(x) } else { u32(i / j) },
            UREM => if y == 0 { 0 } else { x % y },
            IREM => if j == 0 || j == -1 { 0 } else { u32(i % j) },
            IMIN => u32(min(i, j)),
            IMAX => u32(max(i, j)),
            UMIN => min(x, y),
            PCG => pcg(x),
            IMAD => x.wrapping_mul(y).wrapping_add(z),
            _ => max(x, y),
        }),
    }
}

impl<const N: u32, const K: u32> Surface for Taped<N, K> {
    fn distance(self, p: vec3) -> f32 {
        interpret(self, p)
    }

    /// The tape's own interval (`Taped::interval`), not one derived through `interpret`: a box
    /// noise's loops run as often as its box is wide, which no derivation follows.
    fn interval(self, over: Box3) -> Interval {
        if self.len == 0 {
            return Interval { lo: 0.0, hi: 0.0 }
        }
        self.register_intervals(over)[self.len - 1]
    }

    /// Itself, as a `Tape`.
    fn to_tape(self) -> Tape {
        match self.resized() {
            Some(t) => t,
            None => panic("a tape past a `Tape`'s capacity"),
        }
    }
}

impl<const N: u32, const K: u32> Taped<N, K> {
    /// An empty tape, whose value is 0 until an operation is added.
    pub fn new() -> Taped<N, K> {
        Taped {
            ops: [Op { code: CONST, a: 0, b: 0, c: 0.0 }; N],
            len: 0,
            consts: [0.0; K],
            nconsts: 0,
            keep: 1,
        }
    }

    /// How many operations it holds.
    pub fn len(self) -> u32 {
        self.len
    }

    /// How many constants its table holds.
    pub fn consts_len(self) -> u32 {
        self.nconsts
    }

    /// Its `i`th operation.
    pub fn op_at(self, i: u32) -> Op {
        self.ops[i]
    }

    /// The same operations and table in a tape of another size, if they fit (a pruned tape into
    /// a `ShortTape`).
    pub fn resized<const M: u32, const L: u32>(self) -> Option<Taped<M, L>> {
        if self.len > M || self.nconsts > L {
            return None
        }
        var out = Taped::new()
        for i in 0..self.len {
            out.ops[i] = self.ops[i]
        }
        for i in 0..self.nconsts {
            out.consts[i] = self.consts[i]
        }
        out.len = self.len
        out.nconsts = self.nconsts
        out.keep = self.keep
        Some(out)
    }

    /// Adds `values` to the table: where they start.
    pub fn table(mut self, values: [f32]) -> u32 {
        if self.nconsts + values.len() > K {
            panic("a tape's table is full")
        }
        let at = self.nconsts
        for v in values {
            self.consts[self.nconsts] = v
            self.nconsts += 1
        }
        at
    }

    fn op(mut self, code: u32, a: Reg, b: Reg, c: f32) -> Reg {
        self.op3(code, a, b, Reg { index: 0 }, c)
    }

    fn op3(mut self, code: u32, a: Reg, b: Reg, t: Reg, c: f32) -> Reg {
        if self.len == N {
            panic("a tape is full")
        }
        let n = arity(code)
        let wide = if vector_op(code) { 2 } else if pair_op(code) { 1 } else { 0 }
        let from_another = |r: Reg| r.index + wide >= self.len
        let bad_t = n == 3 && t.index + (if code == IMAD { 1 } else { 0 }) >= self.len
        if (n >= 1 && from_another(a)) || (n >= 2 && from_another(b)) || bad_t {
            panic("a register from another tape, or from after this operation")
        }
        self.ops[self.len] = Op { code: code | (t.index << 16), a: a.index, b: b.index, c }
        self.len += 1
        Reg { index: self.len - 1 }
    }

    /// The point's x coordinate.
    pub fn x(mut self) -> Reg {
        self.op(X, Reg { index: 0 }, Reg { index: 0 }, 0.0)
    }

    /// The point's y coordinate.
    pub fn y(mut self) -> Reg {
        self.op(Y, Reg { index: 0 }, Reg { index: 0 }, 0.0)
    }

    /// The point's z coordinate.
    pub fn z(mut self) -> Reg {
        self.op(Z, Reg { index: 0 }, Reg { index: 0 }, 0.0)
    }

    /// The value `c`.
    pub fn constant(mut self, c: f32) -> Reg {
        self.op(CONST, Reg { index: 0 }, Reg { index: 0 }, c)
    }

    /// `a + b`.
    pub fn add(mut self, a: Reg, b: Reg) -> Reg {
        self.op(ADD, a, b, 0.0)
    }

    /// `a - b`.
    pub fn sub(mut self, a: Reg, b: Reg) -> Reg {
        self.op(SUB, a, b, 0.0)
    }

    /// `a * b`.
    pub fn mul(mut self, a: Reg, b: Reg) -> Reg {
        self.op(MUL, a, b, 0.0)
    }

    /// `a / b`.
    pub fn div(mut self, a: Reg, b: Reg) -> Reg {
        self.op(DIV, a, b, 0.0)
    }

    /// `min(a, b)`.
    pub fn min(mut self, a: Reg, b: Reg) -> Reg {
        self.op(MIN, a, b, 0.0)
    }

    /// `max(a, b)`.
    pub fn max(mut self, a: Reg, b: Reg) -> Reg {
        self.op(MAX, a, b, 0.0)
    }

    /// std::field's `smin(a, b, k)`: a minimum whose seam is rounded over a width of about `k`.
    pub fn smooth_min(mut self, a: Reg, b: Reg, k: f32) -> Reg {
        self.op(SMIN, a, b, k)
    }

    /// `-a`.
    pub fn neg(mut self, a: Reg) -> Reg {
        self.op(NEG, a, a, 0.0)
    }

    /// `abs(a)`.
    pub fn abs(mut self, a: Reg) -> Reg {
        self.op(ABS, a, a, 0.0)
    }

    /// `sqrt(a)`.
    pub fn sqrt(mut self, a: Reg) -> Reg {
        self.op(SQRT, a, a, 0.0)
    }

    /// `sin(a)`.
    pub fn sin(mut self, a: Reg) -> Reg {
        self.op(SIN, a, a, 0.0)
    }

    /// `cos(a)`.
    pub fn cos(mut self, a: Reg) -> Reg {
        self.op(COS, a, a, 0.0)
    }

    /// `exp(a)`.
    pub fn exp(mut self, a: Reg) -> Reg {
        self.op(EXP, a, a, 0.0)
    }

    /// `floor(a)`.
    pub fn floor(mut self, a: Reg) -> Reg {
        self.op(FLOOR, a, a, 0.0)
    }

    /// `fract(a)`.
    pub fn fract(mut self, a: Reg) -> Reg {
        self.op(FRACT, a, a, 0.0)
    }

    /// `1` where `a < b`, else `0`.
    pub fn step(mut self, a: Reg, b: Reg) -> Reg {
        self.op(STEP, a, b, 0.0)
    }

    /// `b` where `a > 0`, else `t`.
    pub fn select(mut self, a: Reg, b: Reg, t: Reg) -> Reg {
        self.op3(SELECT, a, b, t, 0.0)
    }

    /// `a + (b - a) * t`.
    pub fn mix(mut self, a: Reg, b: Reg, t: Reg) -> Reg {
        self.op3(MIX, a, b, t, 0.0)
    }

    /// `saturate(a)`.
    pub fn clamp01(mut self, a: Reg) -> Reg {
        self.op(CLAMP01, a, a, 0.0)
    }

    /// `pow(a, e)`.
    pub fn pow(mut self, a: Reg, e: f32) -> Reg {
        self.op(POW, a, a, e)
    }

    /// `log(a)`.
    pub fn log(mut self, a: Reg) -> Reg {
        self.op(LOG, a, a, 0.0)
    }

    /// `a - b * floor(a / b)`.
    pub fn modulo(mut self, a: Reg, b: Reg) -> Reg {
        self.op(MOD, a, b, 0.0)
    }

    /// The table's `n` entries from `at` (`table`), read at `i` (`LOAD`) or between at `t`
    /// (`LERP_LOAD`).
    pub fn load(mut self, at: u32, n: u32, i: Reg) -> Reg {
        self.op3(LOAD, i, i, Reg { index: n }, f32(at))
    }

    /// Between the table's entries `at + floor(t)` and the one after, linearly (`t` clamped to
    /// the `n` entries from `at`).
    pub fn lerp_load(mut self, at: u32, n: u32, t: Reg) -> Reg {
        self.op3(LERP_LOAD, t, t, Reg { index: n }, f32(at))
    }

    /// `value_noise(vec3(x, y, z) * scale)`.
    pub fn noise(mut self, x: Reg, y: Reg, z: Reg, scale: f32) -> Reg {
        self.op3(NOISE3, x, y, z, scale)
    }

    /// `fbm(freq, octaves).value(vec3(x, y, z))`, each octave `gain` of the last (std's `Fbm`
    /// is 0.5).
    pub fn fbm(mut self, x: Reg, y: Reg, z: Reg, freq: f32, octaves: u32, gain: f32 = 0.5) -> Reg {
        let at = self.table([freq, f32(octaves), gain])
        self.op3(FBM3, x, y, z, f32(at))
    }

    /// The lattice's hash of the cell `(floor(x), floor(y), floor(z))`, in [-1, 1].
    pub fn hash(mut self, x: Reg, y: Reg, z: Reg) -> Reg {
        self.op3(HASH, x, y, z, 0.0)
    }

    /// `atan2(a, b)`.
    pub fn atan2(mut self, a: Reg, b: Reg) -> Reg {
        self.op(ATAN2, a, b, 0.0)
    }

    /// Integer operation `code` (`IADD` to `F2U`) of `a` and `b` (`b` unread by one of one
    /// operand): an integer's high register (its low is the next), or a float's.
    pub fn integer(mut self, code: u32, a: Reg, b: Reg) -> Reg {
        if code < IADD || code > PCG {
            panic("not an integer operation")
        }
        let r = self.op(code, a, b, 0.0)
        if half_op(code) {
            let _ = self.op(code, a, b, 1.0)
        }
        r
    }

    /// Integer operation `code` of three integers (`IMAD`): its high register.
    pub fn integer3(mut self, code: u32, a: Reg, b: Reg, t: Reg) -> Reg {
        if code != IMAD {
            panic("not an integer operation of three")
        }
        let r = self.op3(code, a, b, t, 0.0)
        let _ = self.op3(code, a, b, t, 1.0)
        r
    }

    /// The integer `x`: its high register (its low is the next).
    pub fn integer_constant(mut self, x: u32) -> Reg {
        let r = self.constant(f32(x >> 16))
        let _ = self.constant(f32(x & 65535))
        r
    }

    /// `dot(u, v)` of two vectors, each three registers in a row from `u` and `v`.
    pub fn dot3(mut self, u: Reg, v: Reg) -> Reg {
        self.op(DOT3, u, v, 0.0)
    }

    /// Value noise averaged over the box `p ± half`, each three registers in a row from `p`
    /// and `half` (`std::field::value_noise_box`).
    pub fn noise_box(mut self, p: Reg, half: Reg) -> Reg {
        self.op(BOXNOISE3, p, half, 0.0)
    }

    /// `length` of the vector three registers in a row from `u`.
    pub fn length3(mut self, u: Reg) -> Reg {
        self.op(LEN3, u, u, 0.0)
    }

    /// Component `k` of `normalize` of the vector three registers in a row from `u`.
    pub fn normalize3(mut self, u: Reg, k: u32) -> Reg {
        self.op(NORM3, u, u, f32(k))
    }

    /// A register's copy: the next operation's, in a row with others (a vector's components).
    pub fn copy(mut self, a: Reg) -> Reg {
        self.op(COPY, a, a, 0.0)
    }

    /// The length of `(a, b, c)`, as `length` computes it: the squares summed in order, then
    /// the root.
    pub fn length(mut self, a: Reg, b: Reg, c: Reg) -> Reg {
        let aa = self.mul(a, a)
        let bb = self.mul(b, b)
        let cc = self.mul(c, c)
        let ab = self.add(aa, bb)
        let s = self.add(ab, cc)
        self.sqrt(s)
    }

    /// A sphere's distance: `sphere(radius).translate(center)`, as std::field computes it.
    pub fn sphere(mut self, center: vec3, radius: f32) -> Reg {
        let x = self.op(X, Reg { index: 0 }, Reg { index: 0 }, center.x)
        let y = self.op(Y, Reg { index: 0 }, Reg { index: 0 }, center.y)
        let z = self.op(Z, Reg { index: 0 }, Reg { index: 0 }, center.z)
        let d = self.length(x, y, z)
        let r = self.constant(radius)
        self.sub(d, r)
    }

    /// The register `k`'s value over `over`, as `interval` derives it from `interpret`.
    fn register_interval(self, k: u32, over: Box3) -> Interval {
        var boxed = false
        for i in 0..k + 1 {
            boxed = boxed || self.ops[i].opcode() == BOXNOISE3
        }
        self.derived_interval(k, over, boxed)
    }

    /// `register_interval`, told whether a box noise comes at or before `k` (`boxed`): a box
    /// noise's loops run as often as its box is wide, so no interval derives through them, and
    /// past one a register's interval is every number's.
    fn derived_interval(self, k: u32, over: Box3, boxed: bool) -> Interval {
        if boxed {
            return Interval { lo: -1.0 / 0.0, hi: 1.0 / 0.0 }
        }
        var upto = self
        upto.len = k + 1
        interval(|q| interpret_unboxed(upto, q), over)
    }

    /// Each register's `register_interval` over `over`, from one pass: each operation's interval
    /// is `interval` of its step, the step `interpret` takes, over its operands' intervals. That
    /// is `interpret`'s own derived arithmetic, an operation at a time, because an interval
    /// follows no value's identity through a register. Two differences remain: `interval` makes
    /// a NaN bound infinite, at the end of the function it derives, so a bound that isn't finite
    /// may stand for a NaN that the whole tape's derivation would carry on; and a dot product
    /// reads six registers, more than a step's box holds. An operation that reads such a
    /// register, or a dot product, takes its `register_interval` instead.
    fn register_intervals(self, over: Box3) -> [Interval; N] {
        var r = [Interval { lo: 0.0, hi: 0.0 }; N]
        var finite = [false; N]
        // The tape, for the steps' closures: copied once, not at each operation.
        let me = self
        // Whether a box noise has come yet (`derived_interval`).
        var boxed = false
        for i in 0..self.len {
            let op = self.ops[i]
            let code = op.opcode()
            boxed = boxed || code == BOXNOISE3
            let n = arity(code)
            let wide = if vector_op(code) { 2 } else { 0 }
            var known = true
            if n >= 1 {
                for k in 0..wide + 1 {
                    known = known && finite[op.a + k]
                }
            }
            if n >= 2 && !two_vectors(code) {
                known = known && finite[op.b]
            }
            if n == 3 {
                known = known && finite[op.third()]
            }
            r[i] = if integer_op(code) {
                // An integer's halves are whole numbers to 65535; a comparison 0 or 1.
                let hi = if half_op(code) { 65535.0 } else if code == I2F {
                    2147483647.0
                } else if code == U2F { 4294967295.0 } else { 1.0 }
                Interval { lo: if code == I2F { -2147483648.0 } else { 0.0 }, hi }
            } else if n == 0 {
                interval(|q: vec3| apply(op, q, a: 0.0, b: 0.0, t: 0.0), over)
            } else if code == BOXNOISE3 {
                // A mean of lattice values, each in [-1, 1].
                Interval { lo: -1.0, hi: 1.0 }
            } else if !known || code == DOT3 {
                self.derived_interval(i, over, boxed)
            } else if vector_op(code) {
                let u = Box3 {
                    lo: vec3(r[op.a].lo, r[op.a + 1].lo, r[op.a + 2].lo),
                    hi: vec3(r[op.a].hi, r[op.a + 1].hi, r[op.a + 2].hi),
                }
                if code == LEN3 {
                    interval(|v: vec3| length(v), u)
                } else {
                    interval(|v: vec3| vector_component(normalize(v), op.c), u)
                }
            } else if code == LOAD || code == LERP_LOAD {
                let a = r[op.a]
                interval(
                    |v: vec2| table(me, op, v.x),
                    Box2 { lo: vec2(a.lo, 0.0), hi: vec2(a.hi, 0.0) },
                )
            } else {
                let a = r[op.a]
                let b = if n >= 2 { r[op.b] } else { Interval { lo: 0.0, hi: 0.0 } }
                let t = if n == 3 { r[op.third()] } else { Interval { lo: 0.0, hi: 0.0 } }
                let abt = Box3 { lo: vec3(a.lo, b.lo, t.lo), hi: vec3(a.hi, b.hi, t.hi) }
                if code == FBM3 {
                    interval(|v: vec3| fbm3(me, op, v), abt)
                } else {
                    interval(|v: vec3| apply(op, vec3(0.0), v.x, v.y, v.z), abt)
                }
            }
            finite[i] = is_finite(r[i].lo) && is_finite(r[i].hi)
        }
        r
    }

    /// The field's interval over `over`: every value it takes there lies within it (the bound
    /// `prune` reads, its last operation's), so a realizer culls a block by it as a compiled
    /// field's `interval`. An empty tape's is 0.
    pub fn interval(self, over: Box3) -> Interval {
        if self.len == 0 {
            return Interval { lo: 0.0, hi: 0.0 }
        }
        self.register_intervals(over)[self.len - 1]
    }

    /// The same field within `over`, with less work: each minimum or maximum whose operands'
    /// intervals over `over` don't overlap (by the smooth minimum's width, for one), and each
    /// selection or step whose condition has one sign there, becomes the operand it always
    /// picks (or the constant a step gives), then the operations the value no longer uses are
    /// dropped. Inside `over`, the result has the same value and the same derived gradient as
    /// the original at every point; outside, it may not.
    ///
    /// Intervals that only touch overlap: the operands can tie there, and at a tie a minimum's
    /// or maximum's gradient is the average of both operands' (§14.2), not either one's. A
    /// smooth minimum exactly its width apart is the lower operand, value and gradient (`smin`'s
    /// `m` is 0 there, so `m * (m * s)` and its tangent are 0), but `a.hi + k` rounds: a sum
    /// equal to `b.lo` doesn't show that `b - a >= k` at every point, while one below it does.
    pub fn prune(self, over: Box3) -> Taped<N, K> {
        let iv = self.register_intervals(over)
        var ops = self.ops
        for i in 0..self.len {
            let op = ops[i]
            let code = op.opcode()
            let copy = |r: u32| Op { code: COPY, a: r, b: r, c: 0.0 }
            if code == MIN || code == MAX || code == SMIN {
                let a = iv[op.a]
                let b = iv[op.b]
                // The width a smooth minimum blends over; 0 for the others.
                let k = if code == SMIN { max(op.c, 0.0) } else { 0.0 }
                let a_low = a.hi + k < b.lo
                let b_low = b.hi + k < a.lo
                let keep_a = if code == MAX { b_low } else { a_low }
                let keep_b = if code == MAX { a_low } else { b_low }
                if keep_a {
                    ops[i] = copy(op.a)
                } else if keep_b {
                    ops[i] = copy(op.b)
                }
            } else if code == SELECT {
                let a = iv[op.a]
                if a.lo > 0.0 {
                    ops[i] = copy(op.b)
                } else if a.hi <= 0.0 {
                    ops[i] = copy(op.third())
                }
            } else if code == STEP {
                let a = iv[op.a]
                let b = iv[op.b]
                if a.hi < b.lo {
                    ops[i] = Op { code: CONST, a: 0, b: 0, c: 1.0 }
                } else if a.lo >= b.hi {
                    ops[i] = Op { code: CONST, a: 0, b: 0, c: 0.0 }
                }
            }
        }
        self.drop_unused(ops, self.keep)
    }

    /// The tape with operations `ops`: the ones its last `keep` registers use (its value, and
    /// for a tape of `tape_with`, the floats beside it), in order, renumbered.
    fn drop_unused(self, ops: [Op; N], keep: u32) -> Taped<N, K> {
        if self.len == 0 {
            return self
        }
        // The registers the value uses, from the last back; and those a vector operation reads
        // three in a row, which keep their place (a copy among them isn't read through), as do
        // the last `keep`.
        var used = [false; N]
        var in_row = [false; N]
        for k in 0..min(keep, self.len) {
            used[self.len - 1 - k] = true
            in_row[self.len - 1 - k] = true
        }
        var i = self.len
        while i > 0 {
            i -= 1
            if used[i] {
                let op = ops[i]
                let code = op.opcode()
                let n = arity(code)
                // An integer's pair stays in a row too.
                let wide = if vector_op(code) { 3 } else if pair_op(code) { 2 } else { 1 }
                if n >= 1 {
                    for k in 0..wide {
                        used[op.a + k] = true
                        in_row[op.a + k] = in_row[op.a + k] || wide > 1
                    }
                }
                if n >= 2 {
                    let wb = if two_vectors(code) { 3 } else if pair_op(code) {
                        2
                    } else {
                        1
                    }
                    for k in 0..wb {
                        used[op.b + k] = true
                        in_row[op.b + k] = in_row[op.b + k] || wb > 1
                    }
                }
                if n == 3 {
                    used[op.third()] = true
                    // An integer's pair stays in a row.
                    if code == IMAD {
                        used[op.third() + 1] = true
                        in_row[op.third()] = true
                        in_row[op.third() + 1] = true
                    }
                }
            }
        }
        // Those operations, in order, renumbered; a copy reads through to what it copies.
        var out = self
        out.len = 0
        var at = [0; N]
        for j in 0..self.len {
            if used[j] {
                let op = ops[j]
                let code = op.opcode()
                if code == COPY && j + 1 < self.len && !in_row[j] {
                    at[j] = at[op.a]
                } else {
                    at[j] = out.len
                    let n = arity(code)
                    let a = if n >= 1 { at[op.a] } else { op.a }
                    let b = if n >= 2 { at[op.b] } else { op.b }
                    let t = if n == 3 { at[op.third()] } else { op.third() }
                    out.ops[out.len] = Op { code: code | (t << 16), a, b, c: op.c }
                    out.len += 1
                }
            }
        }
        out.keep = keep
        out
    }
}

// ---- tests (the suite runs std's: `std_tests_pass`) --------------------------------------------

/// A 32-bit integer hash (`lowbias32`), for the tests' tapes and boxes.
fn mix(x: u32) -> u32 {
    var h = x ^ (x >> 16)
    h = h.wrapping_mul(2146121005)
    h = h ^ (h >> 15)
    h = h.wrapping_mul(2221713035)
    h ^ (h >> 16)
}

/// The kinds of operation `random_tape` draws: all but division and `exp`, whose unbounded
/// ranges would make NaNs, which a debug build (as tests run) stops at.
const DRAWN: [u32; 15] = [X, Y, Z, CONST, ADD, SUB, MUL, MIN, MAX, SMIN, NEG, ABS, SQRT, SIN, COS]

/// `n` operations from `seed`, each over random earlier registers. A constant is often 0, 1 or
/// 2, so operands tie; a smooth minimum's width is from 1/4 to 2.
fn random_tape(n: u32, seed: u32) -> Tape {
    var t = Tape::new()
    let _ = t.x()
    for i in 1..n {
        let h = mix(seed * 1024 + i)
        let code = DRAWN[mix(h) % 15]
        let a = Reg { index: mix(h + 1) % i }
        let b = if code > SMIN { a } else { Reg { index: mix(h + 2) % i } }
        let c = if code == SMIN {
            f32(1 + mix(h + 3) % 8) / 4.0
        } else if h & 1 == 0 {
            f32(mix(h + 3) % 3)
        } else {
            f32(mix(h + 3) % 1024) / 256.0 - 2.0
        }
        let _ = t.op(code, a, b, c)
    }
    t
}

/// A box about a point in [-1.5, 1.5]³, up to 1 wide; one in four is a single point.
fn random_box(seed: u32) -> Box3 {
    let h = mix(seed + 77)
    let c = vec3(f32(mix(h) % 768), f32(mix(h + 1) % 768), f32(mix(h + 2) % 768)) / 256.0
    let w = if h % 4 == 0 { 0.0 } else { f32(mix(h + 3) % 256) / 512.0 }
    Box3 { lo: c - vec3(1.5 + w), hi: c - vec3(1.5 - w) }
}

/// Checks that each of `t`'s registers' interval from the one pass is the tape's up to it, bit
/// for bit.
fn check_intervals(t: Tape, over: Box3) {
    let iv = t.register_intervals(over)
    for k in 0..t.len {
        let want = t.register_interval(k, over)
        assert(
            bitcast_u32(iv[k].lo) == bitcast_u32(want.lo) &&
                bitcast_u32(iv[k].hi) == bitcast_u32(want.hi),
            "a register's interval differs from the tape's up to it",
        )
    }
}

@test
fn each_registers_interval_is_the_tapes_up_to_it() {
    // Over random tapes and boxes, and the tapes pruned to them (which can end in a copy).
    var shorter = 0
    for n in [16, 32, 64, 128] {
        for seed in 0..2 {
            let t = random_tape(n, seed)
            for j in 0..3 {
                let over = random_box(n * 16 + seed * 4 + j)
                check_intervals(t, over)
                let p = t.prune(over)
                check_intervals(p, over)
                if p.len < t.len {
                    shorter += 1
                }
            }
        }
    }
    assert(shorter > 0, "the sample prunes nothing")
}

/// `ops`, a tape: each `(code, a, b, c)`.
fn tape_of(ops: [(u32, u32, u32, f32)]) -> Tape {
    var t = Tape::new()
    for (code, a, b, c) in ops {
        let _ = t.op(code, Reg { index: a }, Reg { index: b }, c)
    }
    t
}

/// `(code, 0, 1, c)` over the constants `a` and `b`, pruned to a box.
fn pruned(code: u32, a: f32, b: f32, c: f32) -> Tape {
    let over = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }
    tape_of([(CONST, 0, 0, a), (CONST, 0, 0, b), (code, 0, 1, c)]).prune(over)
}

/// Whether `t` is the one constant `c`.
fn is_constant(t: Tape, c: f32) -> bool {
    t.len == 2 && t.ops[0].code == CONST && t.ops[0].c == c && t.ops[1].code == COPY
}

@test
fn pruning_keeps_both_operands_at_a_tie() {
    // A tie's gradient is the average of both operands' (§14.2), so where the intervals touch
    // both stay; one ulp apart, the operation is the operand it picks.
    let up = 1.0000001
    for code in [MIN, MAX] {
        assert(pruned(code, a: 1.0, b: 1.0, c: 0.0).len == 3, "a tie keeps both")
    }
    assert(is_constant(pruned(MIN, a: 1.0, b: up, c: 0.0), 1.0), "an ulp apart: min")
    assert(is_constant(pruned(MAX, a: 1.0, b: up, c: 0.0), up), "an ulp apart: max")
    // A smooth minimum blends nearer than its width. Exactly the width apart it keeps both,
    // as the rounded `a.hi + k` can't tell that from nearer: 2³⁰ + 1 is 2³⁰, so the second
    // pair would prune, though its operands tie and blend half each.
    let big = 1073741824.0
    assert(pruned(SMIN, a: 0.0, b: 0.5, c: 0.5).len == 3, "the width apart")
    assert(pruned(SMIN, a: big, b: big, c: 1.0).len == 3, "a tie at 2^30")
    assert(is_constant(pruned(SMIN, a: 0.0, b: 0.5, c: 0.49999997), 0.0), "an ulp more")
}

@test
fn an_unbounded_operand_takes_the_tapes_interval() {
    // 1 / x over a box where x crosses 0 is unbounded; what reads it takes the interval of the
    // tape up to it. |1 / x| is at least 0, so its maximum with -1 is it.
    let t = tape_of(
        [
            (X, 0, 0, 0.0),
            (CONST, 0, 0, 1.0),
            (DIV, 1, 0, 0.0),
            (ABS, 2, 2, 0.0),
            (CONST, 0, 0, -1.0),
            (MAX, 3, 4, 0.0),
        ],
    )
    let over = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }
    check_intervals(t, over)
    let iv = t.register_intervals(over)
    assert(iv[2].lo == -1.0 / 0.0 && iv[3].lo == 0.0 && iv[3].hi == 1.0 / 0.0)
    let p = t.prune(over)
    assert(p.len == 5 && p.ops[4].code == COPY && p.ops[4].a == 3, "the maximum is |1 / x|")
}

@test
fn pruning_settles_a_selection_whose_condition_has_one_sign() {
    // `x + 2 > 0` on x in [-1, 1]: the selection is always its second operand, so its third
    // and what only it reads go; on [-3, 1] the condition takes both signs, and both stay.
    var t = Tape::new()
    let x = t.x()
    let two = t.constant(2.0)
    let cond = t.add(x, two)
    let picked = t.sin(x)
    let other = t.cos(x)
    let _ = t.select(cond, picked, other)
    let one_sign = t.prune(Box3 { lo: vec3(-1.0), hi: vec3(1.0) })
    assert(one_sign.len < t.len, "the selection folds")
    let last = one_sign.ops[one_sign.len - 1]
    assert(last.opcode() == COPY && one_sign.ops[last.a].opcode() == SIN, "to its second operand")
    let both = t.prune(Box3 { lo: vec3(-3.0), hi: vec3(1.0) })
    assert(both.len == t.len, "both signs: kept whole")
    // A step whose operands' intervals are apart is a constant.
    var u = Tape::new()
    let ux = u.x()
    let three = u.constant(3.0)
    let _ = u.step(ux, three)
    let stepped = u.prune(Box3 { lo: vec3(-1.0), hi: vec3(1.0) })
    let s = stepped.ops[stepped.len - 1]
    assert(stepped.len == 1 && s.opcode() == CONST && s.c == 1.0, "x < 3 throughout: 1")
}

@test
fn a_tube_of_twenty_sections_with_a_displacement_tapes_short() {
    // A limb's loft: 20 sections bending along a helix, its radii tapering, displaced by
    // fractal noise. Its tape holds each section's cone (its data reaches the tape as
    // constants) and the noise's octaves, and agrees with the compiled field: 1,067 operations
    // at 0.8.0.
    var points = [vec3(0.0); 20]
    var radii = [0.0; 20]
    for i in 0..20 {
        let t = f32(i) / 19.0
        points[i] = vec3(0.4 * cos(6.0 * t), 2.0 * t - 1.0, 0.4 * sin(6.0 * t))
        radii[i] = 0.25 - 0.15 * t
    }
    let limb = std::field::tube(points, radii).displace(std::field::fbm(3.0, 4), 0.02)
    let t = std::derive::tape(|q| limb.distance(q))
    assert(t.len() < 2048, f"the tape holds {t.len()} operations")
    for i in 0..1000 {
        let p = Box3 { lo: vec3(-1.5), hi: vec3(1.5) }.sample(3, i)
        let (a, b) = (interpret(t, p), limb.distance(p))
        assert(abs(a - b) <= 1e-5, f"at {p}: the tape's {a}, the field's {b}")
    }
}

@test
fn a_tape_with_carries_its_channels() {
    // A distance and a colour that depends on the point: the tape's last four registers.
    let t = std::derive::tape_with(|q: vec3| (length(q) - 1.0, vec3(saturate(q.y), 0.5, q.x * q.z)))
    let p = vec3(0.25, 0.75, -2.0)
    let (d, rest) = interpret_with::<TAPE_LEN, TAPE_CONSTS, 3>(t, p)
    assert(d == length(p) - 1.0 && rest[0] == 0.75 && rest[1] == 0.5 && rest[2] == -0.5)
}

@test
fn a_tapes_interval_holds_every_value_it_takes() {
    var t: Tape = Taped::new()
    let x = t.x()
    let y = t.y()
    let s = t.sphere(vec3(0.0), 1.0)
    let xy = t.mul(x, y)
    let _ = t.add(xy, s)
    let over = Box3 { lo: vec3(0.5, -1.0, 0.0), hi: vec3(1.5, 0.5, 0.25) }
    let iv = t.interval(over)
    for i in 0..64 {
        let u = vec3(f32(i % 4) / 3.0, f32((i / 4) % 4) / 3.0, f32(i / 16) / 3.0)
        let p = over.lo + (over.hi - over.lo) * u
        let v = interpret(t, p)
        assert(v >= iv.lo && v <= iv.hi, f"{v} outside [{iv.lo}, {iv.hi}] at {p}")
    }
    let empty: Tape = Taped::new()
    assert(empty.interval(over).lo == 0.0 && empty.interval(over).hi == 0.0)
}
