// GPU buffers, textures and passes, the builtins of GPU entry points, and the CPU calls that
// record GPU work: dispatches, draws, copies and readbacks (language.md §18, §18.3). Every
// function here that CPU code calls carries the `host` effect.

use std::abi::{
    COMPARE_ALWAYS, COMPARE_EQUAL, COMPARE_GREATER, COMPARE_GREATER_EQUAL, COMPARE_LESS,
    COMPARE_LESS_EQUAL, COMPARE_NEVER, COMPARE_NOT_EQUAL, FORMAT_DEPTH32FLOAT, FORMAT_R16FLOAT,
    FORMAT_R16FLOAT_BYTES, FORMAT_R32FLOAT, FORMAT_R32FLOAT_BYTES, FORMAT_R32UINT,
    FORMAT_R32UINT_BYTES, FORMAT_RG16FLOAT, FORMAT_RG16FLOAT_BYTES, FORMAT_RGBA16FLOAT,
    FORMAT_RGBA16FLOAT_BYTES, FORMAT_RGBA8UNORM, FORMAT_RGBA8UNORM_BYTES, FORMAT_R8UNORM,
    FORMAT_R8UNORM_BYTES, FORMAT_RG8UNORM, FORMAT_RG8UNORM_BYTES, FORMAT_RGB10A2UNORM,
    FORMAT_RGB10A2UNORM_BYTES, FORMAT_RG32FLOAT, FORMAT_RG32FLOAT_BYTES, FORMAT_RGBA32FLOAT,
    FORMAT_RGBA32FLOAT_BYTES, FORMAT_RG32UINT, FORMAT_RG32UINT_BYTES, FORMAT_RG11B10UFLOAT,
    FORMAT_RG11B10UFLOAT_BYTES, FORMAT_BC1_RGBA_UNORM, FORMAT_BC1_RGBA_UNORM_BYTES,
    FORMAT_BC4_R_UNORM, FORMAT_BC4_R_UNORM_BYTES, FORMAT_BC5_RG_UNORM, FORMAT_BC5_RG_UNORM_BYTES,
    FORMAT_BC7_RGBA_UNORM, FORMAT_BC7_RGBA_UNORM_BYTES, FORMAT_ETC2_RGB8UNORM,
    FORMAT_ETC2_RGB8UNORM_BYTES, FORMAT_ASTC_4X4_UNORM, FORMAT_ASTC_4X4_UNORM_BYTES, KIND_2D,
    KIND_3D, KIND_ARRAY, KIND_CUBE, MAX_LAYERS, MAX_TEXTURE_3D, TEXTURE_WRITABLE,
    FORMAT_DEPTH32FLOAT_BYTES,
}
use std::io::{IoError, Pending, next_request}
use std::mem::{Drop, gpu_count, own_gpu_count, set_gpu_count, size_of}

/// A buffer of `T`s on the GPU: an owned value, which CPU code creates, writes into and passes
/// to kernels and shaders, but can't read through. Dropping it releases it; the host
/// waits for work already recorded with it. A buffer in the program's state lasts with it.
pub struct GpuBuffer<T> {
    // The compiler binds a buffer by these two fields, in this order.
    handle: u32,
    count: u32,
}

impl<T> Drop for GpuBuffer<T> {
    fn drop(mut self) {
        if self.handle != 0 {
            destroy_buffer(self.handle)
            count_memory(0, buffer_bytes::<T>(self.count), add: false)
        }
    }
}

impl<T: GpuData> GpuBuffer<T> {
    /// How many elements it holds.
    pub fn len(self) -> u32 {
        self.count
    }

    /// All its elements, read-only: a `GpuSpan<T>` of them. A bound entry point holds a buffer
    /// given for a `[T]` parameter as this span (§18).
    pub fn items(self) -> GpuSpan<T> {
        GpuSpan { buffer: self, start: 0, count: self.count }
    }

    /// All its elements, to change: a `GpuSpanMut<T>` of them. A bound entry point holds a
    /// buffer given `mut` for a `mut Slots<T>` parameter as this span (§18).
    pub fn items_mut(mut self) -> GpuSpanMut<T> {
        let count = self.count
        GpuSpanMut { buffer: mut self, start: 0, count }
    }

    /// Element `i`, where it is (a `GpuField`): for a command that reads it there, or, through
    /// its fields, a field of it (`buf.at(i).draw`). An element past the end panics.
    pub fn at(self, i: u32) -> GpuField<T, T> {
        if i >= self.count {
            panic("at: the element is past the end of the buffer")
        }
        GpuField { buffer: self, offset: i * size_of::<T>() }
    }

    /// Elements `start` to `start + count`, read-only: to bind for a `[T]` parameter, or to
    /// copy from. A range past the end panics.
    pub fn span(self, start: u32, count: u32) -> GpuSpan<T> {
        if start > self.count || count > self.count - start {
            panic("span: the range is past the end of the buffer")
        }
        GpuSpan { buffer: self, start, count }
    }

    /// Elements `start` to `start + count`, to change: to bind for a `mut Slots<T>`
    /// parameter, or to copy into. A range past the end panics.
    pub fn span_mut(mut self, start: u32, count: u32) -> GpuSpanMut<T> {
        if start > self.count || count > self.count - start {
            panic("span_mut: the range is past the end of the buffer")
        }
        GpuSpanMut { buffer: mut self, start, count }
    }
}

/// A run of a GPU buffer's elements, read-only: a projection of the buffer, as `[T]` is of an
/// array (§18.3). Two spans of one buffer bound together count as overlapping, even if their
/// ranges don't. Bound to a kernel, a span starts at a multiple of 256 bytes (WebGPU's rule),
/// which the host checks.
pub borrow struct GpuSpan<T> {
    pub buffer: borrow GpuBuffer<T>,
    pub start: u32,
    pub count: u32,
}

impl<T: GpuData> GpuSpan<T> {
    /// How many elements it holds: in GPU code too, where it's read as a `[T]` (§18).
    pub fn len(self) -> u32 {
        span_len(self)
    }
}

@intrinsic
fn span_len<T>(s: GpuSpan<T>) -> u32 {}

/// One value in a `GpuBuffer<S>`, where it is: an element (`buf.at(i)`) or, through the
/// element's fields, a field of it (`buf.at(i).draw`, a `GpuField<S, DrawIndexedArgs>`; §18).
/// CPU code names it without reading it, for a command that reads it there (`indirect:`,
/// `groups:`). It borrows its buffer, as a span does.
pub borrow struct GpuField<S, T> {
    buffer: borrow GpuBuffer<S>,
    offset: u32,
}

/// Field `K` of the struct `f` names, where it is: what `f.name` is.
@intrinsic
fn field_at<S, T, U, const K: u32>(f: GpuField<S, T>) -> GpuField<S, U> {}

/// A run of a GPU buffer's elements, to change.
pub borrow struct GpuSpanMut<T> {
    pub buffer: mut GpuBuffer<T>,
    pub start: u32,
    pub count: u32,
}

/// Copies `from`'s elements into `to`, in recorded order with dispatches and draws. The spans
/// must be the same length, and in different buffers.
pub fn copy<T: GpuData>(from: GpuSpan<T>, to: GpuSpanMut<T>) {
    if from.count != to.count {
        panic("copy: the spans' lengths differ")
    }
    let n = size_of::<T>()
    copy_buffer(from.buffer.handle, from.start * n, to.buffer.handle, to.start * n, from.count * n)
}

@intrinsic
fn destroy_buffer(handle: u32) {}

@intrinsic
fn copy_buffer(from: u32, from_offset: u32, to: u32, to_offset: u32, size: u32) {}

/// A kernel parameter where each invocation writes only its own slot, indexed by its
/// `GlobalId` (§18.4). The CPU passes a `GpuBuffer<T>` for it.
pub struct Slots<T> {
    handle: u32,
}

/// The invocation's position in the whole dispatch.
pub struct GlobalId: Copy {
    pub x: u32,
    pub y: u32,
    pub z: u32,
}

/// The invocation's position within its workgroup.
pub struct LocalId: Copy {
    pub x: u32,
    pub y: u32,
    pub z: u32,
}

/// The workgroup's position in the dispatch.
pub struct WorkgroupId: Copy {
    pub x: u32,
    pub y: u32,
    pub z: u32,
}

impl GlobalId {
    /// As a vector.
    pub fn xyz(self) -> vec3u {
        vec3u(self.x, self.y, self.z)
    }
}

impl LocalId {
    /// As a vector.
    pub fn xyz(self) -> vec3u {
        vec3u(self.x, self.y, self.z)
    }
}

impl WorkgroupId {
    /// As a vector.
    pub fn xyz(self) -> vec3u {
        vec3u(self.x, self.y, self.z)
    }
}

/// A vertex shader's vertex number.
pub struct VertexIndex: Copy {
    pub index: u32,
}

/// A vertex shader's instance number.
pub struct InstanceIndex: Copy {
    pub index: u32,
}

/// A kernel invocation's index in its subgroup, from 0 to `SubgroupSize`'s less one: a kernel's
/// parameter, on a device with `features().subgroups` (§18.10).
pub struct SubgroupInvocation: Copy {
    pub index: u32,
}

/// How many invocations the kernel's subgroups have: between `features().subgroup_min` and
/// `subgroup_max`, the same for every subgroup of a dispatch. A kernel's parameter.
pub struct SubgroupSize: Copy {
    pub size: u32,
}

/// A fragment's window position: pixel centres are at half-integers.
pub struct FragCoord: Copy {
    pub position: vec4,
}

/// A vertex shader's clip-space output position.
pub struct ClipPosition: Copy {
    pub position: vec4,
}

/// A fragment shader's colour, drawn over what's in its target: alpha blending, with straight
/// (not premultiplied) alpha. A fragment shader that returns a `vec4` replaces what's there.
///
/// ```wrela
/// use std::gpu::{FragCoord, Over}
///
/// @fragment
/// fn glass(pixel: FragCoord) -> Over {
///     Over { color: vec4(0.2, 0.4, 0.8, 0.5) }   // half covers what's under it
/// }
/// ```
pub struct Over: Copy {
    pub color: vec4,
}

/// A fragment shader's colour (`C`: a `vec4`, or a `u32` for an `R32Uint` target) and its own
/// depth (from 0 to 1, as the clip position's z over its w), in place of the depth its triangle
/// gives it: the depth test and the depth target take it. For a flat stand-in whose fragments
/// show something at other depths (an impostor's leaves). The GPU's early depth test is off for
/// a shader that returns one.
pub struct WithDepth<C>: Copy {
    pub color: C,
    pub depth: f32,
}

/// A vertex output that isn't interpolated.
pub struct Flat<T>: Copy {
    pub value: T,
}

/// Creates a GPU buffer of `count` elements, zeroed.
pub fn buffer<T: GpuData>(count: u32) -> GpuBuffer<T> {
    let b: GpuBuffer<T> = new_buffer(count)
    count_memory(0, buffer_bytes::<T>(count), add: true)
    b
}

@intrinsic
fn new_buffer<T: GpuData>(count: u32) -> GpuBuffer<T> {}

/// A buffer's bytes, as its creation asks for: `count` elements, or one for an empty buffer
/// (WebGPU binds no less), and at least 4.
fn buffer_bytes<T>(count: u32) -> u64 {
    let n = u64(size_of::<T>())
    if count == 0 { u64(max(size_of::<T>(), 4)) } else { u64(count) * n }
}

/// What the program holds on the GPU (§18.10): the bytes of its buffers and textures now, and
/// the most of each it has held at once. std counts them as it creates and drops each (a
/// texture by its levels' blocks and its layers), the program's own arithmetic; test mode's
/// `memory.json` is the host's count, the same numbers. A budget a game sets for itself is
/// checked against it. It's `nondet`: a ticker reading it would see the frames' count at a time
/// timing chooses, so `@deterministic` code takes it as data.
pub struct Memory: Copy {
    pub buffers: u64,
    pub textures: u64,
    pub peak_buffers: u64,
    pub peak_textures: u64,
}

/// What the program holds on the GPU.
pub fn memory() -> Memory {
    Memory {
        buffers: gpu_count(0),
        textures: gpu_count(1),
        peak_buffers: gpu_count(2),
        peak_textures: gpu_count(3),
    }
}

/// Adds `bytes` to (`add`) or takes them from the buffers' count (`which` 0) or the textures'
/// (1), and raises the peak.
fn count_memory(which: u32, bytes: u64, add: bool) {
    let now = own_gpu_count(which)
    let next = if add { now + bytes } else if bytes > now { 0 } else { now - bytes }
    set_gpu_count(which, next)
    if next > own_gpu_count(which + 2) {
        set_gpu_count(which + 2, next)
    }
}

/// Creates a GPU buffer holding `values`, at least `at_least` elements long (the rest zeroed: a
/// list that can be empty still makes a buffer that can be bound, with `at_least: 1`), and
/// copies them in (`write`).
pub fn buffer_of<T: GpuData>(values: [T], at_least: u32 = 0) -> GpuBuffer<T> {
    var b: GpuBuffer<T> = buffer(max(values.len(), at_least))
    write(mut b, 0, values)
    b
}

/// Copies `values` into `buf`, starting at element `at`. The copy happens in recorded order
/// with dispatches and draws. Writing past the end panics.
pub fn write<T: GpuData>(buf: mut GpuBuffer<T>, at: u32, values: [T]) {
    if at > buf.count || values.len() > buf.count - at {
        panic("write: the values run past the end of the buffer")
    }
    write_buffer(buf.handle, at, values)
}

@intrinsic
fn write_buffer<T: GpuData>(handle: u32, at: u32, values: [T]) {}

/// A kernel bound to its arguments, as a value: `let k = fill.bind(0.5, mut out)` (§18). Each
/// entry point has a borrow struct of its arguments, which the compiler makes and which has
/// this trait; a function generic over `K: Kernel` takes any of them and passes it to
/// `dispatch`, each kernel's instance its own pipeline.
pub trait Kernel {}

/// A vertex shader bound to its arguments, as a value, whose output is `V` (§18).
pub trait VertexShader<V> {}

/// A fragment shader bound to its arguments, as a value, whose input from the vertex shader is
/// `V` (§18). One that takes no input from it has the trait for every `V`.
pub trait FragmentShader<V> {}

/// Records a dispatch of a `@compute` kernel bound to its arguments: `dispatch(kernel.bind(a,
/// b), groups: n)`. The arguments are the kernel's, without its builtins, matched as a call's
/// are; a kernel that takes nothing is named alone. `groups` is a `u32`, a `(u32, u32, u32)`, or
/// a buffer holding them (indirect). Small `GpuData` arguments travel as uniforms. A
/// `GpuBuffer<T>` or a `GpuSpan<T>` goes where the kernel takes `[T]`, and `mut buf` or a
/// `GpuSpanMut<T>` where it takes `mut Slots<T>`.
///
/// ```wrela
/// use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}
///
/// @compute(64)
/// fn fill(value: f32, out: mut Slots<f32>, id: GlobalId) {
///     out[id] = value
/// }
///
/// var out: GpuBuffer<f32> = buffer(64)
/// dispatch(fill.bind(0.5, mut out), groups: 1)
/// ```
@intrinsic
pub fn dispatch() {}

/// Records a draw into an open pass: `draw(pass, vs.bind(...), fs.bind(...), vertices: n)`,
/// with `instances: m`, or `indirect: buf` for both counts. The pass is the value its `begin_`
/// function gave (or a parameter bounded by `RenderPass`): its type says what the draw draws
/// into, so the pipeline is made at load for each kind of pass it's drawn in, and a fragment
/// shader's output the pass can't take is an error where it's drawn. Each shader is bound to
/// its own arguments, as `dispatch`'s kernel is; one that takes nothing is named alone.
///
/// `indices: buf` (a `GpuBuffer<u32>` or a `GpuSpan<u32>`) draws indexed: with `indirect:`
/// holding the index count, the instance count, the first index, the base vertex and the first
/// instance, or directly, with `index_count:` (all of `indices` past `first_index:`, if not
/// given), `instances:`, `first_index:`, `base_vertex:` (an `i32`) and `first_instance:` (each
/// 0, or 1 instance, if not given): a static mesh needs no arguments buffer. `blend:` (a
/// `Blend`, `Replace` if not given, or `Over` for a shader returning `Over`) says how its
/// colour meets its target's; `blends:` (a `[Blend; N]`) sets each target's of a pass of
/// several. `cull:` (a `Cull`, `Cull::None` if not given), `depth_bias:` (a `DepthBias`,
/// none if not given) and `depth:` (a `Depth`: the nearest fragment kept, if not given) are
/// part of the draw's pipeline, so they're build-time constants, written out where it draws.
///
/// ```wrela
/// use std::gpu::{
///     ClipPosition, Compare, Cull, Depth, DepthBias, DepthPass, GpuBuffer, Rgba8, VertexIndex,
///     draw,
/// }
///
/// @vertex
/// fn corner(points: [vec2], i: VertexIndex) -> ClipPosition {
///     ClipPosition { position: vec4(points[i.index].x, points[i.index].y, 0.5, 1.0) }
/// }
///
/// @fragment
/// fn white() -> vec4 {
///     vec4(1.0, 1.0, 1.0, 1.0)
/// }
///
/// fn quad(
///     pass: DepthPass<Rgba8>,
///     points: GpuBuffer<vec2>,
///     indices: GpuBuffer<u32>,
///     counts: GpuBuffer<u32>,
/// ) {
///     draw(
///         pass,
///         corner.bind(points),
///         white,
///         indices: indices,
///         indirect: counts,
///         cull: Cull::Back,
///         depth_bias: DepthBias { constant: 4, slope: 2.0, clamp: 0.0 },
///     )
///     // Again where the first drew, with no depth written.
///     draw(
///         pass,
///         corner.bind(points),
///         white,
///         indices: indices,
///         indirect: counts,
///         depth: Depth { compare: Compare::Equal, write: false },
///     )
/// }
/// ```
@intrinsic
pub fn draw() {}

/// Records `count` indirect draws in one command: `draw_multi(pass, vs, fs, indirect: buf,
/// count: n)`, each with its own arguments, one after another in `buf` from where it starts
/// (`DrawArgs`, or with `indices:` `DrawIndexedArgs`), as `draw` takes them. A host with
/// `features().multi_draw_indirect` draws them in one call; another records them one by one,
/// which draws the same: the program is the same either way. A culling kernel writes each
/// draw's arguments (an instance count of 0 draws nothing), so one command draws what's
/// visible of many kinds. The draw state and shaders are `draw`'s.
@intrinsic
pub fn draw_multi() {}

/// Which triangles a draw drops by facing: a triangle whose corners run counter-clockwise on
/// the target faces the front.
pub enum Cull: Copy {
    None,
    Front,
    Back,
}

/// How far a draw moves each fragment's depth, away from the eye for positive values:
/// `constant` steps of the depth format's precision and `slope` times the triangle's depth
/// slope, at most `clamp` in size (no limit when it's 0). A shadow map's pass uses it so a
/// surface doesn't shadow itself.
pub struct DepthBias: Copy {
    pub constant: i32,
    pub slope: f32,
    pub clamp: f32,
}

/// How a draw tests and writes depth, in a pass with a depth target: a fragment is drawn where
/// its depth `compare`s with the target's as it says, and it keeps its depth there if `write`.
/// The default keeps the nearest fragment. A card's shading after its depth prepass draws where
/// the depth is `Equal` and writes none.
pub struct Depth: Copy {
    pub compare: Compare = Compare::Less,
    pub write: bool = true,
}

/// Drops the fragment a fragment shader is shading: it writes no colour and no depth (an alpha
/// test, for leaves and grass cut from cards). Its invocation goes on as a helper, so
/// derivatives stay defined (WGSL's demotion). In a fragment shader only (E0607).
@intrinsic
pub fn discard() {}

/// Starts drawing to the screen, cleared to `clear`. A client's only: a server has no screen.
@client
pub fn begin_screen_pass(clear: vec4) -> ScreenPass {
    begin_screen_pass_command(clear)
    ScreenPass { open: true }
}

@intrinsic
fn begin_screen_pass_command(clear: vec4) {}

/// Ends the screen pass and shows it.
@intrinsic
@client
pub fn present() {}

/// An open pass: what a `draw` draws into (§18). Each kind of pass has it (`Pass<F>`,
/// `DepthPass<F>`, `DepthOnlyPass`, `ScreenPass`, `ScreenDepthPass`, `LayerPass<F>`,
/// `LayerDepthPass<F>`, `DepthLayerPass`, and `Pass2` to `Pass4` with their depth forms), and
/// only they do (an `impl` elsewhere is E0415). A function that draws into whatever pass it's
/// given takes one bounded by it: `fn shade<P: RenderPass>(pass: P, ...)`.
pub trait RenderPass {
    /// Clips the draws after it in the pass to the rectangle of `width` × `height` pixels at
    /// (`x`, `y`), until the pass ends or the next scissor: a draw touches no pixel outside it.
    /// Within the pass's targets (the host checks).
    fn scissor(self, x: u32, y: u32, width: u32, height: u32) {
        scissor_command(x, y, width, height)
    }

    /// Maps the clip space of the draws after it in the pass to the rectangle of `width` ×
    /// `height` pixels at (`x`, `y`), and their depths to `min_depth` to `max_depth`, until the
    /// pass ends or the next viewport: one pass draws several views (a probe's faces in one
    /// atlas, a split screen).
    fn viewport(
        self,
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        min_depth: f32 = 0.0,
        max_depth: f32 = 1.0,
    ) {
        viewport_command(x, y, width, height, min_depth, max_depth)
    }
}

/// An open pass on the screen.
pub struct ScreenPass {
    open: bool,
}

impl ScreenPass {
    /// Ends the pass and shows it.
    pub fn present(self) {
        present()
    }
}

impl RenderPass for ScreenPass {}

// ---- textures, samplers and passes (§18) ------------------------------------------------------

/// How a colour texture stores its texels (§18): each format is a type, which says what a texel
/// is in GPU code (`Texel`). What else textures of it can do is a trait each format has or
/// hasn't: GPU code filters between texels of a `Filtered` format, kernels write a `Storage`
/// one, and passes draw into a `Target` one.
pub trait Format {
    /// A texel, as GPU code reads and writes it.
    type Texel
    /// The command stream's code for the format.
    fn code() -> u32
    /// Its bytes a texel, as CPU code writes texels.
    fn bytes() -> u32
    /// A texel as four channels, as WGSL reads it: those the format lacks 0, and alpha 1. For
    /// code generic over formats: `F::rgba(t.sample(s, uv))` is a `vec4` whatever `F` is.
    fn rgba(t: Self::Texel) -> vec4
    /// A block's side in texels: 4 for a compressed format, whose `bytes` are a block's.
    fn block() -> u32 {
        1
    }
}

/// Formats GPU code can filter between texels of (`sample`, `sample_level`).
pub trait Filtered: Format {}

/// Formats kernels can write (`Texels`; `writable_texture`, `texture3d`).
pub trait Storage: Format {}

/// Formats a pass can draw into (`begin_pass`).
pub trait Target: Format {}

/// Four 8-bit channels, read as floats in [0, 1]: 4 bytes a texel. The screen's format.
pub struct Rgba8 {}

/// Four 16-bit floats: 8 bytes a texel.
pub struct Rgba16Float {}

/// One 16-bit float: 2 bytes a texel. Kernels can't write it (WebGPU's core formats).
pub struct R16Float {}

/// Two 16-bit floats: 4 bytes a texel. Kernels can't write it.
pub struct Rg16Float {}

/// One 32-bit float: 4 bytes a texel. GPU code loads it (`load`) and doesn't filter it
/// (WebGPU's core formats).
pub struct R32Float {}

/// One 32-bit unsigned integer: 4 bytes a texel, loaded whole (`load`), never filtered. Drawn
/// into by a fragment shader that returns a `u32`.
pub struct R32Uint {}

impl Format for Rgba8 {
    type Texel = vec4
    fn code() -> u32 {
        FORMAT_RGBA8UNORM
    }
    fn bytes() -> u32 {
        FORMAT_RGBA8UNORM_BYTES
    }
    fn rgba(t: vec4) -> vec4 {
        t
    }
}

impl Filtered for Rgba8 {}

impl Storage for Rgba8 {}

impl Target for Rgba8 {}

impl Format for Rgba16Float {
    type Texel = vec4
    fn code() -> u32 {
        FORMAT_RGBA16FLOAT
    }
    fn bytes() -> u32 {
        FORMAT_RGBA16FLOAT_BYTES
    }
    fn rgba(t: vec4) -> vec4 {
        t
    }
}

impl Filtered for Rgba16Float {}

impl Storage for Rgba16Float {}

impl Target for Rgba16Float {}

impl Format for R16Float {
    type Texel = f32
    fn code() -> u32 {
        FORMAT_R16FLOAT
    }
    fn bytes() -> u32 {
        FORMAT_R16FLOAT_BYTES
    }
    fn rgba(t: f32) -> vec4 {
        vec4(t, 0.0, 0.0, 1.0)
    }
}

impl Filtered for R16Float {}

impl Target for R16Float {}

impl Format for Rg16Float {
    type Texel = vec2
    fn code() -> u32 {
        FORMAT_RG16FLOAT
    }
    fn bytes() -> u32 {
        FORMAT_RG16FLOAT_BYTES
    }
    fn rgba(t: vec2) -> vec4 {
        vec4(t, 0.0, 1.0)
    }
}

impl Filtered for Rg16Float {}

impl Target for Rg16Float {}

impl Format for R32Float {
    type Texel = f32
    fn code() -> u32 {
        FORMAT_R32FLOAT
    }
    fn bytes() -> u32 {
        FORMAT_R32FLOAT_BYTES
    }
    fn rgba(t: f32) -> vec4 {
        vec4(t, 0.0, 0.0, 1.0)
    }
}

impl Storage for R32Float {}

impl Target for R32Float {}

impl Format for R32Uint {
