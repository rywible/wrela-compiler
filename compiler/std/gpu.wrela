/// A 2D colour texture on the GPU, its texels of format `F`: an owned value, like a
/// `GpuBuffer`. CPU code makes one, writes texels into it, draws into it in a pass and passes
/// it to shaders, which read it. Dropping it releases it. It has `levels` mip levels, each half
/// the size of the one before (at least 1 texel): level 0 is the whole texture.
pub struct Texture<F: Format> {
    // The compiler binds a texture by its handle, the first field.
    handle: u32,
    width: u32,
    height: u32,
    levels: u32,
}

impl<F: Format> Drop for Texture<F> {
    fn drop(mut self) {
        if self.handle != 0 {
            drop_texture(
                self.handle,
                texture_bytes(self.width, self.height, 1, self.levels, F::bytes(), F::block()),
            )
        }
    }
}

/// A 2D texture of depths (32-bit floats): a pass's depth target, which shaders read with a
/// `ComparisonSampler` or `load`.
pub struct DepthTexture {
    handle: u32,
    width: u32,
    height: u32,
}

impl Drop for DepthTexture {
    fn drop(mut self) {
        if self.handle != 0 {
            drop_texture(
                self.handle,
                texture_bytes(
                    width: self.width,
                    height: self.height,
                    layers: 1,
                    levels: 1,
                    bytes: FORMAT_DEPTH32FLOAT_BYTES,
                    block: 1,
                ),
            )
        }
    }
}

/// A 3D colour texture on the GPU, its texels of format `F` (a `Storage` one): an owned value,
/// like a `Texture`. CPU code makes one and passes it to kernels, which write its texels
/// (`Texels3d`), and to shaders, which read it. Dropping it releases it.
pub struct Texture3d<F: Storage> {
    handle: u32,
    width: u32,
    height: u32,
    depth: u32,
}

impl<F: Storage> Drop for Texture3d<F> {
    fn drop(mut self) {
        if self.handle != 0 {
            drop_texture(
                self.handle,
                texture_bytes(self.width, self.height, self.depth, 1, F::bytes(), F::block()),
            )
        }
    }
}

/// `layers` 2D colour textures of one size and format, each with `levels` mip levels: shaders
/// sample one by its layer (`sample(s, uv, layer)`), so one binding holds many (a forest's
/// kinds of leaf, a light's shadow cascades). A layer is a 2D texture of its own to a pass
/// (`begin_layer_pass`), a kernel (`layer_mut(i)` for a `Texels<F>`) or a shader
/// (`layer(i)` for a `Texture<F>`). Dropping it releases it.
pub struct TextureArray<F: Format> {
    handle: u32,
    width: u32,
    height: u32,
    layers: u32,
    levels: u32,
}

impl<F: Format> Drop for TextureArray<F> {
    fn drop(mut self) {
        if self.handle != 0 {
            drop_texture(
                self.handle,
                texture_bytes(
                    self.width,
                    self.height,
                    self.layers,
                    self.levels,
                    F::bytes(),
                    F::block(),
                ),
            )
        }
    }
}

/// Six square colour textures, the faces of a cube (+x, -x, +y, -y, +z, -z, WebGPU's order),
/// sampled by direction (`sample(s, dir)`): an environment, a reflection probe. Each face is a
/// layer of its array: drawn into with `begin_face_pass`, written by a kernel through
/// `face_mut(i)`. Dropping it releases it.
pub struct Cubemap<F: Format> {
    // The compiler binds a cube by its array's handle.
    array: TextureArray<F>,
}

/// `layers` depth textures of one size: shadow cascades in one binding, each a layer a depth
/// pass draws into (`begin_depth_layer_pass`) and a shader compares against by its layer.
pub struct DepthTextureArray {
    handle: u32,
    width: u32,
    height: u32,
    layers: u32,
}

impl Drop for DepthTextureArray {
    fn drop(mut self) {
        if self.handle != 0 {
            drop_texture(
                self.handle,
                texture_bytes(
                    width: self.width,
                    height: self.height,
                    layers: self.layers,
                    levels: 1,
                    bytes: FORMAT_DEPTH32FLOAT_BYTES,
                    block: 1,
                ),
            )
        }
    }
}

/// One mip level of a texture, to read: what a shader taking a `Texture<F>` sees as a texture
/// of one level (its level 0 is this one). It borrows its texture.
pub borrow struct TextureLevel<F: Format> {
    pub texture: borrow Texture<F>,
    pub level: u32,
}

/// One mip level of a texture, to write: a kernel's `Texels<F>` (`writable_texture`'s), or a
/// copy's destination. It borrows its texture mutably.
pub borrow struct TextureLevelMut<F: Format> {
    pub texture: mut Texture<F>,
    pub level: u32,
}

/// One layer of an array (or a cube's face), to read, all its levels: what a shader taking a
/// `Texture<F>` sees as a 2D texture.
pub borrow struct TextureLayer<F: Format> {
    pub array: borrow TextureArray<F>,
    pub layer: u32,
}

/// One level of one layer of an array (or a cube's face), to write: a kernel's `Texels<F>`.
pub borrow struct TextureLayerMut<F: Format> {
    pub array: mut TextureArray<F>,
    pub layer: u32,
    pub level: u32,
}

/// Level `level` of a texture to write, and the level before it to read: a kernel's
/// `MipStep<F>`, which makes a mip chain one level at a time (`generate_mips`, a depth
/// pyramid, a bloom chain). Two levels of one texture bound together don't overlap (WebGPU
/// tracks each level apart), so one dispatch reads one and writes the other.
pub borrow struct TextureStep<F: Storage> {
    pub texture: mut Texture<F>,
    pub level: u32,
}

/// The most mip levels a `width` × `height` texture has: its whole chain, down to 1 × 1.
pub fn mip_levels(width: u32, height: u32) -> u32 {
    var n = 1
    var side = max(width, height)
    while side > 1 {
        side = side / 2
        n += 1
    }
    n
}

/// How a `Sampler` filters.
pub enum Filter: Copy {
    /// The nearest texel.
    Nearest,
    /// A blend of the four nearest texels.
    Linear,
}

/// What a `Sampler` does with coordinates outside [0, 1].
pub enum Address: Copy {
    /// The edge texels continue.
    Clamp,
    /// The texture tiles.
    Repeat,
}

/// How two depths compare: a comparison sampler's test (a texel passes when the reference depth
/// is less than it, and so on), and a draw's depth test (a fragment passes when its depth is
/// less than the target's, and so on). `Always` passes every one, and `Never` none.
pub enum Compare: Copy {
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    Equal,
    NotEqual,
    Always,
    Never,
}

/// How shaders read a `Texture` between its texels.
pub struct Sampler {
    handle: u32,
}

impl Drop for Sampler {
    fn drop(mut self) {
        if self.handle != 0 {
            destroy_sampler(self.handle)
        }
    }
}

/// How shaders compare a reference depth with a `DepthTexture`'s texels (shadow maps).
pub struct ComparisonSampler {
    handle: u32,
}

impl Drop for ComparisonSampler {
    fn drop(mut self) {
        if self.handle != 0 {
            destroy_sampler(self.handle)
        }
    }
}

/// A side is 1 texel to the GPU's limit (`limits().max_texture_size`, at least 8192), and a
/// texture has 1 to its chain's levels.
fn check_texture_size(width: u32, height: u32, levels: u32) {
    let max = limit(0)
    if width == 0 || height == 0 || width > max || height > max {
        panic(f"texture: a side is 1 to {max} texels")
    }
    let most = mip_levels(width, height)
    if levels == 0 || levels > most {
        panic(f"texture: a {width}x{height} texture has 1 to {most} mip levels")
    }
}

/// A new colour texture of format `F`, zeroed: `texture::<Rgba8>(width: 4, height: 4)`, or
/// with `F` from where it goes; with `levels` mip levels (`mip_levels(w, h)` for the whole
/// chain), which `generate_mips` fills, or a kernel or a pass each.
pub fn texture<F: Format>(width: u32, height: u32, levels: u32 = 1) -> Texture<F> {
    check_texture_size(width, height, levels)
    let handle = create_texture_of(
        width,
        height,
        F::code(),
        KIND_2D,
        1,
        levels,
        F::bytes(),
        F::block(),
    )
    Texture { handle, width, height, levels }
}

/// A new colour texture of format `F`, zeroed, that kernels can also write (a `Texels`): a
/// `Storage` format. Storage can cost a drawn texture its compression, so only textures kernels
/// write are made this way.
pub fn writable_texture<F: Storage>(width: u32, height: u32, levels: u32 = 1) -> Texture<F> {
    check_texture_size(width, height, levels)
    let code = F::code() | TEXTURE_WRITABLE
    Texture {
        handle: create_texture_of(width, height, code, KIND_2D, 1, levels, F::bytes(), F::block()),
        width,
        height,
        levels,
    }
}

/// A new 3D texture of format `F`, `width` × `height` × `depth` texels (each 1 to 2048),
/// zeroed. Kernels write its texels (`Texels3d`): CPU code can't.
pub fn texture3d<F: Storage>(width: u32, height: u32, depth: u32) -> Texture3d<F> {
    let max = MAX_TEXTURE_3D
    if width == 0 || height == 0 || depth == 0 || width > max || height > max || depth > max {
        panic(f"texture3d: a side is 1 to {max} texels")
    }
    let code = F::code() | TEXTURE_WRITABLE
    Texture3d {
        handle: create_texture_of(width, height, code, KIND_3D, depth, 1, F::bytes(), F::block()),
        width,
        height,
        depth,
    }
}

/// A new array of `layers` colour textures (1 to 256) of format `F`, zeroed, each with `levels`
/// mip levels.
pub fn texture_array<F: Format>(
    width: u32,
    height: u32,
    layers: u32,
    levels: u32 = 1,
) -> TextureArray<F> {
    check_texture_size(width, height, levels)
    check_layers(layers)
    let handle = create_texture_of(
        width,
        height,
        F::code(),
        KIND_ARRAY,
        layers,
        levels,
        F::bytes(),
        F::block(),
    )
    TextureArray { handle, width, height, layers, levels }
}

/// A new array of colour textures, zeroed, whose layers kernels can also write.
pub fn writable_texture_array<F: Storage>(
    width: u32,
    height: u32,
    layers: u32,
    levels: u32 = 1,
) -> TextureArray<F> {
    check_texture_size(width, height, levels)
    check_layers(layers)
    let code = F::code() | TEXTURE_WRITABLE
    let handle = create_texture_of(
        width,
        height,
        code,
        KIND_ARRAY,
        layers,
        levels,
        F::bytes(),
        F::block(),
    )
    TextureArray { handle, width, height, layers, levels }
}

fn check_layers(layers: u32) {
    if layers == 0 || layers > MAX_LAYERS {
        panic(f"texture_array: an array has 1 to {MAX_LAYERS} layers")
    }
}

/// A new cube of six `side` × `side` faces of format `F`, zeroed, each with `levels` levels.
pub fn cubemap<F: Format>(side: u32, levels: u32 = 1) -> Cubemap<F> {
    check_texture_size(side, side, levels)
    let handle = create_texture_of(
        side,
        side,
        F::code(),
        KIND_CUBE,
        6,
        levels,
        F::bytes(),
        F::block(),
    )
    Cubemap { array: TextureArray { handle, width: side, height: side, layers: 6, levels } }
}

/// A new cube whose faces kernels can also write.
pub fn writable_cubemap<F: Storage>(side: u32, levels: u32 = 1) -> Cubemap<F> {
    check_texture_size(side, side, levels)
    let code = F::code() | TEXTURE_WRITABLE
    let handle = create_texture_of(side, side, code, KIND_CUBE, 6, levels, F::bytes(), F::block())
    Cubemap { array: TextureArray { handle, width: side, height: side, layers: 6, levels } }
}

/// A new depth texture, zeroed.
pub fn depth_texture(width: u32, height: u32) -> DepthTexture {
    check_texture_size(width, height, 1)
    let handle = create_texture_of(
        width,
        height,
        format: FORMAT_DEPTH32FLOAT,
        kind: KIND_2D,
        layers: 1,
        levels: 1,
        bytes: FORMAT_DEPTH32FLOAT_BYTES,
        block: 1,
    )
    DepthTexture { handle, width, height }
}

/// A new array of `layers` depth textures, zeroed.
pub fn depth_texture_array(width: u32, height: u32, layers: u32) -> DepthTextureArray {
    check_texture_size(width, height, 1)
    check_layers(layers)
    let handle = create_texture_of(
        width,
        height,
        format: FORMAT_DEPTH32FLOAT,
        kind: KIND_ARRAY,
        layers: layers,
        levels: 1,
        bytes: FORMAT_DEPTH32FLOAT_BYTES,
        block: 1,
    )
    DepthTextureArray { handle, width, height, layers }
}

/// A new sampler: `filter` within a level, `mip` between levels, and with `anisotropy` above 1
/// (to 16) more texels along a surface seen at a slant, which needs both linear (WebGPU's rule).
pub fn sampler(
    filter: Filter = Filter::Linear,
    address: Address = Address::Clamp,
    mip: Filter = Filter::Linear,
    anisotropy: u32 = 1,
) -> Sampler {
    let linear: u32 = match filter {
        Filter::Nearest => 0,
        Filter::Linear => 1,
    }
    let repeat: u32 = match address {
        Address::Clamp => 0,
        Address::Repeat => 1,
    }
    let mip_linear: u32 = match mip {
        Filter::Nearest => 0,
        Filter::Linear => 1,
    }
    if anisotropy == 0 || anisotropy > 16 {
        panic("sampler: anisotropy is 1 to 16")
    }
    if anisotropy > 1 && (linear == 0 || mip_linear == 0) {
        panic("sampler: an anisotropic sampler filters linearly, within and between levels")
    }
    Sampler {
        handle: create_sampler(
            linear,
            repeat,
            compare: 0,
            mip_linear: mip_linear,
            anisotropy: anisotropy,
        ),
    }
}

/// A new comparison sampler: linear, so each comparison blends four texels' results.
pub fn comparison_sampler(compare: Compare = Compare::LessEqual) -> ComparisonSampler {
    let code: u32 = match compare {
        Compare::Less => COMPARE_LESS,
        Compare::LessEqual => COMPARE_LESS_EQUAL,
        Compare::Greater => COMPARE_GREATER,
        Compare::GreaterEqual => COMPARE_GREATER_EQUAL,
        Compare::Equal => COMPARE_EQUAL,
        Compare::NotEqual => COMPARE_NOT_EQUAL,
        Compare::Always => COMPARE_ALWAYS,
        Compare::Never => COMPARE_NEVER,
    }
    ComparisonSampler {
        handle: create_sampler(linear: 1, repeat: 0, compare: code, mip_linear: 0, anisotropy: 1),
    }
}

/// The most bytes one texture write command carries: writes are split into rows that fit.
const TEXTURE_WRITE_BYTES: u32 = 512 * 1024

/// The side of a level: `side` halved `level` times, at least 1.
fn level_side(side: u32, level: u32) -> u32 {
    max(1, side >> level)
}

/// Writes `bytes` (rows top to bottom, `row` bytes each: a row of texels, or of a compressed
/// format's `block` × `block` blocks) into the rectangle of level `level`, layer `layer` of
/// texture `handle`, whose level is `w` × `h`.
fn write_rows(
    handle: u32,
    w: u32,
    h: u32,
    level: u32,
    layer: u32,
    x: u32,
    y: u32,
    width: u32,
    height: u32,
    bytes: [u8],
    row: u32,
    block: u32,
) {
    if x > w || width > w - x || y > h || height > h - y {
        panic("write: the rectangle runs past the texture's edge")
    }
    let rows = blocks(height, block)
    if bytes.len() != row * rows {
        panic(
            "write: the bytes aren't the rectangle's texels (rows of blocks, for a compressed format)",
        )
    }
    if row == 0 || height == 0 {
        return
    }
    let fit = max(1, TEXTURE_WRITE_BYTES / row)
    var done = 0
    while done < rows {
        let n = min(fit, rows - done)
        // In texels: a block's rows, but at the rectangle's last, which may be short.
        let texel_rows = min(n * block, height - done * block)
        write_texture_rows(
            handle,
            level,
            layer,
            x,
            y + done * block,
            width,
            texel_rows,
            bytes,
            done * row,
            n * row,
        )
        done += n
    }
}

impl<F: Format> Texture<F> {
    /// Its width in texels: in GPU code, its level 0's (a level's binding is a texture of its
    /// own size).
    pub fn width(self) -> u32 {
        texture_width(self)
    }

    /// Its height in texels.
    pub fn height(self) -> u32 {
        texture_height(self)
    }

    /// How many mip levels it has: in GPU code too (a level's binding has 1).
    pub fn levels(self) -> u32 {
        texture_levels(self)
    }

    /// Copies texels into the rectangle at (`x`, `y`) of `width` by `height` texels of level
    /// `level`: `bytes` holds its rows, top to bottom, `F::bytes()` a texel. It happens in
    /// recorded order with dispatches and draws. A rectangle past the level's edge, or the wrong
    /// number of bytes, panics.
    pub fn write(mut self, x: u32, y: u32, width: u32, height: u32, bytes: [u8], level: u32 = 0) {
        if level >= self.levels {
            panic("write: the texture has no such level")
        }
        let (w, h) = (level_side(self.width, level), level_side(self.height, level))
        let row = blocks(width, F::block()) * F::bytes()
        write_rows(self.handle, w, h, level, 0, x, y, width, height, bytes, row, F::block())
    }

    /// The texel at (`x`, `y`) of level `level`, unfiltered: any GPU code.
    pub fn load(self, x: u32, y: u32, level: u32 = 0) -> F::Texel {
        texture_load(self, x, y, level)
    }

    /// Level `i` alone, to read: a `Texture<F>` of one level to a shader. It borrows the texture.
    pub fn level(self, i: u32) -> TextureLevel<F> {
        if i >= self.levels {
            panic("level: the texture has no such level")
        }
        TextureLevel { texture: self, level: i }
    }

    /// Level `i` alone, to write: a kernel's `Texels<F>`, or a copy's destination.
    pub fn level_mut(mut self, i: u32) -> TextureLevelMut<F> {
        if i >= self.levels {
            panic("level_mut: the texture has no such level")
        }
        TextureLevelMut { texture: mut self, level: i }
    }
}

impl<F: Storage> Texture<F> {
    /// Level `i` to write and level `i - 1` to read, for a kernel's `MipStep<F>`: from level 1.
    pub fn mip_step(mut self, i: u32) -> TextureStep<F> {
        if i == 0 || i >= self.levels {
            panic("mip_step: a step writes a level from 1 to the last")
        }
        TextureStep { texture: mut self, level: i }
    }
}

impl<F: Filtered> Texture<F> {
    /// The texel at (`u`, `v`) in [0, 1], filtered by `s` and at the level its footprint picks
    /// (trilinear between levels with a sampler whose `mip` is linear): fragment shaders only,
    /// since it reads the footprint from neighbouring pixels (as `dpdx` does).
    pub fn sample(self, s: Sampler, uv: vec2) -> F::Texel {
        texture_sample(self, s, uv)
    }

    /// The texel at (`u`, `v`) in [0, 1] of mip level `level` (between levels, by `s`'s `mip`
    /// filter, at a fraction), filtered by `s`: any GPU code.
    pub fn sample_level(self, s: Sampler, uv: vec2, level: f32 = 0.0) -> F::Texel {
        texture_sample_level(self, s, uv, level)
    }

    /// The texel at (`u`, `v`), at the level the footprint `ddx` and `ddy` (how `uv` changes
    /// from one pixel to the next, across and down) picks: any GPU code, so a kernel or a
    /// vertex shader filters as a fragment shader does.
    pub fn sample_grad(self, s: Sampler, uv: vec2, ddx: vec2, ddy: vec2) -> F::Texel {
        texture_sample_grad(self, s, uv, ddx, ddy)
    }

    /// The texel at (`u`, `v`), at the level the footprint picks moved by `bias`: fragment
    /// shaders only.
    pub fn sample_bias(self, s: Sampler, uv: vec2, bias: f32) -> F::Texel {
        texture_sample_bias(self, s, uv, bias)
    }
}

impl<F: Format> TextureLevel<F> {
    /// Its width in texels.
    pub fn width(self) -> u32 {
        level_side(self.texture.width, self.level)
    }

    /// Its height in texels.
    pub fn height(self) -> u32 {
        level_side(self.texture.height, self.level)
    }
}

impl<F: Format> TextureLevelMut<F> {
    /// Its width in texels.
    pub fn width(self) -> u32 {
        level_side(self.texture.width, self.level)
    }

    /// Its height in texels.
    pub fn height(self) -> u32 {
        level_side(self.texture.height, self.level)
    }
}

impl<F: Format> TextureArray<F> {
    /// Its width in texels. In GPU code too.
    pub fn width(self) -> u32 {
        texture_width(self)
    }

    /// Its height in texels. In GPU code too.
    pub fn height(self) -> u32 {
        texture_height(self)
    }

    /// How many layers it has. In GPU code too.
    pub fn layers(self) -> u32 {
        texture_layers(self)
    }

    /// How many mip levels each layer has. In GPU code too.
    pub fn levels(self) -> u32 {
        texture_levels(self)
    }

    /// Copies texels into a rectangle of layer `layer`'s level `level`, as `Texture::write`.
    pub fn write(
        mut self,
        layer: u32,
        x: u32,
        y: u32,
        width: u32,
        height: u32,
        bytes: [u8],
        level: u32 = 0,
    ) {
        if layer >= self.layers || level >= self.levels {
            panic("write: the array has no such layer or level")
        }
        let (w, h) = (level_side(self.width, level), level_side(self.height, level))
        let row = blocks(width, F::block()) * F::bytes()
        write_rows(self.handle, w, h, level, layer, x, y, width, height, bytes, row, F::block())
    }

    /// The texel at (`x`, `y`) of layer `layer`'s level `level`, unfiltered: any GPU code.
    pub fn load(self, x: u32, y: u32, layer: u32, level: u32 = 0) -> F::Texel {
        array_load(self, x, y, layer, level)
    }

    /// Layer `i`, all its levels, to read: a `Texture<F>` to a shader.
    pub fn layer(self, i: u32) -> TextureLayer<F> {
        if i >= self.layers {
            panic("layer: the array has no such layer")
        }
        TextureLayer { array: self, layer: i }
    }

    /// Layer `i`'s level `level`, to write: a kernel's `Texels<F>`.
    pub fn layer_mut(mut self, i: u32, level: u32 = 0) -> TextureLayerMut<F> {
        if i >= self.layers || level >= self.levels {
            panic("layer_mut: the array has no such layer or level")
        }
        TextureLayerMut { array: mut self, layer: i, level }
    }
}

impl<F: Filtered> TextureArray<F> {
    /// Layer `layer`'s texel at (`u`, `v`), filtered: fragment shaders only.
    pub fn sample(self, s: Sampler, uv: vec2, layer: u32) -> F::Texel {
        array_sample(self, s, uv, layer)
    }

    /// Layer `layer`'s texel at (`u`, `v`) of mip level `level`: any GPU code.
    pub fn sample_level(self, s: Sampler, uv: vec2, layer: u32, level: f32 = 0.0) -> F::Texel {
        array_sample_level(self, s, uv, layer, level)
    }

    /// Layer `layer`'s texel at (`u`, `v`), at the level the footprint picks: any GPU code.
    pub fn sample_grad(self, s: Sampler, uv: vec2, layer: u32, ddx: vec2, ddy: vec2) -> F::Texel {
        array_sample_grad(self, s, uv, layer, ddx, ddy)
    }
}

impl<F: Format> Cubemap<F> {
    /// A face's side in texels.
    pub fn side(self) -> u32 {
        self.array.width
    }

    /// How many mip levels each face has.
    pub fn levels(self) -> u32 {
        self.array.levels
    }

    /// Face `i` (+x, -x, +y, -y, +z, -z), all its levels, to read.
    pub fn face(self, i: u32) -> TextureLayer<F> {
        self.array.layer(i)
    }

    /// Face `i`'s level `level`, to write: a kernel's `Texels<F>`.
    pub fn face_mut(mut self, i: u32, level: u32 = 0) -> TextureLayerMut<F> {
        self.array.layer_mut(i, level)
    }

    /// Copies texels into a rectangle of face `face`'s level `level`.
    pub fn write(
        mut self,
        face: u32,
        x: u32,
        y: u32,
        width: u32,
        height: u32,
        bytes: [u8],
        level: u32 = 0,
    ) {
        self.array.write(face, x, y, width, height, bytes, level)
    }
}

impl<F: Filtered> Cubemap<F> {
    /// The texel the direction `dir` from the cube's centre meets, filtered: fragment shaders
    /// only.
    pub fn sample(self, s: Sampler, dir: vec3) -> F::Texel {
        cube_sample(self, s, dir)
    }

    /// As `sample`, at mip level `level`: any GPU code (a probe's roughness picks its level).
    pub fn sample_level(self, s: Sampler, dir: vec3, level: f32 = 0.0) -> F::Texel {
        cube_sample_level(self, s, dir, level)
    }
}

impl DepthTexture {
    /// Its width in texels. In GPU code too.
    pub fn width(self) -> u32 {
        texture_width(self)
    }

    /// Its height in texels. In GPU code too.
    pub fn height(self) -> u32 {
        texture_height(self)
    }

    /// The fraction of the texels around (`u`, `v`) in [0, 1] that pass `s`'s test against
    /// `reference`: fragment shaders only.
    pub fn sample_compare(self, s: ComparisonSampler, uv: vec2, reference: f32) -> f32 {
        texture_sample_compare(self, s, uv, reference)
    }

    /// As `sample_compare`, at level 0: any GPU code.
    pub fn sample_compare_level(self, s: ComparisonSampler, uv: vec2, reference: f32) -> f32 {
        texture_sample_compare_level(self, s, uv, reference)
    }

    /// The depth at (`x`, `y`): any GPU code.
    pub fn load(self, x: u32, y: u32) -> f32 {
        depth_load(self, x, y, 0)
    }
}

impl DepthTextureArray {
    /// Its width in texels. In GPU code too.
    pub fn width(self) -> u32 {
        texture_width(self)
    }

    /// Its height in texels. In GPU code too.
    pub fn height(self) -> u32 {
        texture_height(self)
    }

    /// How many layers it has. In GPU code too.
    pub fn layers(self) -> u32 {
        texture_layers(self)
    }

    /// The fraction of layer `layer`'s texels around (`u`, `v`) that pass `s`'s test against
    /// `reference`: fragment shaders only.
    pub fn sample_compare(self, s: ComparisonSampler, uv: vec2, layer: u32, reference: f32) -> f32 {
        depth_array_compare(self, s, uv, layer, reference)
    }

    /// As `sample_compare`, at level 0: any GPU code.
    pub fn sample_compare_level(
        self,
        s: ComparisonSampler,
        uv: vec2,
        layer: u32,
        reference: f32,
    ) -> f32 {
        depth_array_compare_level(self, s, uv, layer, reference)
    }

    /// Layer `layer`'s depth at (`x`, `y`): any GPU code.
    pub fn load(self, x: u32, y: u32, layer: u32) -> f32 {
        depth_array_load(self, x, y, layer, 0)
    }
}

impl<F: Storage> Texture3d<F> {
    /// Its width in texels. In GPU code too.
    pub fn width(self) -> u32 {
        texture_width(self)
    }

    /// Its height in texels. In GPU code too.
    pub fn height(self) -> u32 {
        texture_height(self)
    }

    /// Its depth in texels. In GPU code too.
    pub fn depth(self) -> u32 {
        texture_depth(self)
    }

    /// The texel at (`x`, `y`, `z`), unfiltered: any GPU code.
    pub fn load(self, x: u32, y: u32, z: u32) -> F::Texel {
        texture3d_load(self, x, y, z, 0)
    }
}

impl<F: Storage + Filtered> Texture3d<F> {
    /// The texel at (`u`, `v`, `w`) in [0, 1], filtered by `s`: any GPU code. 3D textures have
    /// one mip level, 0.
    pub fn sample_level(self, s: Sampler, uvw: vec3, level: f32 = 0.0) -> F::Texel {
        texture3d_sample_level(self, s, uvw, level)
    }
}

// ---- copies and readback (§18.8) ---------------------------------------------------------------

/// Copies a `width` × `height` rectangle at (`x`, `y`) of `from` into `to` at (`to_x`, `to_y`),
/// in recorded order with dispatches and draws: two textures of one format, each at the level
/// it names (`tex.level(i)`, `other.level_mut(j)`), or whole (level 0). A rectangle past either
/// level's edge panics.
pub fn copy_texture<F: Format, S: TexelSource<F>, T: TexelTarget<F>>(
    from: S,
    to: T,
    x: u32 = 0,
    y: u32 = 0,
    width: u32 = 0,
    height: u32 = 0,
    to_x: u32 = 0,
    to_y: u32 = 0,
) {
    let (a, b) = (from.source(), to.target())
    let w = if width == 0 { a.width } else { width }
    let h = if height == 0 { a.height } else { height }
    if x > a.width || w > a.width - x || y > a.height || h > a.height - y {
        panic("copy_texture: the rectangle runs past the source's edge")
    }
    if to_x > b.width || w > b.width - to_x || to_y > b.height || h > b.height - to_y {
        panic("copy_texture: the rectangle runs past the destination's edge")
    }
    copy_texture_command(
        from: a.handle,
        from_level: a.level,
        from_layer: a.layer,
        x: x,
        y: y,
        to: b.handle,
        to_level: b.level,
        to_layer: b.layer,
        to_x: to_x,
        to_y: to_y,
        width: w,
        height: h,
    )
}

/// Copies a level of a texture into a buffer of its texels, row by row: `to` must hold
/// `rows_of(width) * height` `u32`s, each row padded to 256 bytes (WebGPU's rule); `read_texture`
/// unpads them. In recorded order.
pub fn copy_texture_to_buffer<F: Format, S: TexelSource<F>>(from: S, to: mut GpuBuffer<u32>) {
    let a = from.source()
    let (bw, bh) = (blocks(a.width, F::block()), blocks(a.height, F::block()))
    let row = padded_row(bw * F::bytes())
    if to.len() * 4 < row * bh {
        panic("copy_texture_to_buffer: the buffer is smaller than the texture's padded rows")
    }
    copy_texture_to_buffer_command(
        texture: a.handle,
        level: a.level,
        layer: a.layer,
        x: 0,
        y: 0,
        width: a.width,
        height: a.height,
        buffer: to.handle,
        offset: 0,
        bytes_per_row: row,
    )
}

/// Copies a buffer of texels into a level of a texture, row by row (rows padded to 256 bytes,
/// as `copy_texture_to_buffer` writes them): what a kernel encoded (compressed blocks too, a
/// row of blocks a row) becomes a texture. In recorded order.
pub fn copy_buffer_to_texture<F: Format, T: TexelTarget<F>>(from: GpuSpan<u32>, to: T) {
    let b = to.target()
    let (bw, bh) = (blocks(b.width, F::block()), blocks(b.height, F::block()))
    let row = padded_row(bw * F::bytes())
    if from.count * 4 < row * bh {
        panic("copy_buffer_to_texture: the span is smaller than the texture's padded rows")
    }
    if (from.start * 4) % F::bytes() != 0 {
        panic(
            "copy_buffer_to_texture: the span starts inside a texel block (WebGPU copies whole blocks)",
        )
    }
    copy_buffer_to_texture_command(
        buffer: from.buffer.handle,
        offset: from.start * 4,
        bytes_per_row: row,
        texture: b.handle,
        level: b.level,
        layer: b.layer,
        x: 0,
        y: 0,
        width: b.width,
        height: b.height,
    )
}

/// Where a copy reads texels (`copy_texture`, `copy_texture_to_buffer`, `read_texture`): a level
/// of a texture (`tex.level(i)`), or level 0 of an array's layer or a cube's face
/// (`arr.layer(i)`).
pub trait TexelSource<F: Format> {
    /// The level, the layer and their size.
    fn source(self) -> TexelPlace
}

/// Where a copy writes texels (`copy_texture`, `copy_buffer_to_texture`): a level of a texture
/// (`tex.level_mut(i)`), or a level of an array's layer (`arr.layer_mut(i, level)`).
pub trait TexelTarget<F: Format> {
    /// The level, the layer and their size.
    fn target(self) -> TexelPlace
}

/// One level of one layer of a texture, and its size: what a copy reads or writes.
pub struct TexelPlace: Copy {
    handle: u32,
    level: u32,
    layer: u32,
    width: u32,
    height: u32,
}

impl<F: Format> TexelSource<F> for TextureLevel<F> {
    fn source(self) -> TexelPlace {
        TexelPlace {
            handle: self.texture.handle,
            level: self.level,
            layer: 0,
            width: self.width(),
            height: self.height(),
        }
    }
}

impl<F: Format> TexelSource<F> for TextureLayer<F> {
    fn source(self) -> TexelPlace {
        TexelPlace {
            handle: self.array.handle,
            level: 0,
            layer: self.layer,
            width: self.array.width,
            height: self.array.height,
        }
    }
}

impl<F: Format> TexelTarget<F> for TextureLevelMut<F> {
    fn target(self) -> TexelPlace {
        TexelPlace {
            handle: self.texture.handle,
            level: self.level,
            layer: 0,
            width: self.width(),
            height: self.height(),
        }
    }
}

impl<F: Format> TexelTarget<F> for TextureLayerMut<F> {
    fn target(self) -> TexelPlace {
        TexelPlace {
            handle: self.array.handle,
            level: self.level,
            layer: self.layer,
            width: level_side(self.array.width, self.level),
            height: level_side(self.array.height, self.level),
        }
    }
}

/// `n` texels in blocks of `b`.
fn blocks(n: u32, b: u32) -> u32 {
    (n + b - 1) / b
}

/// A row of `bytes` padded to 256, as a copy between a texture and a buffer lays it out.
fn padded_row(bytes: u32) -> u32 {
    (bytes + 255) / 256 * 256
}

/// Reads a level of a texture back to the CPU, once the GPU work recorded before is done: its
/// texels' bytes, rows top to bottom, `F::bytes()` a texel, unpadded. A request, answered on a
/// later call (§17.1), and `nondet` as `read` is. It records a copy into a buffer it makes,
/// which it releases once it's read.
pub fn read_texture<F: Format, S: TexelSource<F>>(from: S) -> TextureRead {
    let a = from.source()
    let (bw, bh) = (blocks(a.width, F::block()), blocks(a.height, F::block()))
    let row = padded_row(bw * F::bytes())
    var staging: GpuBuffer<u32> = buffer(row * bh / 4)
    copy_texture_to_buffer_command(
        texture: a.handle,
        level: a.level,
        layer: a.layer,
        x: 0,
        y: 0,
        width: a.width,
        height: a.height,
        buffer: staging.handle,
        offset: 0,
        bytes_per_row: row,
    )
    let pending = read(staging.items())
    TextureRead { staging, pending, row, packed: bw * F::bytes(), height: bh }
}

/// A texture's texels on their way back to the CPU (`read_texture`).
pub struct TextureRead {
    staging: GpuBuffer<u32>,
    pending: Pending<u32>,
    row: u32,
    packed: u32,
    height: u32,
}

impl TextureRead {
    /// Its texels' bytes, once they've come back: `None` until then, and `Some(Err)` if the read
    /// failed.
    pub fn poll(mut self) -> Option<Result<Vec<u8>, IoError>> {
        match self.pending.poll() {
            None => None,
            Some(Err(e)) => Some(Err(e)),
            Some(Ok(words)) => {
                var out = Vec::with_capacity(self.packed * self.height)
                for y in 0..self.height {
                    for b in 0..self.packed {
                        let at = y * self.row + b
                        out.push(u8((words[at / 4] >> ((at % 4) * 8)) & 255))
                    }
                }
                Some(Ok(out))
            },
        }
    }
}

/// An open pass that draws into a texture: what `begin_pass` gives. It borrows its target until
/// `end()`, so the pass's draws can't bind it.
pub borrow struct Pass<F: Target> {
    pub target: mut Texture<F>,
}

impl<F: Target> Pass<F> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<F: Target> RenderPass for Pass<F> {}

/// An open pass with a colour target and a depth target.
pub borrow struct DepthPass<F: Target> {
    pub target: mut Texture<F>,
    pub depth: mut DepthTexture,
}

impl<F: Target> DepthPass<F> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<F: Target> RenderPass for DepthPass<F> {}

/// An open pass that draws only depths, into its depth target (a shadow map).
pub borrow struct DepthOnlyPass {
    pub depth: mut DepthTexture,
}

impl DepthOnlyPass {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl RenderPass for DepthOnlyPass {}

/// An open pass on the screen with a depth target.
pub borrow struct ScreenDepthPass {
    pub depth: mut DepthTexture,
}

impl ScreenDepthPass {
    /// Ends the pass and shows it.
    pub fn present(self) {
        present()
    }
}

impl RenderPass for ScreenDepthPass {}

/// An open pass that draws into one layer of an array (or a cube's face): `begin_layer_pass`,
/// `begin_face_pass`.
pub borrow struct LayerPass<F: Target> {
    pub target: mut TextureArray<F>,
}

impl<F: Target> LayerPass<F> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<F: Target> RenderPass for LayerPass<F> {}

/// An open pass into one layer of an array (or a cube's face), with a depth target.
pub borrow struct LayerDepthPass<F: Target> {
    pub target: mut TextureArray<F>,
    pub depth: mut DepthTexture,
}

impl<F: Target> LayerDepthPass<F> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<F: Target> RenderPass for LayerDepthPass<F> {}

/// An open pass that draws only depths, into one layer of a depth array (a shadow cascade).
pub borrow struct DepthLayerPass {
    pub depth: mut DepthTextureArray,
}

impl DepthLayerPass {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl RenderPass for DepthLayerPass {}

/// An open pass that draws into two textures at once: its fragment shader returns a
/// `Targets2` of their colours (a G-buffer's, a colour and its motion).
pub borrow struct Pass2<A: Target, B: Target> {
    pub first: mut Texture<A>,
    pub second: mut Texture<B>,
}

/// An open pass into two textures and a depth target.
pub borrow struct DepthPass2<A: Target, B: Target> {
    pub first: mut Texture<A>,
    pub second: mut Texture<B>,
    pub depth: mut DepthTexture,
}

/// An open pass into three textures.
pub borrow struct Pass3<A: Target, B: Target, C: Target> {
    pub first: mut Texture<A>,
    pub second: mut Texture<B>,
    pub third: mut Texture<C>,
}

/// An open pass into three textures and a depth target.
pub borrow struct DepthPass3<A: Target, B: Target, C: Target> {
    pub first: mut Texture<A>,
    pub second: mut Texture<B>,
    pub third: mut Texture<C>,
    pub depth: mut DepthTexture,
}

/// An open pass into four textures.
pub borrow struct Pass4<A: Target, B: Target, C: Target, D: Target> {
    pub first: mut Texture<A>,
    pub second: mut Texture<B>,
    pub third: mut Texture<C>,
    pub fourth: mut Texture<D>,
}

/// An open pass into four textures and a depth target.
pub borrow struct DepthPass4<A: Target, B: Target, C: Target, D: Target> {
    pub first: mut Texture<A>,
    pub second: mut Texture<B>,
    pub third: mut Texture<C>,
    pub fourth: mut Texture<D>,
    pub depth: mut DepthTexture,
}

impl<A: Target, B: Target> Pass2<A, B> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<A: Target, B: Target> DepthPass2<A, B> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<A: Target, B: Target, C: Target> Pass3<A, B, C> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<A: Target, B: Target, C: Target> DepthPass3<A, B, C> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<A: Target, B: Target, C: Target, D: Target> Pass4<A, B, C, D> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<A: Target, B: Target, C: Target, D: Target> DepthPass4<A, B, C, D> {
    /// Ends the pass.
    pub fn end(self) {
        end_pass_command()
    }
}

impl<A: Target, B: Target> RenderPass for Pass2<A, B> {}

impl<A: Target, B: Target> RenderPass for DepthPass2<A, B> {}

impl<A: Target, B: Target, C: Target> RenderPass for Pass3<A, B, C> {}

impl<A: Target, B: Target, C: Target> RenderPass for DepthPass3<A, B, C> {}

impl<A: Target, B: Target, C: Target, D: Target> RenderPass for Pass4<A, B, C, D> {}

impl<A: Target, B: Target, C: Target, D: Target> RenderPass for DepthPass4<A, B, C, D> {}

/// A fragment shader's colours for a pass of two targets (`begin_pass2`), in target order: each
/// a `vec4`, a `vec3`, a `vec2` or an `f32` for a float target, a `u32` or `vec2u` for an
/// integer one, as the target's format takes.
pub struct Targets2<A, B>: Copy {
    pub first: A,
    pub second: B,
}

/// A fragment shader's colours for a pass of three targets.
pub struct Targets3<A, B, C>: Copy {
    pub first: A,
    pub second: B,
    pub third: C,
}

/// A fragment shader's colours for a pass of four targets.
pub struct Targets4<A, B, C, D>: Copy {
    pub first: A,
    pub second: B,
    pub third: C,
    pub fourth: D,
}

/// How a draw's colour meets what's in its target, as WebGPU's blend states define them: part
/// of the draw's pipeline, so a build-time constant (`draw(..., blend: Blend::Add)`).
pub enum Blend: Copy {
    /// It replaces what's there (the default).
    Replace,
    /// Straight alpha over what's there: colour `src × src.a + dst × (1 − src.a)`, alpha
    /// `src.a + dst.a × (1 − src.a)`. What a fragment shader returning `Over` gets.
    Over,
    /// Premultiplied alpha: colour `src + dst × (1 − src.a)`, alpha likewise.
    Premultiplied,
    /// `src + dst`, each channel: light that adds, accumulation.
    Add,
    /// `src × dst`, each channel: what's there darkened, transmittance.
    Multiply,
    /// The least of each channel.
    Min,
    /// The greatest of each channel.
    Max,
}

/// The pass attachment that isn't there.
const NO_TARGET: u32 = 4294967295
/// The pass attachment that is the screen.
const SCREEN_TARGET: u32 = 4294967294

/// Starts a pass that draws into level `level` of `target`: cleared to `clear` (its first
/// channels, for a format of fewer), or keeping what's there.
pub fn begin_pass<F: Target>(
    target: mut Texture<F>,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
    level: u32 = 0,
) -> Pass<F> {
    if level >= target.levels {
        panic("begin_pass: the target has no such level")
    }
    begin_pass1_command(
        count: 1,
        join: 0,
        t0: target.handle,
        level0: level,
        layer0: 0,
        keep0: u32(keep),
        r0: clear.x,
        g0: clear.y,
        b0: clear.z,
        a0: clear.w,
        depth: NO_TARGET,
        depth_layer: 0,
        keep_depth: 0,
        clear_depth: 1.0,
    )
    Pass { target: mut target }
}

/// Starts a pass that draws into level `level` of `target`, keeping each fragment nearer than
/// what `depth` holds. The two must be the same size. Depths are cleared to `clear_depth`, or
/// kept. A pass that keeps both may `join` the pass before it, if that one ended right before it
/// on the same targets: the host may run the two as one (on a tile-based GPU, the targets aren't
/// stored and loaded again between them), which pays when this one is light; its timing alone
/// (the serial mode) is its own.
pub fn begin_pass_with_depth<F: Target>(
    target: mut Texture<F>,
    depth: mut DepthTexture,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
    clear_depth: f32 = 1.0,
    keep_depth: bool = false,
    join: bool = false,
    level: u32 = 0,
) -> DepthPass<F> {
    if level >= target.levels {
        panic("begin_pass_with_depth: the target has no such level")
    }
    let (c, d) = (target.handle, depth.handle)
    begin_pass1_command(
        count: 1,
        join: u32(join),
        t0: c,
        level0: level,
        layer0: 0,
        keep0: u32(keep),
        r0: clear.x,
        g0: clear.y,
        b0: clear.z,
        a0: clear.w,
        depth: d,
        depth_layer: 0,
        keep_depth: u32(keep_depth),
        clear_depth: clear_depth,
    )
    DepthPass { target: mut target, depth: mut depth }
}

/// Starts a pass that draws only depths into `depth` (its draws' fragment colours go nowhere).
pub fn begin_depth_pass(
    depth: mut DepthTexture,
    clear_depth: f32 = 1.0,
    keep_depth: bool = false,
) -> DepthOnlyPass {
    begin_pass0_command(
        count: 0,
        join: 0,
        depth: depth.handle,
        depth_layer: 0,
        keep_depth: u32(keep_depth),
        clear_depth: clear_depth,
    )
    DepthOnlyPass { depth: mut depth }
}

/// Starts a pass that draws only depths into layer `layer` of `depth` (a shadow cascade).
pub fn begin_depth_layer_pass(
    depth: mut DepthTextureArray,
    layer: u32,
    clear_depth: f32 = 1.0,
    keep_depth: bool = false,
) -> DepthLayerPass {
    if layer >= depth.layers {
        panic("begin_depth_layer_pass: the array has no such layer")
    }
    begin_pass0_command(
        count: 0,
        join: 0,
        depth: depth.handle,
        depth_layer: layer,
        keep_depth: u32(keep_depth),
        clear_depth: clear_depth,
    )
    DepthLayerPass { depth: mut depth }
}

/// Starts a pass that draws into level `level` of layer `layer` of `target`.
pub fn begin_layer_pass<F: Target>(
    target: mut TextureArray<F>,
    layer: u32,
    level: u32 = 0,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
) -> LayerPass<F> {
    if layer >= target.layers || level >= target.levels {
        panic("begin_layer_pass: the array has no such layer or level")
    }
    begin_pass1_command(
        count: 1,
        join: 0,
        t0: target.handle,
        level0: level,
        layer0: layer,
        keep0: u32(keep),
        r0: clear.x,
        g0: clear.y,
        b0: clear.z,
        a0: clear.w,
        depth: NO_TARGET,
        depth_layer: 0,
        keep_depth: 0,
        clear_depth: 1.0,
    )
    LayerPass { target: mut target }
}

/// Starts a pass into level `level` of layer `layer` of `target`, with `depth` (its size).
pub fn begin_layer_pass_with_depth<F: Target>(
    target: mut TextureArray<F>,
    layer: u32,
    depth: mut DepthTexture,
    level: u32 = 0,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
    clear_depth: f32 = 1.0,
    keep_depth: bool = false,
) -> LayerDepthPass<F> {
    if layer >= target.layers || level >= target.levels {
        panic("begin_layer_pass_with_depth: the array has no such layer or level")
    }
    let (c, d) = (target.handle, depth.handle)
    begin_pass1_command(
        count: 1,
        join: 0,
        t0: c,
        level0: level,
        layer0: layer,
        keep0: u32(keep),
        r0: clear.x,
        g0: clear.y,
        b0: clear.z,
        a0: clear.w,
        depth: d,
        depth_layer: 0,
        keep_depth: u32(keep_depth),
        clear_depth: clear_depth,
    )
    LayerDepthPass { target: mut target, depth: mut depth }
}

/// Starts a pass that draws into level `level` of face `face` of `target` (+x, -x, +y, -y, +z,
/// -z): a reflection probe's face.
pub fn begin_face_pass<F: Target>(
    target: mut Cubemap<F>,
    face: u32,
    level: u32 = 0,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
) -> LayerPass<F> {
    begin_layer_pass(mut target.array, face, level, clear, keep)
}

/// Starts a pass into level `level` of face `face` of `target`, with `depth` (its size).
pub fn begin_face_pass_with_depth<F: Target>(
    target: mut Cubemap<F>,
    face: u32,
    depth: mut DepthTexture,
    level: u32 = 0,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
    clear_depth: f32 = 1.0,
) -> LayerDepthPass<F> {
    begin_layer_pass_with_depth(mut target.array, face, mut depth, level, clear, keep, clear_depth)
}

/// Starts a pass that draws into two textures at once, each cleared to `clear` or kept. The
/// targets are the same size, and their bytes a texel as attachments are within WebGPU's 32
/// (the compiler counts them, E0602: `rgba16float` costs 8, `rgba32float` 16, `r32uint` 4).
pub fn begin_pass2<A: Target, B: Target>(
    first: mut Texture<A>,
    second: mut Texture<B>,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
) -> Pass2<A, B> {
    let k = u32(keep)
    let (x, y, z, w) = (clear.x, clear.y, clear.z, clear.w)
    begin_pass2_command(
        count: 2,
        join: 0,
        t0: first.handle,
        level0: 0,
        layer0: 0,
        keep0: k,
        r0: x,
        g0: y,
        b0: z,
        a0: w,
        t1: second.handle,
        level1: 0,
        layer1: 0,
        keep1: k,
        r1: x,
        g1: y,
        b1: z,
        a1: w,
        depth: NO_TARGET,
        depth_layer: 0,
        keep_depth: 0,
        clear_depth: 1.0,
    )
    Pass2 { first: mut first, second: mut second }
}

/// Starts a pass into two textures with a depth target.
pub fn begin_pass2_with_depth<A: Target, B: Target>(
    first: mut Texture<A>,
    second: mut Texture<B>,
    depth: mut DepthTexture,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
    clear_depth: f32 = 1.0,
    keep_depth: bool = false,
    join: bool = false,
) -> DepthPass2<A, B> {
    let k = u32(keep)
    let (x, y, z, w) = (clear.x, clear.y, clear.z, clear.w)
    begin_pass2_command(
        count: 2,
        join: u32(join),
        t0: first.handle,
        level0: 0,
        layer0: 0,
        keep0: k,
        r0: x,
        g0: y,
        b0: z,
        a0: w,
        t1: second.handle,
        level1: 0,
        layer1: 0,
        keep1: k,
        r1: x,
        g1: y,
        b1: z,
        a1: w,
        depth: depth.handle,
        depth_layer: 0,
        keep_depth: u32(keep_depth),
        clear_depth: clear_depth,
    )
    DepthPass2 { first: mut first, second: mut second, depth: mut depth }
}

/// Starts a pass that draws into three textures at once.
pub fn begin_pass3<A: Target, B: Target, C: Target>(
    first: mut Texture<A>,
    second: mut Texture<B>,
    third: mut Texture<C>,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
) -> Pass3<A, B, C> {
    let k = u32(keep)
    let (x, y, z, w) = (clear.x, clear.y, clear.z, clear.w)
    begin_pass3_command(
        count: 3,
        join: 0,
        t0: first.handle,
        level0: 0,
        layer0: 0,
        keep0: k,
        r0: x,
        g0: y,
        b0: z,
        a0: w,
        t1: second.handle,
        level1: 0,
        layer1: 0,
        keep1: k,
        r1: x,
        g1: y,
        b1: z,
        a1: w,
        t2: third.handle,
        level2: 0,
        layer2: 0,
        keep2: k,
        r2: x,
        g2: y,
        b2: z,
        a2: w,
        depth: NO_TARGET,
        depth_layer: 0,
        keep_depth: 0,
        clear_depth: 1.0,
    )
    Pass3 { first: mut first, second: mut second, third: mut third }
}

/// Starts a pass into three textures with a depth target.
pub fn begin_pass3_with_depth<A: Target, B: Target, C: Target>(
    first: mut Texture<A>,
    second: mut Texture<B>,
    third: mut Texture<C>,
    depth: mut DepthTexture,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
    clear_depth: f32 = 1.0,
    keep_depth: bool = false,
    join: bool = false,
) -> DepthPass3<A, B, C> {
    let k = u32(keep)
    let (x, y, z, w) = (clear.x, clear.y, clear.z, clear.w)
    begin_pass3_command(
        count: 3,
        join: u32(join),
        t0: first.handle,
        level0: 0,
        layer0: 0,
        keep0: k,
        r0: x,
        g0: y,
        b0: z,
        a0: w,
        t1: second.handle,
        level1: 0,
        layer1: 0,
        keep1: k,
        r1: x,
        g1: y,
        b1: z,
        a1: w,
        t2: third.handle,
        level2: 0,
        layer2: 0,
        keep2: k,
        r2: x,
        g2: y,
        b2: z,
        a2: w,
        depth: depth.handle,
        depth_layer: 0,
        keep_depth: u32(keep_depth),
        clear_depth: clear_depth,
    )
    DepthPass3 { first: mut first, second: mut second, third: mut third, depth: mut depth }
}

/// Starts a pass that draws into four textures at once.
pub fn begin_pass4<A: Target, B: Target, C: Target, D: Target>(
    first: mut Texture<A>,
    second: mut Texture<B>,
    third: mut Texture<C>,
    fourth: mut Texture<D>,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
) -> Pass4<A, B, C, D> {
    let k = u32(keep)
    let (x, y, z, w) = (clear.x, clear.y, clear.z, clear.w)
    begin_pass4_command(
        count: 4,
        join: 0,
        t0: first.handle,
        level0: 0,
        layer0: 0,
        keep0: k,
        r0: x,
        g0: y,
        b0: z,
        a0: w,
        t1: second.handle,
        level1: 0,
        layer1: 0,
        keep1: k,
        r1: x,
        g1: y,
        b1: z,
        a1: w,
        t2: third.handle,
        level2: 0,
        layer2: 0,
        keep2: k,
        r2: x,
        g2: y,
        b2: z,
        a2: w,
        t3: fourth.handle,
        level3: 0,
        layer3: 0,
        keep3: k,
        r3: x,
        g3: y,
        b3: z,
        a3: w,
        depth: NO_TARGET,
        depth_layer: 0,
        keep_depth: 0,
        clear_depth: 1.0,
    )
    Pass4 { first: mut first, second: mut second, third: mut third, fourth: mut fourth }
}

/// Starts a pass into four textures with a depth target.
pub fn begin_pass4_with_depth<A: Target, B: Target, C: Target, D: Target>(
    first: mut Texture<A>,
    second: mut Texture<B>,
    third: mut Texture<C>,
    fourth: mut Texture<D>,
    depth: mut DepthTexture,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    keep: bool = false,
    clear_depth: f32 = 1.0,
    keep_depth: bool = false,
    join: bool = false,
) -> DepthPass4<A, B, C, D> {
    let k = u32(keep)
    let (x, y, z, w) = (clear.x, clear.y, clear.z, clear.w)
    begin_pass4_command(
        count: 4,
        join: u32(join),
        t0: first.handle,
        level0: 0,
        layer0: 0,
        keep0: k,
        r0: x,
        g0: y,
        b0: z,
        a0: w,
        t1: second.handle,
        level1: 0,
        layer1: 0,
        keep1: k,
        r1: x,
        g1: y,
        b1: z,
        a1: w,
        t2: third.handle,
        level2: 0,
        layer2: 0,
        keep2: k,
        r2: x,
        g2: y,
        b2: z,
        a2: w,
        t3: fourth.handle,
        level3: 0,
        layer3: 0,
        keep3: k,
        r3: x,
        g3: y,
        b3: z,
        a3: w,
        depth: depth.handle,
        depth_layer: 0,
        keep_depth: u32(keep_depth),
        clear_depth: clear_depth,
    )
    DepthPass4 {
        first: mut first,
        second: mut second,
        third: mut third,
        fourth: mut fourth,
        depth: mut depth,
    }
}

/// Starts drawing to the screen, cleared to `clear`, with `depth` as its depth target (the
/// screen's size). A client's only.
@client
pub fn begin_screen_pass_with_depth(
    depth: mut DepthTexture,
    clear: vec4 = vec4(0.0, 0.0, 0.0, 1.0),
    clear_depth: f32 = 1.0,
) -> ScreenDepthPass {
    begin_pass1_command(
        count: 1,
        join: 0,
        t0: SCREEN_TARGET,
        level0: 0,
        layer0: 0,
        keep0: 0,
        r0: clear.x,
        g0: clear.y,
        b0: clear.z,
        a0: clear.w,
        depth: depth.handle,
        depth_layer: 0,
        keep_depth: 0,
        clear_depth: clear_depth,
    )
    ScreenDepthPass { depth: mut depth }
}

/// A texture array of format `F` that a kernel writes, each invocation only its own texel:
/// (`id.x`, `id.y`) of layer `id.z` of its `GlobalId`. A kernel's `mut TexelsArray<F>`
/// parameter, for which CPU code passes `mut arr` of a `TextureArray<F>` made by
/// `writable_texture_array` (its first level of every layer).
pub struct TexelsArray<F: Storage> {
    unused: u32,
}

impl<F: Storage> TexelsArray<F> {
    /// Writes `value` to the invocation's own texel, (`id.x`, `id.y`) of layer `id.z`.
    pub fn store(mut self, id: GlobalId, value: F::Texel) {
        texels_array_store(mut self, id.x, id.y, id.z, value)
    }
}

/// One step of a mip chain, as a kernel sees it: the level it writes, each invocation its own
/// texel (`id.x`, `id.y`), and the level before it, which it reads. A kernel's `mut MipStep<F>`
/// parameter, for which CPU code passes `tex.mip_step(i)`. What it computes from the level
/// before is the kernel's: a filtered average (`generate_mips`), the farthest of a depth
/// pyramid's texels, a bloom's blur.
pub struct MipStep<F: Storage> {
    unused: u32,
}

impl<F: Storage> MipStep<F> {
    /// The level it reads's texel at (`x`, `y`), unfiltered.
    pub fn load(self, x: u32, y: u32) -> F::Texel {
        mip_step_load(self, x, y)
    }

    /// The level it reads's width and height.
    pub fn source_size(self) -> vec2u {
        vec2u(mip_step_width(self), mip_step_height(self))
    }

    /// Writes `value` to the invocation's own texel of the level it writes.
    pub fn store(mut self, id: GlobalId, value: F::Texel) {
        mip_step_store(mut self, id.x, id.y, value)
    }
}

impl<F: Storage + Filtered> MipStep<F> {
    /// The level it reads, filtered by `s` at (`u`, `v`) in [0, 1]: any GPU code.
    pub fn sample(self, s: Sampler, uv: vec2) -> F::Texel {
        mip_step_sample(self, s, uv)
    }
}

@compute(8, 8)
fn downsample<F: Storage + Filtered>(step: mut MipStep<F>, s: Sampler, size: vec2u, id: GlobalId) {
    if id.x < size.x && id.y < size.y {
        let uv = (vec2(f32(id.x), f32(id.y)) + vec2(0.5)) / vec2(f32(size.x), f32(size.y))
        step.store(id, step.sample(s, uv))
    }
}

/// Fills levels 1 to the last of `tex` from level 0, each the average of the level before it
/// (`s`, a linear sampler, filters each texel from the four under it): `levels - 1` dispatches,
/// each binding level `i - 1` to read and level `i` to write, never the whole chain (WebGPU
/// refuses a binding that both reads and writes a level). A `Storage` and `Filtered` format,
/// made by `writable_texture`.
pub fn generate_mips<F: Storage + Filtered>(tex: mut Texture<F>, s: Sampler) {
    let levels = tex.levels
    for i in 1..levels {
        let size = vec2u(level_side(tex.width, i), level_side(tex.height, i))
        let groups = ((size.x + 7) / 8, (size.y + 7) / 8, 1)
        dispatch(downsample.bind(tex.mip_step(i), s, size), groups: groups)
    }
}

@intrinsic
fn new_texture(width: u32, height: u32, format: u32, kind: u32, layers: u32, levels: u32) -> u32 {}

/// A texture of `format` (whose blocks are `block` texels square, `bytes` each), counted in
/// `memory()`.
fn create_texture_of(
    width: u32,
    height: u32,
    format: u32,
    kind: u32,
    layers: u32,
    levels: u32,
    bytes: u32,
    block: u32,
) -> u32 {
    let handle = new_texture(width, height, format, kind, layers, levels)
    count_memory(1, texture_bytes(width, height, layers, levels, bytes, block), add: true)
    handle
}

/// A texture's bytes as the hosts count them: each level's blocks, for each layer (a 3D
/// texture's depth counts as its layers).
fn texture_bytes(width: u32, height: u32, layers: u32, levels: u32, bytes: u32, block: u32) -> u64 {
    var total: u64 = 0
    for l in 0..levels {
        let w = blocks(level_side(width, l), block)
        let h = blocks(level_side(height, l), block)
        total += u64(w) * u64(h) * u64(bytes)
    }
    total * u64(layers)
}

/// Destroys texture `handle`, its bytes uncounted from `memory()`.
fn drop_texture(handle: u32, bytes: u64) {
    destroy_texture(handle)
    count_memory(1, bytes, add: false)
}

@intrinsic
fn write_texture_rows(
    handle: u32,
    level: u32,
    layer: u32,
    x: u32,
    y: u32,
    width: u32,
    height: u32,
    bytes: [u8],
    from: u32,
    count: u32,
) {}

@intrinsic
fn destroy_texture(handle: u32) {}

@intrinsic
fn create_sampler(
    linear: u32,
    repeat: u32,
    compare: u32,
    mip_linear: u32,
