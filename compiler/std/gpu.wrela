// ---- readback, indirect work and limits -------------------------------------------------------

/// Reads a span of a buffer back to the CPU, once the GPU work recorded before it is done: a
/// request, answered on a later call (§17.1). It's `nondet`: when the answer arrives depends on
/// the GPU.
pub fn read<T: GpuData + Plain>(span: GpuSpan<T>) -> Pending<T> {
    let n = size_of::<T>()
    let request = next_request()
    read_buffer_command(request, span.buffer.handle, span.start * n, span.count * n)
    Pending::new(request)
}

@intrinsic
fn read_buffer_command(request: u32, handle: u32, offset: u32, size: u32) {}

/// The GPU time of the passes and dispatches labelled `name` (`label`), in microseconds: a
/// request, answered with their time in the first frame from this one on that runs one, summed,
/// once the host has read it. It fails on a host that can't time GPU work (the CPU host, or a
/// GPU without timestamp queries). A host times only the work of a label asked for and not yet
/// answered, from the ask on in the order it was recorded, and none of the rest (whose passes
/// and dispatches then cost nothing more): to time a frame's work, ask before recording it. It's
/// `nondet`: the time is the device's. A program measures its own costs with it (a planner's,
/// say); a test can check that a cost was measured, but no test asserts how small it is.
pub fn timed(name: str) -> Pending<f32> {
    let request = next_request()
    timed_command(request, name)
    Pending::new(request)
}

@intrinsic
fn timed_command(request: u32, name: str) {}

/// The GPU's limits: the hosts open the device with the adapter's own, which are at least
/// WebGPU's defaults (8192-texel textures, 128 MiB buffers, and so on). A program that wants
/// more than the defaults asks, and adapts. It's `nondet`: another GPU gives other numbers.
/// (Pipelines are compiled for the defaults: a kernel's bindings and workgroup stay within
/// them.)
pub struct Limits: Copy {
    /// The widest and tallest texture.
    pub max_texture_size: u32,
    /// The largest buffer, in bytes: every buffer can be bound as storage.
    pub max_buffer_size: u32,
    pub max_storage_buffers_per_stage: u32,
    pub max_uniform_buffer_binding_size: u32,
    /// Workgroup-shared memory, in bytes.
    pub max_workgroup_storage_size: u32,
    pub max_workgroup_invocations: u32,
    pub max_workgroup_size: (u32, u32, u32),
    pub max_workgroups_per_dimension: u32,
}

/// The GPU's limits.
pub fn limits() -> Limits {
    Limits {
        max_texture_size: limit(0),
        max_buffer_size: limit(1),
        max_storage_buffers_per_stage: limit(2),
        max_uniform_buffer_binding_size: limit(3),
        max_workgroup_storage_size: limit(4),
        max_workgroup_invocations: limit(5),
        max_workgroup_size: (limit(6), limit(7), limit(8)),
        max_workgroups_per_dimension: limit(9),
    }
}

@intrinsic
fn limit(index: u32) -> u32 {}

/// The GPU's optional features (§18.10): the hosts open the device with every one the adapter
/// has, and a program checks before it records what needs one (a format's capability, a kernel
/// that uses subgroups), keeping a path for a device without it. None is required. It's
/// `nondet`: another GPU gives other answers. (Test mode's `features=none` shows a program a
/// device without them, so its fallback paths run on a device that has them.)
pub struct Features: Copy {
    /// Half floats in GPU code (`shader-f16`).
    pub f16: bool,
    /// Subgroup operations (`subgroups`): `subgroup_add` and the rest, and `SubgroupId`.
    pub subgroups: bool,
    /// The least and the most invocations a subgroup has (0 without `subgroups`).
    pub subgroup_min: u32,
    pub subgroup_max: u32,
    /// BC compressed textures (`texture-compression-bc`): `Bc1`, `Bc4`, `Bc5`, `Bc7`.
    pub bc: bool,
    /// ETC2 compressed textures: `Etc2Rgb8`.
    pub etc2: bool,
    /// ASTC compressed textures: `Astc4x4`.
    pub astc: bool,
    /// Whether the device could filter `R32Float`, `Rg32Float` and `Rgba32Float`
    /// (`float32-filterable`). Toolchain 0.6 doesn't sample them yet: they aren't `Filtered`.
    pub float32_filterable: bool,
    /// Draws blending into `R32Float`, `Rg32Float` and `Rgba32Float` (`float32-blendable`).
    pub float32_blendable: bool,
    /// Passes drawing into `Rg11b10Float` (`rg11b10ufloat-renderable`).
    pub rg11b10_renderable: bool,
    pub bgra8_storage: bool,
    /// GPU timing (`timestamp-query`): `timed`.
    pub timestamps: bool,
    /// Several indirect draws in one call (`draw_multi` draws them one by one without it).
    pub multi_draw_indirect: bool,
    /// Always true: every host requires it.
    pub indirect_first_instance: bool,
    /// 64-bit atomic minimum and maximum: false on every host, since neither WebGPU's core nor
    /// a shipped browser has them yet (docs/toolchain-gaps.md in rywible/wrela).
    pub atomic64_min_max: bool,
}

/// The GPU's optional features.
pub fn features() -> Features {
    let bits = limit(10)
    let has = |i: u32| (bits & (1 << i)) != 0
    Features {
        f16: has(0),
        subgroups: has(1),
        subgroup_min: limit(11),
        subgroup_max: limit(12),
        bc: has(2),
        etc2: has(3),
        astc: has(4),
        float32_filterable: has(5),
        float32_blendable: has(6),
        rg11b10_renderable: has(7),
        bgra8_storage: has(8),
        timestamps: has(9),
        multi_draw_indirect: has(10),
        indirect_first_instance: has(11),
        atomic64_min_max: false,
    }
}

// ---- workgroup memory, atomics, appending and maps (§18.4, §18.5) -------------------------------

/// Workgroup memory: `N` `T`s that all of a workgroup's invocations share, as a kernel's
/// `mut` parameter (CPU code doesn't pass it). Between barriers, each invocation writes only
/// its own chunk: `shared.write(shared.chunk(lid), k, value)`. Any invocation reads any element
/// with `shared.get(i)`. `barrier(mut shared)` separates a phase of writes from a phase of
/// reads; the compiler rejects a read of what another invocation may still be writing, or a
/// write of what another may still be reading, with no barrier between (E0609). Its elements
/// start zeroed.
pub struct Shared<T, const N: u32> {
    unused: u32,
}

/// The elements an invocation writes: element `first + k * stride`, for `k` below `len()`. Each
/// invocation's are its own, as its `LocalId` is.
pub struct Chunk: Copy {
    first: u32,
    stride: u32,
    count: u32,
}

impl Chunk {
    /// How many elements it has.
    pub fn len(self) -> u32 {
        self.count
    }

    /// Which element its `k`th is.
    pub fn index(self, k: u32) -> u32 {
        self.first + k * self.stride
    }
}

impl<T, const N: u32> Shared<T, N> {
    /// The chunk invocation `lid` writes: every `W`th element from its index in the workgroup,
    /// where `W` is the workgroup's size.
    pub fn chunk(self, lid: LocalId) -> Chunk {
        let first = local_index(lid)
        let stride = workgroup_invocations()
        let count = if first < N { (N - first + stride - 1) / stride } else { 0 }
        Chunk { first, stride, count }
    }

    /// Writes `value` to the `k`th element of `chunk`, this invocation's. A `k` past the chunk's
    /// end writes nothing.
    pub fn write(mut self, chunk: Chunk, k: u32, value: T) {
        if k < chunk.count {
            shared_set(mut self, chunk.first + k * chunk.stride, value)
        }
    }

    /// Element `i`, which any invocation may have written before the last barrier.
    pub fn get(self, i: u32) -> T {
        shared_get(self, i)
    }

    /// `N`.
    pub fn len(self) -> u32 {
        N
    }
}

/// Waits until every invocation of the workgroup has reached it: their writes to workgroup
/// memory before it are visible to every read after it. It must be reached by all of the
/// workgroup's invocations together, so it's in uniform control flow (E0608).
pub fn barrier<T, const N: u32>(shared: mut Shared<T, N>) {
    workgroup_barrier(mut shared)
}

/// Workgroup memory of `N` `u32`s that any of a workgroup's invocations may change at once,
/// each operation whole (a kernel's `mut SharedAtomics<N>` parameter; CPU code doesn't pass
/// it): a histogram's bins, a compaction's counters, a scatter to any index. Its elements start
/// zeroed. Its own operations need no barrier between them; a barrier (`atomics.barrier()`)
/// before reading what every invocation added sees all of it.
pub struct SharedAtomics<const N: u32> {
    unused: u32,
}

impl<const N: u32> SharedAtomics<N> {
    /// `N`.
    pub fn len(self) -> u32 {
        N
    }

    /// Element `i`.
    pub fn load(self, i: u32) -> u32 {
        atomic_load(self, i)
    }

    /// Sets element `i` to `value`: a scatter that can't race.
    pub fn store(mut self, i: u32, value: u32) {
        atomic_store(mut self, i, value)
    }

    /// Adds `value` to element `i`; the element's old value.
    pub fn add(mut self, i: u32, value: u32) -> u32 {
        atomic_add(mut self, i, value)
    }

    /// Sets element `i` to the smaller of it and `value`; the element's old value.
    pub fn min(mut self, i: u32, value: u32) -> u32 {
        atomic_min(mut self, i, value)
    }

    /// Sets element `i` to the larger of it and `value`; the element's old value.
    pub fn max(mut self, i: u32, value: u32) -> u32 {
        atomic_max(mut self, i, value)
    }

    /// Sets element `i` to its bitwise and with `value`; the element's old value.
    pub fn and(mut self, i: u32, value: u32) -> u32 {
        atomic_and(mut self, i, value)
    }

    /// Sets element `i` to its bitwise or with `value`; the element's old value.
    pub fn or(mut self, i: u32, value: u32) -> u32 {
        atomic_or(mut self, i, value)
    }

    /// Sets element `i` to its bitwise exclusive or with `value`; the element's old value.
    pub fn xor(mut self, i: u32, value: u32) -> u32 {
        atomic_xor(mut self, i, value)
    }

    /// Sets element `i` to `value`; the element's old value.
    pub fn exchange(mut self, i: u32, value: u32) -> u32 {
        atomic_exchange(mut self, i, value)
    }

    /// Stores `new` if element `i` is `expected`: the old value, which is `expected` exactly
    /// when it stored.
    pub fn compare_exchange(mut self, i: u32, expected: u32, new: u32) -> u32 {
        strong_compare_exchange(mut self, i, expected, new)
    }

    /// Waits until every invocation of the workgroup has reached it: what each added before it
    /// is in every element read after it. In uniform control flow (E0608).
    pub fn barrier(mut self) {
        atomics_barrier(mut self)
    }
}

/// `SharedAtomics<N>` of `i32`s: workgroup memory any invocation changes at once, each operation
/// whole, for signed counts and a signed minimum or maximum.
pub struct SharedAtomicsI<const N: u32> {
    unused: u32,
}

impl<const N: u32> SharedAtomicsI<N> {
    /// `N`.
    pub fn len(self) -> u32 {
        N
    }

    /// Element `i`.
    pub fn load(self, i: u32) -> i32 {
        atomic_load(self, i)
    }

    /// Sets element `i` to `value`: a scatter that can't race.
    pub fn store(mut self, i: u32, value: i32) {
        atomic_store(mut self, i, value)
    }

    /// Adds `value` to element `i`; the element's old value.
    pub fn add(mut self, i: u32, value: i32) -> i32 {
        atomic_add(mut self, i, value)
    }

    /// Sets element `i` to the smaller of it and `value`; the element's old value.
    pub fn min(mut self, i: u32, value: i32) -> i32 {
        atomic_min(mut self, i, value)
    }

    /// Sets element `i` to the larger of it and `value`; the element's old value.
    pub fn max(mut self, i: u32, value: i32) -> i32 {
        atomic_max(mut self, i, value)
    }

    /// Sets element `i` to its bitwise and with `value`; the element's old value.
    pub fn and(mut self, i: u32, value: i32) -> i32 {
        atomic_and(mut self, i, value)
    }

    /// Sets element `i` to its bitwise or with `value`; the element's old value.
    pub fn or(mut self, i: u32, value: i32) -> i32 {
        atomic_or(mut self, i, value)
    }

    /// Sets element `i` to its bitwise exclusive or with `value`; the element's old value.
    pub fn xor(mut self, i: u32, value: i32) -> i32 {
        atomic_xor(mut self, i, value)
    }

    /// Sets element `i` to `value`; the element's old value.
    pub fn exchange(mut self, i: u32, value: i32) -> i32 {
        atomic_exchange(mut self, i, value)
    }

    /// Stores `new` if element `i` is `expected`: the old value, which is `expected` exactly
    /// when it stored.
    pub fn compare_exchange(mut self, i: u32, expected: i32, new: i32) -> i32 {
        strong_compare_exchange(mut self, i, expected, new)
    }

    /// Waits until every invocation of the workgroup has reached it: what each added before it
    /// is in every element read after it. In uniform control flow (E0608).
    pub fn barrier(mut self) {
        atomics_barrier(mut self)
    }
}

/// A barrier on workgroup atomics (`SharedAtomics<N>`, `SharedAtomicsI<N>`).
@intrinsic
fn atomics_barrier<A>(shared: mut A) {}

/// The sum of `value` over the invocations of the workgroup before this one (by `LocalId`'s
/// index: an exclusive prefix sum), the building block of a compaction: each invocation's place
/// in a list of what's kept. `shared` holds one element for each of the workgroup's
/// invocations (`N` its size); after the call, element `N - 1` plus the last invocation's
/// `value` is the workgroup's total, and the scan's last step leaves each element its inclusive
/// sum. A Hillis–Steele scan: log2(N) steps, each a barrier apart, so every invocation reaches it
/// (uniform control flow). `subgroup_prefix_sum` gives the same results on a device with
/// `subgroups`.
pub fn workgroup_prefix_sum<const N: u32>(
    shared: mut Shared<u32, N>,
    lid: LocalId,
    value: u32,
) -> u32 {
    let c = shared.chunk(lid)
    let i = c.index(0)
    shared.write(c, 0, value)
    barrier(mut shared)
    var sum = value
    var offset = 1
    while offset < N {
        let add = if i >= offset { shared.get(i - offset) } else { 0 }
        barrier(mut shared)
        sum += add
        shared.write(c, 0, sum)
        barrier(mut shared)
        offset = offset * 2
    }
    sum - value
}

// ---- subgroups (§18.10) --------------------------------------------------------------------------
//
// A subgroup is a set of a kernel's invocations that run in lockstep (a SIMD group: 32 on
// most GPUs, 4 to 128 on others): its operations combine their values without workgroup
// memory or barriers. Kernels only, on a device with `features().subgroups`; a pipeline that
// uses one needs the feature, and its program keeps a path without (`workgroup_prefix_sum`
// for `subgroup_prefix_sum`). Each is called by all of the workgroup's invocations together
// (uniform control flow, E0610). They take an `i32`, `u32`, `f32` or `f16`, or a vector of
// them, unless they say otherwise.

/// The sum of `x` over the subgroup.
@intrinsic
pub fn subgroup_add<T>(x: T) -> T {}

/// The sum of `x` over the invocations of the subgroup before this one (0 for the first).
@intrinsic
pub fn subgroup_exclusive_add<T>(x: T) -> T {}

/// The sum of `x` over the invocations of the subgroup up to this one.
@intrinsic
pub fn subgroup_inclusive_add<T>(x: T) -> T {}

/// The least `x` of the subgroup.
@intrinsic
pub fn subgroup_min<T>(x: T) -> T {}

/// The greatest `x` of the subgroup.
@intrinsic
pub fn subgroup_max<T>(x: T) -> T {}

/// The bitwise and of `x` (an `i32` or `u32`) over the subgroup.
@intrinsic
pub fn subgroup_and<T>(x: T) -> T {}

/// The bitwise or of `x` (an `i32` or `u32`) over the subgroup.
@intrinsic
pub fn subgroup_or<T>(x: T) -> T {}

/// The bitwise exclusive or of `x` (an `i32` or `u32`) over the subgroup.
@intrinsic
pub fn subgroup_xor<T>(x: T) -> T {}

/// Whether `b` is true for any invocation of the subgroup.
@intrinsic
pub fn subgroup_any(b: bool) -> bool {}

/// Whether `b` is true for every invocation of the subgroup.
@intrinsic
pub fn subgroup_all(b: bool) -> bool {}

/// A bit for each invocation of the subgroup, set where `b` is true: invocation `i`'s is bit
/// `i % 32` of component `i / 32`.
@intrinsic
pub fn subgroup_ballot(b: bool) -> vec4u {}

/// `x` of the subgroup's first active invocation.
@intrinsic
pub fn subgroup_broadcast_first<T>(x: T) -> T {}

/// `x` of invocation `from` of the subgroup.
@intrinsic
pub fn subgroup_shuffle<T>(x: T, from: u32) -> T {}

/// A compaction's places with subgroup operations: each invocation gets the sum of `value` over
/// the invocations before it in the workgroup's subgroup order, an exclusive scan, so the places
/// are distinct and dense (0 to the workgroup's total) on any GPU. The order is the subgroups'
/// by their first invocation's `LocalId` index, then each subgroup's own: WGSL leaves which
/// invocations share a subgroup to the GPU, so the order may not be `LocalId`'s. Where subgroups
/// are runs of consecutive indices (every GPU this toolchain has run on forms them so for a
/// one-dimensional workgroup), the results are `workgroup_prefix_sum`'s exactly; a compaction
/// that must keep `LocalId` order uses that one. One barrier, not `workgroup_prefix_sum`'s
/// 2 log2(N) + 1.
/// `shared` holds one element for each of the workgroup's invocations (`N` its size); after the
/// call, each subgroup's first invocation's element holds its subgroup's total and the others
/// 0. Uniform control flow. Its subgroups may be partial (a workgroup size that isn't a multiple
/// of theirs): each reads `N` divided by its own invocations' count.
pub fn subgroup_prefix_sum<const N: u32>(
    shared: mut Shared<u32, N>,
    lid: LocalId,
    value: u32,
) -> u32 {
    let c = shared.chunk(lid)
    let i = c.index(0)
    let mine = subgroup_exclusive_add(value)
    let total = subgroup_add(value)
    // The subgroup's invocations, ranked among those it has: a subgroup may have fewer than its
    // width (the workgroup's last), and WGSL doesn't say which lanes they are. Rank 0 is the
    // lowest lane, whose index `subgroup_broadcast_first` gives, and it writes the total there.
    let rank = subgroup_exclusive_add(1)
    let count = subgroup_add(1)
    let first = subgroup_broadcast_first(i)
    shared.write(c, 0, if rank == 0 { total } else { 0 })
    barrier(mut shared)
    // The totals of the subgroups whose first invocation comes before this one's: every element
    // below `first`, each rank taking every `count`th, then summed across the subgroup.
    var partial = 0
    var k = rank
    while k < first {
        partial += shared.get(k)
        k += count
    }
    subgroup_add(partial) + mine
}

/// An indirect draw's arguments (`draw(pass, vs, fs, indirect: buf)`, of a `GpuBuffer` or span of
/// these): its vertices and instances, its first vertex and first instance. GPU code writes
/// them; the draw reads them.
pub struct DrawArgs: Copy + GpuData {
    pub vertices: u32,
    pub instances: u32,
    pub first_vertex: u32,
    pub first_instance: u32,
}

/// An indexed indirect draw's arguments (`draw(pass, vs, fs, indices: idx, indirect: buf)`): its
/// indices and instances, its first index, the vertex its indices count from, and its first
/// instance.
pub struct DrawIndexedArgs: Copy + GpuData {
    pub indices: u32,
    pub instances: u32,
    pub first_index: u32,
    pub base_vertex: i32,
    pub first_instance: u32,
}

/// An indirect dispatch's workgroup counts (`dispatch(k.bind(...), groups: buf)`).
pub struct DispatchArgs: Copy + GpuData {
    pub x: u32,
    pub y: u32,
    pub z: u32,
}

/// One value a kernel writes, from one invocation: the dispatch's first, (0, 0, 0) of its
/// `GlobalId`. A kernel's `mut One<T>` parameter, for which CPU code passes `mut buf` of a
/// `GpuBuffer<T>` (its first element) or a `GpuSpanMut<T>` (its first). Any invocation may
/// call `set` and `update`; only the first's does anything, so invocations never race for it.
pub struct One<T> {
    unused: u32,
}

impl<T: GpuData> One<T> {
    /// Writes `value`, in the dispatch's first invocation.
    pub fn set(mut self, id: GlobalId, value: T) {
        if first(id) {
            one_set(mut self, value)
        }
    }

    /// Writes `f` of the value before, in the dispatch's first invocation: a value kept from
    /// dispatch to dispatch (a running mean).
    pub fn update(mut self, id: GlobalId, f: fn(T) -> T) {
        if first(id) {
            one_set(mut self, f(one_get(self)))
        }
    }
}

/// Whether `id` is the dispatch's first invocation's.
fn first(id: GlobalId) -> bool {
    id.x == 0 && id.y == 0 && id.z == 0
}

@intrinsic
fn one_get<T>(o: One<T>) -> T {}

@intrinsic
fn one_set<T>(o: mut One<T>, value: T) {}

/// A texture of format `F` that a kernel writes, each invocation only its own texel: (`id.x`,
/// `id.y`) of its `GlobalId` (§18.4). A kernel's `mut Texels<F>` parameter, for which CPU code
/// passes `mut tex` of a `Texture<F>` made by `writable_texture`. A kernel reads what it writes
/// only through another pass's binding of the texture, never in the same dispatch.
pub struct Texels<F: Storage> {
    unused: u32,
}

impl<F: Storage> Texels<F> {
    /// Writes `value` to the invocation's own texel, (`id.x`, `id.y`).
    pub fn store(mut self, id: GlobalId, value: F::Texel) {
        texels_store(mut self, id.x, id.y, value)
    }
}

/// A 3D texture of format `F` that a kernel writes, each invocation only its own texel:
/// (`id.x`, `id.y`, `id.z`) of its `GlobalId`. A kernel's `mut Texels3d<F>` parameter, for which
/// CPU code passes `mut tex` of a `Texture3d<F>`. As with `Texels`, a kernel reads what it
/// writes only through another pass's binding of the texture.
pub struct Texels3d<F: Storage> {
    unused: u32,
}

impl<F: Storage> Texels3d<F> {
    /// Writes `value` to the invocation's own texel, (`id.x`, `id.y`, `id.z`).
    pub fn store(mut self, id: GlobalId, value: F::Texel) {
        texels3d_store(mut self, id.x, id.y, id.z, value)
    }
}

/// Integers that every invocation of a dispatch may change at once: a kernel's `mut
/// Atomics<u32>` or `mut Atomics<i32>` parameter, for which CPU code passes `mut buf` of a
/// `GpuBuffer<u32>` (or `<i32>`). Each operation on an element happens whole, before or after
/// every other invocation's on it, and gives the element's old value.
pub struct Atomics<T> {
    unused: u32,
}

impl<T> Atomics<T> {
    /// How many elements it holds.
    pub fn len(self) -> u32 {
        atomic_len(self)
    }

    /// Element `i`.
    pub fn load(self, i: u32) -> T {
        atomic_load(self, i)
    }

    /// Sets element `i` to `value`.
    pub fn store(mut self, i: u32, value: T) {
        atomic_store(mut self, i, value)
    }

    /// Adds `value` to element `i`; the element's old value.
    pub fn add(mut self, i: u32, value: T) -> T {
        atomic_add(mut self, i, value)
    }

    /// Subtracts `value` from element `i`; the element's old value.
    pub fn sub(mut self, i: u32, value: T) -> T {
        atomic_sub(mut self, i, value)
    }

    /// Sets element `i` to the smaller of it and `value`; the element's old value.
    pub fn min(mut self, i: u32, value: T) -> T {
        atomic_min(mut self, i, value)
    }

    /// Sets element `i` to the larger of it and `value`; the element's old value.
    pub fn max(mut self, i: u32, value: T) -> T {
        atomic_max(mut self, i, value)
    }

    /// Sets element `i` to its bitwise and with `value`; the element's old value.
    pub fn and(mut self, i: u32, value: T) -> T {
        atomic_and(mut self, i, value)
    }

    /// Sets element `i` to its bitwise or with `value`; the element's old value.
    pub fn or(mut self, i: u32, value: T) -> T {
        atomic_or(mut self, i, value)
    }

    /// Sets element `i` to its bitwise exclusive or with `value`; the element's old value.
    pub fn xor(mut self, i: u32, value: T) -> T {
        atomic_xor(mut self, i, value)
    }

    /// Sets element `i` to `value`; the element's old value.
    pub fn exchange(mut self, i: u32, value: T) -> T {
        atomic_exchange(mut self, i, value)
    }
}

impl<T: Eq + Copy> Atomics<T> {
    /// Stores `new` if element `i` is `expected`: the old value, which is `expected` exactly
    /// when it stored.
    pub fn compare_exchange(mut self, i: u32, expected: T, new: T) -> T {
        strong_compare_exchange(mut self, i, expected, new)
    }
}

/// A kernel's output of any number of `T`s, in no particular order: its `mut Append<T>`
/// parameter, for which CPU code passes `mut` an `AppendBuffer<T>`. `out.push(value)` takes
/// the next free place; a push past the buffer's capacity is counted but kept nowhere.
pub struct Append<T> {
    unused: u32,
}

impl<T> Append<T> {
    /// Takes the next free place for `value`, and returns its index. An index at or past the
    /// buffer's capacity was counted but kept nowhere.
    pub fn push(mut self, value: T) -> u32 {
        append_push(mut self, value)
    }
}

/// What a kernel appends to (`Append<T>`): room for `capacity` `T`s, and how many were pushed.
pub struct AppendBuffer<T> {
    items: GpuBuffer<T>,
    // The count: one `u32`, then 1 and 1, so it's an indirect dispatch's group counts too.
    count: GpuBuffer<u32>,
}

/// An `AppendBuffer` with room for `capacity` `T`s, empty.
pub fn append_buffer<T: GpuData>(capacity: u32) -> AppendBuffer<T> {
    let count: GpuBuffer<u32> = buffer_of([0, 1, 1])
    AppendBuffer { items: buffer(capacity), count }
}

impl<T: GpuData> AppendBuffer<T> {
    /// Empties it: what's pushed after starts at the start again.
    pub fn clear(mut self) {
        write(mut self.count, 0, [0])
    }

    /// Room for how many.
    pub fn capacity(self) -> u32 {
        self.items.len()
    }

    /// The items: the first `count` of them were pushed (to read back, or pass on).
    pub fn items(self) -> GpuSpan<T> {
        self.items.items()
    }

    /// The items, for a kernel to change in place (where it takes `mut Slots<T>`).
    pub fn items_mut(mut self) -> GpuSpanMut<T> {
        self.items.items_mut()
    }

    /// How many were pushed, the first of three `u32`s (then 1 and 1): to read back, or as an
    /// indirect dispatch's group counts.
    pub fn count(self) -> GpuSpan<u32> {
        self.count.span(start: 0, count: 3)
    }
}

/// A map from `u32` keys to `u32` values that every invocation of a dispatch may change at once:
/// a kernel's `mut AtomicMap` parameter, for which CPU code passes `mut` an `AtomicMapBuffer`.
/// It holds at most its capacity of keys; the key `EMPTY` can't be stored.
pub struct AtomicMap {
    unused: u32,
}

/// The key no entry has.
pub const EMPTY: u32 = 4294967295

impl AtomicMap {
    /// Where key `key` is, or would go: its slot, and whether this call claimed it; `EMPTY`
    /// if the map is full of other keys.
    fn slot(mut self, key: u32, claim: bool) -> (u32, bool) {
        let cap = atomic_len(self) / 2
        var at = hash_key(key) % cap
        for _ in 0..cap {
            let there = atomic_load(self, 2 * at)
            if there == key {
                return (at, false)
            }
            if there == EMPTY {
                if !claim {
                    return (EMPTY, false)
                }
                let old = strong_compare_exchange(mut self, 2 * at, EMPTY, key)
                if old == EMPTY {
                    return (at, true)
                }
                if old == key {
                    return (at, false)
                }
            }
            at = (at + 1) % cap
        }
        (EMPTY, false)
    }

    /// Sets `key`'s value if it has none yet: whether it had none (and the map had room).
    pub fn insert(mut self, key: u32, value: u32) -> bool {
        if key == EMPTY {
            return false
        }
        let (at, claimed) = self.slot(key, claim: true)
        if at == EMPTY || !claimed {
            return false
        }
        // A claimed slot starts at 0. Addition keeps increments from other invocations that
        // reach the same key while its initial value is being added.
        atomic_add(mut self, 2 * at + 1, value)
        true
    }

    /// Adds `delta` to `key`'s value (from 0 if it had none): whether the map had room.
    pub fn add(mut self, key: u32, delta: u32) -> bool {
        if key == EMPTY {
            return false
        }
        let (at, _) = self.slot(key, claim: true)
        if at == EMPTY {
            return false
        }
        atomic_add(mut self, 2 * at + 1, delta)
        true
    }

    /// `key`'s value, if it has one. A new key starts at 0 while an `insert` in another
    /// invocation adds its initial value; read in a later dispatch to see completed inserts.
    pub fn get(mut self, key: u32) -> Option<u32> {
        if key == EMPTY {
            return None
        }
        let (at, _) = self.slot(key, claim: false)
        if at == EMPTY {
            return None
        }
        Some(atomic_load(self, 2 * at + 1))
    }
}

/// A key's first slot: its bits mixed, so near keys spread out.
fn hash_key(key: u32) -> u32 {
    let h = key.wrapping_mul(2654435761)
    h ^ (h >> 16)
}

/// What a kernel's `AtomicMap` lives in: room for `capacity` keys, each with its value.
pub struct AtomicMapBuffer {
    entries: GpuBuffer<u32>,
}

/// An empty `AtomicMapBuffer` with room for `capacity` keys.
pub fn atomic_map_buffer(capacity: u32) -> AtomicMapBuffer {
    let initial = Vec::from_fn(2 * capacity, |i| if i % 2 == 0 { EMPTY } else { 0 })
    AtomicMapBuffer { entries: buffer_of(initial) }
}

impl AtomicMapBuffer {
    /// Its entries, key then value: an unused slot's key is `EMPTY`, its value 0. To read back.
    pub fn entries(self) -> GpuSpan<u32> {
        self.entries.items()
    }
}

/// The invocation's index in its workgroup: `x`, then `y` rows, then `z` layers.
@intrinsic
fn local_index(lid: LocalId) -> u32 {}

/// The workgroup's size: how many invocations it has.
@intrinsic
fn workgroup_invocations() -> u32 {}

@intrinsic
fn shared_get<T, const N: u32>(shared: Shared<T, N>, i: u32) -> T {}

@intrinsic
fn shared_set<T, const N: u32>(shared: mut Shared<T, N>, i: u32, value: T) {}

@intrinsic
fn workgroup_barrier<T, const N: u32>(shared: mut Shared<T, N>) {}

@intrinsic
fn texels_store<F: Storage>(t: mut Texels<F>, x: u32, y: u32, value: F::Texel) {}

@intrinsic
fn texels3d_store<F: Storage>(t: mut Texels3d<F>, x: u32, y: u32, z: u32, value: F::Texel) {}

@intrinsic
fn texels_array_store<F: Storage>(
    t: mut TexelsArray<F>,
    x: u32,
    y: u32,
    layer: u32,
    value: F::Texel,
) {}

@intrinsic
fn mip_step_store<F: Storage>(m: mut MipStep<F>, x: u32, y: u32, value: F::Texel) {}

@intrinsic
fn atomic_len<A>(a: A) -> u32 {}

@intrinsic
fn atomic_load<A, T>(a: A, i: u32) -> T {}

@intrinsic
fn atomic_store<A, T>(a: mut A, i: u32, value: T) {}

@intrinsic
fn atomic_add<A, T>(a: mut A, i: u32, value: T) -> T {}

@intrinsic
fn atomic_sub<A, T>(a: mut A, i: u32, value: T) -> T {}

@intrinsic
fn atomic_min<A, T>(a: mut A, i: u32, value: T) -> T {}

@intrinsic
fn atomic_max<A, T>(a: mut A, i: u32, value: T) -> T {}

@intrinsic
fn atomic_and<A, T>(a: mut A, i: u32, value: T) -> T {}

@intrinsic
fn atomic_or<A, T>(a: mut A, i: u32, value: T) -> T {}

@intrinsic
fn atomic_xor<A, T>(a: mut A, i: u32, value: T) -> T {}

@intrinsic
fn atomic_exchange<A, T>(a: mut A, i: u32, value: T) -> T {}

/// Stores `new` at element `i` if it's `expected`: the old value, and whether it stored. It may
/// not store though they're equal (WGSL's `atomicCompareExchangeWeak`).
@intrinsic
fn atomic_compare_exchange<A, T>(a: mut A, i: u32, expected: T, new: T) -> (T, bool) {}

/// As `atomic_compare_exchange`, but trying again when it didn't store though it could have:
/// the old value, `expected` exactly when it stored.
fn strong_compare_exchange<A, T: Eq + Copy>(a: mut A, i: u32, expected: T, new: T) -> T {
    loop {
        let (old, stored) = atomic_compare_exchange(mut a, i, expected, new)
        if stored || old != expected {
            return old
        }
    }
}

@intrinsic
fn append_push<T>(a: mut Append<T>, value: T) -> u32 {}

// ---- lossy encodings ----------------------------------------------------------------------------
// A layout never loses precision on its own: a type that does says so in its name. Each packs
// into one `u32`, which every GPU buffer can hold, and decodes with the same code on both
// targets.

/// Four values in [0, 1], 8 bits each: colours. Each decodes to the nearest of 256 steps, so
/// within 0.5/255 of what was encoded, once that's clamped to [0, 1].
pub struct Unorm8x4: Copy + GpuData + Eq {
    pub bits: u32,
}

impl Unorm8x4 {
    /// `v`, clamped to [0, 1] and rounded to the nearest of 256 steps.
    pub fn encode(v: vec4) -> Unorm8x4 {
        let q = clamp(v, vec4(0.0), vec4(1.0)) * 255.0 + vec4(0.5)
        Unorm8x4 { bits: u32(q.x) | (u32(q.y) << 8) | (u32(q.z) << 16) | (u32(q.w) << 24) }
    }

    /// The four values, each in [0, 1].
    pub fn decode(self) -> vec4 {
        let b = self.bits
        vec4(f32(b & 255), f32((b >> 8) & 255), f32((b >> 16) & 255), f32(b >> 24)) / 255.0
    }
}

/// Two `f32`s as IEEE half floats, rounded to nearest, ties to even: within 2⁻¹¹ of the value
/// relatively where |x| is in [2⁻¹⁴, 65504], and within 2⁻²⁵ absolutely below that. Larger
/// values become infinite; a NaN stays a NaN.
pub struct Half2: Copy + GpuData + Eq {
    pub bits: u32,
}

/// `x` as a half float's 16 bits, rounded to nearest, ties to even.
fn to_half(x: f32) -> u32 {
    let b = bitcast_u32(x)
    let sign = (b >> 16) & 32768
    let e = i32((b >> 23) & 255)
    let m = b & 8388607
    if e == 255 {
        // Infinity, or a NaN (kept a NaN: a mantissa bit set).
        return sign | 31744 | (if m != 0 { 512 } else { 0 })
    }
    let he = e - 112
    if he >= 31 {
        return sign | 31744
    }
    if he <= 0 {
        // A subnormal half, or zero: the mantissa with its implicit bit, shifted into place.
        if he < -10 {
            return sign
        }
        let full = m | 8388608
        let shift = u32(14 - he)
        var h = full >> shift
        let rest = full & ((1 << shift) - 1)
        let halfway = 1 << (shift - 1)
        if rest > halfway || (rest == halfway && (h & 1) == 1) {
            h += 1
        }
        return sign | h
    }
    var h = (u32(he) << 10) | (m >> 13)
    let rest = m & 8191
    if rest > 4096 || (rest == 4096 && (h & 1) == 1) {
        // A carry into the exponent is right: the next binade, or infinity.
        h += 1
    }
    sign | h
}

/// A half float's 16 bits as an `f32`, exactly.
fn from_half(h: u32) -> f32 {
    let sign = (h & 32768) << 16
    let e = (h >> 10) & 31
    let m = h & 1023
    if e == 0 {
        // Zero or subnormal: m × 2⁻²⁴, exact in an f32.
        let v = f32(m) * 5.9604645e-8
        return if sign != 0 { -v } else { v }
    }
    if e == 31 {
        return bitcast_f32(sign | 2139095040 | (m << 13))
    }
    bitcast_f32(sign | ((e + 112) << 23) | (m << 13))
}

impl Half2 {
    /// `v`, each value rounded to the nearest half float.
    pub fn encode(v: vec2) -> Half2 {
        Half2 { bits: to_half(v.x) | (to_half(v.y) << 16) }
    }

    /// The two values, as `f32`s.
    pub fn decode(self) -> vec2 {
        vec2(from_half(self.bits & 65535), from_half(self.bits >> 16))
    }
}

/// A unit vector, octahedral, 16 bits a coordinate: normals. It decodes within 1.5 × 10⁻⁴
/// radians of the direction encoded, in the worst case.
pub struct Oct32: Copy + GpuData + Eq {
    pub bits: u32,
}

impl Oct32 {
    /// `n`'s direction; `n` needn't be unit length, but mustn't be zero.
    pub fn encode(n: vec3) -> Oct32 {
        let s = abs(n.x) + abs(n.y) + abs(n.z)
        var p = vec2(n.x, n.y) / s
        if n.z < 0.0 {
            p = vec2((1.0 - abs(p.y)) * sign_of(p.x), (1.0 - abs(p.x)) * sign_of(p.y))
        }
        let q = clamp(p, vec2(-1.0), vec2(1.0)) * 32767.0
        let x = u32(i32(round(q.x)) + 32768)
        let y = u32(i32(round(q.y)) + 32768)
        Oct32 { bits: x | (y << 16) }
    }

    /// The unit vector it holds.
    pub fn decode(self) -> vec3 {
        let p = vec2(f32(i32(self.bits & 65535) - 32768), f32(i32(self.bits >> 16) - 32768)) /
            32767.0
        var n = vec3(p.x, p.y, 1.0 - abs(p.x) - abs(p.y))
        if n.z < 0.0 {
            n = vec3((1.0 - abs(n.y)) * sign_of(n.x), (1.0 - abs(n.x)) * sign_of(n.y), n.z)
        }
        normalize(n)
    }
}

/// 1 for x ≥ 0, else -1: the octahedral fold's sign, which `sign` would make 0 at 0.
fn sign_of(x: f32) -> f32 {
    if x >= 0.0 { 1.0 } else { -1.0 }
}
