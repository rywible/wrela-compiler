// A tool's time (language.md §15.5): a timer, which a tool waits on as on any request, and the
// date. Both are requests: `after(s).wait()` sleeps, and a timer's `Call` can be waited on with
// others (`std::tool::any`). The date is the system's clock, which can go back; for how long
// work takes, `std::time::now` is the clock that never does.

use std::serialize::{Reader, Writer}
use std::tool::{Answer, Call, Done, ToolError, ask, malformed}

/// Answered, with no bytes, once `seconds` have passed. A negative or not-finite time fails the
/// request.
@tool
pub fn after(seconds: f64) -> Call<Done> {
    var w = Writer::new()
    w.write_u64(bitcast_u64(seconds))
    ask("time/after", take w.into_bytes())
}

/// The date and time now, in UTC, from the system's clock.
@tool
pub fn utc_now() -> Call<Utc> {
    ask("time/utc", [u8(0); 0])
}

/// A time in UTC: the seconds since 1970-01-01T00:00:00Z, and the nanoseconds after them.
pub struct Utc: Copy + Eq {
    pub seconds: u64,
    pub nanos: u32,
}

/// A `utc_now` answer: the seconds (a `u64`), then the nanoseconds (a `u32`).
impl Answer for Utc {
    fn read(bytes: take Vec<u8>) -> Result<Utc, ToolError> {
        var r = Reader::new(take bytes)
        let Ok(seconds) = r.read_u64() else { return Err(malformed("a date")) }
        let Ok(nanos) = r.read_u32() else { return Err(malformed("a date")) }
        if !r.at_end() || nanos >= 1000000000 {
            return Err(malformed("a date"))
        }
        Ok(Utc { seconds, nanos })
    }
}

@test
fn a_utc_answer_reads_back() {
    let Ok(t) = Utc::read(Vec::from([u8(1), 0, 0, 0, 0, 0, 0, 0, 2, 0, 0, 0])) else {
        panic("a time")
    }
    assert(t.seconds == 1 && t.nanos == 2)
    assert(Utc::read(Vec::from([u8(1)])).is_err(), "a short time")
}
