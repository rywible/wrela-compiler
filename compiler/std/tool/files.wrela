// A tool's files (language.md §15.5): roots that `wrela tool` grants by name, `--read NAME=DIR`
// and `--write NAME=DIR` (a write root may be read too). A path is `NAME/relative/path`, with `/`
// between its parts and none of them empty, `.` or `..`; `NAME` alone is the root itself. The
// host opens every path relative to its root's directory, so nothing reaches outside the root,
// through a symbolic link either, even one put in its place after a check. A path outside the
// roots, or a change to a root granted for reading, fails the request.
//
// Each function makes one request at once and gives its `Call`. A whole file read or written at
// once is at most 512 KiB (`MOST_BYTES`); a larger one goes through a blob (`read_blob`,
// `write_blob`).

use std::serialize::{Reader, Writer}
use std::tool::{Answer, Call, Done, MOST_BYTES, ToolError, ask, malformed}
use std::tool::blob::Blob

/// What a path names.
pub enum Kind: Copy + Eq {
    File,
    Dir,
    /// A symbolic link, as a directory lists it.
    Link,
    /// Anything else: a socket, a device.
    Other,
}

/// A directory's entry (`list`), or what's at a path (`stat`): its name (empty for `stat`), its
/// kind and its size in bytes.
pub struct Entry: Clone {
    pub name: String,
    pub kind: Kind,
    pub size: u64,
}

fn path_body(path: str) -> Vec<u8> {
    var w = Writer::new()
    w.write_str(path)
    take w.into_bytes()
}

/// The bytes of the file at `path`, at most 512 KiB: a larger file fails the request (read it
/// with `read_blob`).
@tool
pub fn read(path: str) -> Call<Vec<u8>> {
    ask("files/read", path_body(path))
}

/// Writes `bytes` as the whole file at `path`, in a write root, making the directories it needs.
/// The bytes are at most 512 KiB; more panics (write a blob with `write_blob`).
@tool
pub fn write(path: str, bytes: [u8]) -> Call<Done> {
    if bytes.len() > MOST_BYTES {
        panic("files::write: more than 512 KiB at once: write a blob (`write_blob`)")
    }
    var w = Writer::new()
    w.write_str(path)
    w.write_bytes(bytes)
    ask("files/write", take w.into_bytes())
}

/// The entries of the directory at `path`, sorted by name.
@tool
pub fn list(path: str) -> Call<Vec<Entry>> {
    ask("files/list", path_body(path))
}

/// What's at `path`: its kind and size, following a link inside the root.
@tool
pub fn stat(path: str) -> Call<Entry> {
    ask("files/stat", path_body(path))
}

/// Removes the file, link or empty directory at `path`, in a write root.
@tool
pub fn remove(path: str) -> Call<Done> {
    ask("files/remove", path_body(path))
}

/// Removes the directory at `path` and everything in it, in a write root. A root itself can't be
/// removed.
@tool
pub fn remove_all(path: str) -> Call<Done> {
    ask("files/remove_all", path_body(path))
}

/// Makes the directory at `path` and those above it that aren't there, in a write root.
@tool
pub fn make_dirs(path: str) -> Call<Done> {
    ask("files/make_dirs", path_body(path))
}

/// The file at `path`, whatever its size, as a new blob (`std::tool::blob`).
@tool
pub fn read_blob(path: str) -> Call<Blob> {
    ask("files/read_blob", path_body(path))
}

/// Writes the bytes of `blob` as the whole file at `path`, in a write root, making the
/// directories it needs. The blob stays the tool's.
@tool
pub fn write_blob(path: str, blob: Blob) -> Call<Done> {
    var w = Writer::new()
    w.write_str(path)
    w.write_u32(blob.id())
    ask("files/write_blob", take w.into_bytes())
}

fn read_kind(r: mut Reader) -> Option<Kind> {
    match r.read_u8() {
        Ok(0) => Some(Kind::File),
        Ok(1) => Some(Kind::Dir),
        Ok(2) => Some(Kind::Link),
        Ok(3) => Some(Kind::Other),
        _ => None,
    }
}

/// A `list` answer: a count, then each entry's name, its kind (a byte: file, directory, link,
/// other) and its size (a `u64`).
impl Answer for Vec<Entry> {
    fn read(bytes: take Vec<u8>) -> Result<Vec<Entry>, ToolError> {
        var r = Reader::new(take bytes)
        let Ok(n) = r.read_u32() else { return Err(malformed("a list of files")) }
        var out: Vec<Entry> = Vec::new()
        for _ in 0..n {
            let Ok(name) = r.read_string() else { return Err(malformed("a list of files")) }
            let Some(kind) = read_kind(mut r) else { return Err(malformed("a list of files")) }
            let Ok(size) = r.read_u64() else { return Err(malformed("a list of files")) }
            out.push(Entry { name, kind, size })
        }
        if !r.at_end() {
            return Err(malformed("a list of files"))
        }
        Ok(out)
    }
}

/// A `stat` answer: its kind (a byte) and its size (a `u64`).
impl Answer for Entry {
    fn read(bytes: take Vec<u8>) -> Result<Entry, ToolError> {
        var r = Reader::new(take bytes)
        let Some(kind) = read_kind(mut r) else { return Err(malformed("a file's kind and size")) }
        let Ok(size) = r.read_u64() else { return Err(malformed("a file's kind and size")) }
        if !r.at_end() {
            return Err(malformed("a file's kind and size"))
        }
        Ok(Entry { name: String::new(), kind, size })
    }
}

@test
fn a_list_has_the_hosts_layout() {
    var w = Writer::new()
    w.write_u32(2)
    w.write_str("a.txt")
    w.write_u8(0)
    w.write_u64(5)
    w.write_str("sub")
    w.write_u8(1)
    w.write_u64(0)
    let Ok(list) = Vec::<Entry>::read(take w.into_bytes()) else { panic("a list") }
    assert(list.len() == 2 && list[0].name.as_str() == "a.txt" && list[0].size == 5)
    assert(list[0].kind == Kind::File && list[1].kind == Kind::Dir)
    assert(Vec::<Entry>::read(Vec::from([u8(1), 0, 0, 0])).is_err(), "a short list")
    let Ok(e) = Entry::read(Vec::from([u8(2), 9, 0, 0, 0, 0, 0, 0, 0])) else { panic("an entry") }
    assert(e.kind == Kind::Link && e.size == 9)
}

/// `path`, as a command line gives it (relative to the directory root `root` stands for), as a
/// path in that root: `root/path`, `root` itself for `.`, or `None` if it isn't a plain relative
/// path (absolute, or with a part that's empty, `.` or `..`). A leading `./` and trailing `/`s
/// are dropped.
pub fn rooted(root: str, path: str) -> Option<String> {
    var to = path.len()
    while to > 1 && path.byte(to - 1) == 47 {
        to -= 1
    }
    let whole = path.slice(0, to)
    if whole == "." {
        return Some(String::from(root))
    }
    let from = if whole.starts_with("./") { 2 } else { 0 }
    let p = path.slice(from, to)
    if p.is_empty() || p.starts_with("/") {
        return None
    }
    for range in p.split("/") {
        let (a, b) = range
        let part = p.slice(a, b)
        if part.is_empty() || part == "." || part == ".." {
            return None
        }
    }
    Some(f"{root}/{p}")
}

@test
fn command_line_paths_are_rooted_or_refused() {
    let cases: [(Text, Text); 5] = [
        ("examples/piano", "ws/examples/piano"),
        ("./build/x.wav", "ws/build/x.wav"),
        ("out/", "ws/out"),
        (".", "ws"),
        ("a/b/c", "ws/a/b/c"),
    ]
    for (given, want) in cases {
        let Some(got) = rooted("ws", given) else { panic(given) }
        assert(got.as_str() == want, got.as_str())
    }
    for bad in ["", "/etc", "a/../b", "a//b", "a/./b"] {
        assert(rooted("ws", bad).is_none(), bad)
    }
}
