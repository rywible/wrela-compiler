// A tool's driven builds (language.md §15.5): a build loaded on the native host beside the
// tool, with the GPU or on the CPU alone, in a process of its own, and run in steps: `init`,
// frames and ticks with a `std::input::Script`, its exports called and its voice rendered, the
// screen captured, the state's hash, its phases, its GPU buffers and the commands it recorded.
// It's the host `wrela-host` runs, so the same build and script give the same hash.
//
// `steps` runs a list of steps on a loaded build, in order, in one request, and gives what they
// saw (a `Seen`); `run` loads a build, runs its steps and closes it, in one request. After a
// trap, the steps that run code are skipped, and those that only observe still run: a build
// that trapped can still be observed, by later requests too.
//
// A build is a directory in a root (what `toolchain::build` writes). The host opens it, its
// root and its storage through the grants, and gives them, open, to the build's process, which
// opens nothing by a path. The host compiles each build once in a run, and keeps its code in
// the code cache, outside every root. Each request has a deadline, 60 s unless it asks for
// another (at most 600 s), from when the host takes it: past it, or when the tool ends, the
// host kills the build's process, and the build can't be observed after it. One request runs
// at a time on a build: another fails while one runs. The host closes every build when the
// tool ends.
//
// An answer's inline part (all but its blobs) is at most 512 KiB: a request whose steps would
// see more fails, saying which step. Every blob (a screen, a buffer's bytes, a voice's samples)
// is reserved in the tool's blob budget before its bytes are read back or rendered: one that
// doesn't fit fails the request before it's read.
//
// A driven build's posts (`std::io::post`) go to the tool: `posts` gives those it made, and
// `answer` answers each (or `fail` fails it), which the program reads from its next call on.
// A build holds at most 64 posts unanswered, each of at most 512 KiB; past them, a post fails
// at once.

use std::input::Script
use std::serialize::{Reader, Writer}
use std::tool::{Answer, Call, Done, MOST_BYTES, ToolError, ask, malformed, read_list, read_strings}
use std::tool::blob
use std::tool::blob::{Data, read_data, write_data}

/// How a GPU build's passes and dispatches are timed (`wrela-host --timestamps`): not at all,
/// beside each other, or each alone.
pub enum Timing: Copy + Eq {
    Off,
    Span,
    Serial,
}

/// How to load a build: with a GPU (a real one: the host never renders in software) or on the
/// CPU alone; its screen's size; its frames' rate; how many threads run its parallel jobs (the
/// program's own among them; 0: one per core); how a GPU build is timed; how long each helper
/// holds a job's result back, in microseconds (a test's slow jobs); whether it records the
/// commands it submits, for `commands`; where its storage is (`std::io::store`'s files: a
/// directory in a write root, kept when the build closes, so another load reads what this one
/// stored; empty, a directory of the host's, removed with the build); and how long loading may
/// take in seconds (0: 60 s).
pub struct Load: Clone {
    pub gpu: bool,
    pub width: u32,
    pub height: u32,
    pub fps: f64,
    pub workers: u32,
    pub timing: Timing,
    pub hold: u32,
    pub record: bool,
    pub storage: String,
    pub timeout: f64,
}

/// A load on the CPU alone: a 640×360 screen at 60 frames a second, a thread per core, no held
/// jobs.
pub fn cpu() -> Load {
    Load {
        gpu: false,
        width: 640,
        height: 360,
        fps: 60.0,
        workers: 0,
        timing: Timing::Off,
        hold: 0,
        record: false,
        storage: String::new(),
        timeout: 0.0,
    }
}

/// A load with the GPU, as `cpu()` otherwise.
pub fn gpu() -> Load {
    var l = cpu()
    l.gpu = true
    l
}

/// A driven build: its handle, from a `load` answer.
pub struct Build: Copy + Eq {
    id: u32,
}

impl Build {
    /// Its handle's number, as the host names it.
    pub fn id(self) -> u32 {
        self.id
    }
}

/// Where a load's code came from: compiled for it, read from the code cache (an earlier run
/// compiled it), or compiled earlier in this run (a load of the same build).
pub enum Code: Copy + Eq {
    Compiled,
    Cached,
    Reused,
}

/// A loaded build, how long loading it took, in seconds, and where its code came from.
pub struct Loaded: Copy {
    pub build: Build,
    pub elapsed: f64,
    pub code: Code,
}

/// A number an export takes or returns (§15.2): an `i32` (a `u32`, a `bool` or a small integer
/// crosses as one), an `i64`'s bits, an `f32` or an `f64`.
pub enum Scalar: Copy {
    I32(i32),
    I64(u64),
    F32(f32),
    F64(f64),
}

/// A step of a `steps` request. Those that run the build's code: `Init`, its `init`, once,
/// before any other; `Frames(n, script)`, its next `n` frames in lockstep with its ticker if it
/// has one (as `wrela-host` runs them), with `script`'s events by their frames counted from the
/// build's first; `FrameAt(time)`, one frame at `time` seconds, outside lockstep (the program's
/// `frame(time, width, height)`, waiting for no ticks: a camera's, a light's or a jitter's
/// time); `Ticks(n, script)`, the next `n` ticks of a build loaded on the CPU alone, with no
/// frames, each with `script`'s records of it (as `wrela-host --no-gpu`); `Call(export, args)`,
/// an export called with at most 64 arguments; and `Audio(quanta, timed)`, the voice's next
/// quanta rendered offline (`std::audio::QUANTUM` samples each, in each channel, as
/// `wrela-host` renders them), and with `timed` one at a time, each timed. Those that observe:
/// `Capture`, a GPU build's screen; `Hash`, the state hash of everything it submitted since it
/// loaded (FNV-1a 64, as `wrela-host` prints it); `Phases`, the phases it timed on all its
/// threads; `Buffers`, the GPU buffers a GPU build holds, oldest first; `ReadBuffer(handle)`,
/// one's bytes, read back from the GPU; `Commands`, the commands a build loaded with `record`
/// submitted since the last `Commands`; and `Running`, the root path of the build that runs
/// (after a hand-over, `std::reload::hand_over`, the one handed over to). Those that change
/// what its requests see: `Hold(path)`, its fetches and storage reads of `path` (inside its
/// build or its storage) held from then on, each carried out but not answered, as a late file
/// is; and `Release(path)`, the path let go, its held requests answered from the build's next
/// call on.
pub enum Step: Clone {
    Init,
    Frames(u32, Script),
    FrameAt(f32),
    Ticks(u32, Script),
    Call(String, Vec<Scalar>),
    Audio(u32, bool),
    Capture,
    Hash,
    Phases,
    Buffers,
    ReadBuffer(u32),
    Commands,
    Running,
    Hold(String),
    Release(String),
}

/// What a trap happened in: `init`, a frame, a tick, an export's call or the voice.
pub enum Stage: Copy + Eq {
    Init,
    Frame,
    Tick,
    Call,
    Audio,
}

/// A trap: the host's message (which says the tick, for a trap in one, and where), the panic's
/// own message (empty if it wasn't a panic), where in the source (empty if the build doesn't
/// say), what it happened in, the frame's or tick's number, and the index of the step it ended
/// (in the request where it happened).
pub struct Trap: Clone {
    pub message: String,
    pub panic: String,
    pub at: String,
    pub stage: Stage,
    pub number: u32,
    pub step: u32,
}

/// When a frame or a tick started and ended: seconds since the build loaded.
pub struct Span: Copy {
    pub start: f64,
    pub end: f64,
}

/// What a step that runs code gave: when it started and how long it took (seconds), each frame
/// or tick that ran to its end, and an export's results.
pub struct Ran: Clone {
    pub started: f64,
    pub elapsed: f64,
    pub spans: Vec<Span>,
    pub results: Vec<Scalar>,
}

/// A GPU build's screen: its size, and its pixels, RGBA8, rows top to bottom, in a blob.
pub struct Capture: Clone {
    pub width: u32,
    pub height: u32,
    pub rgba: Data,
}

/// A buffer a command binds: its handle, and the range bound (offset and size in bytes; a size
/// of 0 is the whole buffer, or a texture or sampler).
pub struct Bound: Copy {
    pub handle: u32,
    pub offset: u32,
    pub size: u32,
}

/// A command a build submitted: its opcode's name (`Draw`, `Dispatch`, `Label`, ...: the
/// runtime/abi stream's); a label's name; the name of the pipeline a dispatch or a draw uses
/// (its manifest's); a dispatch's workgroups; the resources it binds, in order; what a
/// host-facing command names (a storage path, a fetch's or a post's URL, a host request's
/// service, a build's path); and the bytes a storage write, a post or a host request carries.
/// What a command doesn't have is empty or 0. Each batch begins with a `Batch` of its own.
pub struct Recorded: Clone {
    pub kind: String,
    pub label: String,
    pub pipeline: String,
    pub groups: vec3u,
    pub bindings: Vec<Bound>,
    pub target: String,
    pub bytes: Vec<u8>,
}

/// The commands a build recorded since the last `Commands`, the oldest first, and how many more
/// wait for the next: a step gives at most 65,536 of them, and as many as the answer has room
/// for. One that no answer holds fails the request, and is dropped.
pub struct Commands: Clone {
    pub commands: Vec<Recorded>,
    pub waiting: u32,
}

/// A phase a build timed (`std::time::phase`): its name, its seconds summed, how many times.
pub struct Phase: Clone {
    pub name: String,
    pub seconds: f64,
    pub times: u32,
}

/// A voice's samples, rendered offline: `f32`s, little-endian, the channels interleaved (left,
/// right, left, ...), at `std::audio::SAMPLE_RATE`, in a blob; and if asked, each quantum's
/// seconds to render, `f64`s, little-endian, in another.
pub struct Audio: Clone {
    pub samples: Data,
    pub times: Option<Data>,
}

/// What a request's steps saw, each kind in the order of its steps: a `Ran` for each step that
/// ran code (`Init`, `Frames`, `FrameAt`, `Ticks`, `Call`; one that trapped too, with the frames
/// or ticks it finished), and each observation; the lines the build printed during the steps,
/// every one up to 256 MiB of them (`dropped_lines` counts those past it), which `lines(mut seen)`
/// gives: in `lines` if they all fit the answer (a line of more than 256 KiB cut, with a note),
/// else whole in the blob `log`, each followed by a newline (and `lines` empty); and the
/// build's first trap, in this request or before it.
pub struct Seen: Clone {
    pub ran: Vec<Ran>,
    pub captures: Vec<Capture>,
    pub hashes: Vec<u64>,
    pub phases: Vec<Vec<Phase>>,
    pub audio: Vec<Audio>,
    pub buffers: Vec<Vec<u32>>,
    pub bytes: Vec<Data>,
    pub commands: Vec<Commands>,
    pub running: Vec<String>,
    pub lines: Vec<String>,
    pub log: Option<Data>,
    pub dropped_lines: u32,
    pub trap: Option<Trap>,
}

/// Every line the build printed during the steps that saw `seen`, in order, whether they came
/// in the answer or in its blob (read now, 512 KiB at a time). The blob is the tool's to hold
/// until it is released, so this releases it, also when it can't be read, and leaves `seen.log`
/// empty: its bytes go back to the blob budget. A line holding a newline of its own is two
/// lines here.
@tool
pub fn lines(seen: mut Seen) -> Result<Vec<String>, ToolError> {
    let bytes = match replace(mut seen.log, None) {
        None => return Ok(seen.lines.clone()),
        Some(Data::Bytes(b)) => take b,
        Some(Data::Blob(blob)) => {
            let read = read_log(blob)
            if let Err(e) = blob::release(blob).wait() {
                return Err(take e)
            }
            match take read {
                Ok(b) => take b,
                Err(e) => return Err(take e),
            }
        },
    }
    match split_lines(take bytes) {
        Some(out) => Ok(out),
        None => Err(malformed("a build's printed lines")),
    }
}

/// The bytes of a log's blob, 512 KiB at a time.
@tool
fn read_log(blob: blob::Blob) -> Result<Vec<u8>, ToolError> {
    let total = blob::len(blob).wait()?
    var bytes: Vec<u8> = Vec::new()
    var at: u64 = 0
    while at < total {
        var chunk = blob::read(blob, at, MOST_BYTES).wait()?
        if chunk.is_empty() {
            return Err(malformed("a build's printed lines"))
        }
        at += u64(chunk.len())
        bytes.append(mut chunk)
    }
    Ok(bytes)
}

/// The lines of `bytes`, each followed by a newline, as UTF-8: `None` if they aren't.
fn split_lines(bytes: take Vec<u8>) -> Option<Vec<String>> {
    var out: Vec<String> = Vec::new()
    var line: Vec<u8> = Vec::new()
    for b in bytes {
        if b == 10 {
            let Some(text) = String::from_utf8(take line) else { return None }
            out.push(take text)
            line = Vec::new()
        } else {
            line.push(b)
        }
    }
    Some(out)
}

/// A post the build made (`std::io::post`), which waits for the tool's answer: its number,
/// which `answer` names, the URL it was sent to, and its body.
pub struct Post: Clone {
    pub id: u32,
    pub url: String,
    pub body: Data,
}

fn handle_body(b: Build) -> Writer {
    var w = Writer::new()
    w.write_u32(b.id)
    w
}

fn timeout_ask<T: Answer>(service: str, w: take Writer, timeout: f64) -> Call<T> {
    var w = take w
    w.write_u64(bitcast_u64(timeout))
    ask(service, take w.into_bytes())
}

/// Writes `options` as the host reads a load, its timeout last.
fn write_load(w: mut Writer, build: str, options: Load) {
    w.write_str(build)
    w.write_u8(if options.gpu { 1 } else { 0 })
    w.write_u32(options.width)
    w.write_u32(options.height)
    w.write_u64(bitcast_u64(options.fps))
    w.write_u32(options.workers)
    w.write_u8(u8(u32(options.timing)))
    w.write_u32(options.hold)
    w.write_u8(if options.record { 1 } else { 0 })
    w.write_str(options.storage.as_str())
    w.write_u64(bitcast_u64(options.timeout))
}

/// Writes `list` as the host reads steps: a count, then each step's kind and what it carries.
fn write_steps(w: mut Writer, list: [Step]) {
    w.write_u32(list.len())
    for s in list {
        match s {
            Step::Init => w.write_u8(0),
            Step::Frames(n, script) => {
                w.write_u8(1)
                w.write_u32(n)
                w.write_str(script.as_json())
            },
            Step::FrameAt(time) => {
                w.write_u8(2)
                w.write_u32(bitcast_u32(time))
            },
            Step::Ticks(n, script) => {
                w.write_u8(3)
                w.write_u32(n)
                w.write_str(script.as_json())
            },
            Step::Call(export, args) => {
                w.write_u8(4)
                w.write_str(export.as_str())
                w.write_u32(args.len())
                for a in args {
                    match a {
                        Scalar::I32(x) => {
                            w.write_u8(0)
                            w.write_u64(u64(u32(x)))
                        },
                        Scalar::I64(bits) => {
                            w.write_u8(1)
                            w.write_u64(bits)
                        },
                        Scalar::F32(x) => {
                            w.write_u8(2)
                            w.write_u64(u64(bitcast_u32(x)))
                        },
                        Scalar::F64(x) => {
                            w.write_u8(3)
                            w.write_u64(bitcast_u64(x))
                        },
                    }
                }
            },
            Step::Audio(quanta, timed) => {
                w.write_u8(5)
                w.write_u32(quanta)
                w.write_u8(if timed { 1 } else { 0 })
            },
            Step::Capture => w.write_u8(6),
            Step::Hash => w.write_u8(7),
            Step::Phases => w.write_u8(8),
            Step::Buffers => w.write_u8(9),
            Step::ReadBuffer(handle) => {
                w.write_u8(10)
                w.write_u32(handle)
            },
            Step::Commands => w.write_u8(11),
            Step::Running => w.write_u8(12),
            Step::Hold(path) => {
                w.write_u8(13)
                w.write_str(path.as_str())
            },
            Step::Release(path) => {
                w.write_u8(14)
                w.write_str(path.as_str())
            },
        }
    }
}

/// Loads the build in `build` (a root path) as `options` says, in a process of its own,
/// without running its `init`.
@tool
pub fn load(build: str, options: Load) -> Call<Loaded> {
    var w = Writer::new()
    write_load(mut w, build, options)
    ask("drive/load", take w.into_bytes())
}

/// Runs `list` (at most 1024 steps) on the build, in order, in one request: what they saw.
@tool
pub fn steps(b: Build, list: [Step], timeout: f64 = 0.0) -> Call<Seen> {
    var w = handle_body(b)
    write_steps(mut w, list)
    timeout_ask("drive/steps", take w, timeout)
}

/// Loads the build in `build` as `options` says (within the load's timeout), runs `list` on it
/// (within `timeout` from the load's end), and closes it, in one request: what the steps saw.
@tool
pub fn run(build: str, options: Load, list: [Step], timeout: f64 = 0.0) -> Call<Seen> {
    var w = Writer::new()
    write_load(mut w, build, options)
    write_steps(mut w, list)
    timeout_ask("drive/run", take w, timeout)
}

/// The posts the build made since the last `posts`, the oldest first: as many as an answer
/// holds, the rest at the next. Each waits for the tool's `answer`; the program sees the answer
/// from its next call on.
@tool
pub fn posts(b: Build) -> Call<Vec<Post>> {
    timeout_ask("drive/posts", handle_body(b), 0.0)
}

/// Answers post `post` of the build with `bytes`: the request fails if no such post waits.
@tool
pub fn answer(b: Build, post: u32, bytes: Data) -> Call<Done> {
    var w = handle_body(b)
    w.write_u32(post)
    write_data(mut w, bytes)
    timeout_ask("drive/answer", take w, 0.0)
}

/// Fails post `post` of the build, saying `why`: the program's request fails, as a post nothing
/// answers does. The request fails if no such post waits.
@tool
pub fn fail(b: Build, post: u32, why: str) -> Call<Done> {
    var w = handle_body(b)
    w.write_u32(post)
    w.write_str(why)
    timeout_ask("drive/fail", take w, 0.0)
}

/// Closes the build: its process goes, and the handle names nothing after this.
@tool
pub fn close(b: Build) -> Call<Done> {
    ask("drive/close", handle_body(b).into_bytes())
}

/// A `load` answer: the handle (a `u32`), the seconds loading took (an `f64`'s bits), then
/// where its code came from (a `u8`).
impl Answer for Loaded {
    fn read(bytes: take Vec<u8>) -> Result<Loaded, ToolError> {
        var r = Reader::new(take bytes)
        let Ok(id) = r.read_u32() else { return Err(malformed("a loaded build")) }
        let Ok(elapsed) = r.read_u64() else { return Err(malformed("a loaded build")) }
        let code = match r.read_u8() {
            Ok(0) => Code::Compiled,
            Ok(1) => Code::Cached,
            Ok(2) => Code::Reused,
            _ => return Err(malformed("a loaded build")),
        }
        if !r.at_end() {
            return Err(malformed("a loaded build"))
        }
        Ok(Loaded { build: Build { id }, elapsed: bitcast_f64(elapsed), code })
    }
}

/// A `Ran`: when it started and how long it took, each frame's or tick's start and end, then
/// each result's kind and bits.
fn read_ran(r: mut Reader) -> Option<Ran> {
    let Ok(started) = r.read_u64() else { return None }
    let Ok(elapsed) = r.read_u64() else { return None }
    let spans = read_list(mut r, read_span)?
    let results = read_list(mut r, read_scalar)?
    Some(Ran { started: bitcast_f64(started), elapsed: bitcast_f64(elapsed), spans, results })
}

/// A `Span`: its start and end.
fn read_span(r: mut Reader) -> Option<Span> {
    let Ok(start) = r.read_u64() else { return None }
    let Ok(end) = r.read_u64() else { return None }
    Some(Span { start: bitcast_f64(start), end: bitcast_f64(end) })
}

/// A `Scalar`: its kind, then its bits.
fn read_scalar(r: mut Reader) -> Option<Scalar> {
    let Ok(kind) = r.read_u8() else { return None }
    let Ok(bits) = r.read_u64() else { return None }
    let low = u32(bits & 4294967295)
    match kind {
        0 => Some(Scalar::I32(i32(low))),
        1 => Some(Scalar::I64(bits)),
        2 => Some(Scalar::F32(bitcast_f32(low))),
        3 => Some(Scalar::F64(bitcast_f64(bits))),
        _ => None,
    }
}

/// A `Capture`: the width and height (`u32`s), then the pixels (`blob::Data`).
fn read_capture(r: mut Reader) -> Option<Capture> {
    let Ok(width) = r.read_u32() else { return None }
    let Ok(height) = r.read_u32() else { return None }
    let Some(rgba) = read_data(mut r) else { return None }
    Some(Capture { width, height, rgba })
}

/// An `Audio`: the samples (`blob::Data`), then 1 and the times (`blob::Data`), or 0.
fn read_audio(r: mut Reader) -> Option<Audio> {
    let Some(samples) = read_data(mut r) else { return None }
    let times = read_maybe(mut r, read_data)?
    Some(Audio { samples, times })
}

/// 0, or 1 and an item `item` reads: `None` if it's neither.
fn read_maybe<T>(r: mut Reader, item: fn(mut Reader) -> Option<T>) -> Option<Option<T>> {
    match r.read_u8() {
        Ok(0) => Some(None),
        Ok(1) => Some(Some(item(mut r)?)),
        _ => None,
    }
}

/// A phase of a `Phases` step: its name, seconds and times.
fn read_phase(r: mut Reader) -> Option<Phase> {
    let Ok(name) = r.read_string() else { return None }
    let Ok(seconds) = r.read_u64() else { return None }
    let Ok(times) = r.read_u32() else { return None }
    Some(Phase { name, seconds: bitcast_f64(seconds), times })
}

/// A `Commands`: a count, each command (`read_recorded`), then how many wait.
fn read_commands(r: mut Reader) -> Option<Commands> {
    let commands = read_list(mut r, read_recorded)?
    let Ok(waiting) = r.read_u32() else { return None }
    Some(Commands { commands, waiting })
}

/// A `Recorded`: its kind, label, pipeline, workgroups, bindings, target and bytes.
fn read_recorded(r: mut Reader) -> Option<Recorded> {
    let Ok(kind) = r.read_string() else { return None }
    let Ok(label) = r.read_string() else { return None }
    let Ok(pipeline) = r.read_string() else { return None }
    var groups = vec3u(0)
    for k in 0..3 {
        let Ok(g) = r.read_u32() else { return None }
        groups[k] = g
    }
    let bindings = read_list(mut r, read_bound)?
    let Ok(target) = r.read_string() else { return None }
    let Ok(len) = r.read_u32() else { return None }
    let Ok(bytes) = r.read_bytes(len) else { return None }
    Some(Recorded { kind, label, pipeline, groups, bindings, target, bytes })
}

/// A `Bound`: its handle, offset and size.
fn read_bound(r: mut Reader) -> Option<Bound> {
    let Ok(handle) = r.read_u32() else { return None }
    let Ok(offset) = r.read_u32() else { return None }
    let Ok(size) = r.read_u32() else { return None }
    Some(Bound { handle, offset, size })
}

/// A `Trap`: its message, panic and place, its stage, its number and its step.
fn read_trap(r: mut Reader) -> Option<Trap> {
    let Ok(message) = r.read_string() else { return None }
    let Ok(panic_message) = r.read_string() else { return None }
    let Ok(at) = r.read_string() else { return None }
    let Ok(stage) = r.read_u8() else { return None }
    let Ok(number) = r.read_u32() else { return None }
    let Ok(step) = r.read_u32() else { return None }
    let stage = match stage {
        0 => Stage::Init,
        1 => Stage::Frame,
        2 => Stage::Tick,
        3 => Stage::Call,
        4 => Stage::Audio,
        _ => return None,
    }
    Some(Trap { message, panic: panic_message, at, stage, number, step })
}

/// Reads a `Seen` from `r`: each kind, a count then each, in `Seen`'s order; the lines, a count
/// then each, and how many were dropped; 1 and the log (`blob::Data`), or 0; then 1 and the
/// trap, or 0.
fn read_seen(r: mut Reader) -> Option<Seen> {
    let ran = read_list(mut r, read_ran)?
    let captures = read_list(mut r, read_capture)?
    let hashes = read_list(mut r, |r| r.read_u64().ok())?
    let phases = read_list(mut r, |r| read_list(mut r, read_phase))?
    let audio = read_list(mut r, read_audio)?
    let buffers = read_list(mut r, |r| read_list(mut r, |r| r.read_u32().ok()))?
    let bytes = read_list(mut r, read_data)?
    let commands = read_list(mut r, read_commands)?
    let running = read_strings(mut r)?
    let lines = read_strings(mut r)?
    let Ok(dropped_lines) = r.read_u32() else { return None }
    let log = read_maybe(mut r, read_data)?
    let trap = read_maybe(mut r, read_trap)?
    Some(
        Seen {
            ran,
            captures,
            hashes,
            phases,
            audio,
            buffers,
            bytes,
            commands,
            running,
            lines,
            log,
            dropped_lines,
            trap,
        },
    )
}

/// A `steps` or `run` answer: what the steps saw.
impl Answer for Seen {
    fn read(bytes: take Vec<u8>) -> Result<Seen, ToolError> {
        var r = Reader::new(take bytes)
        let Some(seen) = read_seen(mut r) else { return Err(malformed("what steps saw")) }
        if !r.at_end() {
            return Err(malformed("what steps saw"))
        }
        Ok(seen)
    }
}

/// A `posts` answer: a count, then each post's number, URL and body (`blob::Data`).
impl Answer for Vec<Post> {
    fn read(bytes: take Vec<u8>) -> Result<Vec<Post>, ToolError> {
        var r = Reader::new(take bytes)
        let Some(out) = read_list(mut r, read_post) else { return Err(malformed("posts")) }
        if !r.at_end() {
            return Err(malformed("posts"))
        }
        Ok(out)
    }
}

/// A post: its number, URL and body (`blob::Data`).
fn read_post(r: mut Reader) -> Option<Post> {
    let Ok(id) = r.read_u32() else { return None }
    let Ok(url) = r.read_string() else { return None }
    let Some(body) = read_data(mut r) else { return None }
    Some(Post { id, url, body })
}

/// Writes an empty kind: a count of 0.
fn none(w: mut Writer) {
    w.write_u32(0)
}

@test
fn what_steps_saw_reads_back_in_its_order() {
    var w = Writer::new()
    // One `Ran`: at 1.5 s for 0.25 s, one frame, one result.
    w.write_u32(1)
    w.write_u64(bitcast_u64(f64(1.5)))
    w.write_u64(bitcast_u64(f64(0.25)))
    w.write_u32(1)
    w.write_u64(bitcast_u64(f64(1.5)))
    w.write_u64(bitcast_u64(f64(1.75)))
    w.write_u32(1)
    w.write_u8(0)
    w.write_u64(u64(u32(i32(-3))))
    // One capture, 2×1, in blob 9.
    w.write_u32(1)
    w.write_u32(2)
    w.write_u32(1)
    w.write_u8(1)
    w.write_u32(9)
    // Two hashes.
    w.write_u32(2)
    w.write_u64(7)
    w.write_u64(8)
    // One `Phases`, of one phase.
    w.write_u32(1)
    w.write_u32(1)
    w.write_str("survey")
    w.write_u64(bitcast_u64(f64(0.5)))
    w.write_u32(3)
    // One voice, timed.
    w.write_u32(1)
    write_data(mut w, Data::Bytes(Vec::from([u8(0), 0, 128, 63])))
    w.write_u8(1)
    write_data(mut w, Data::Bytes(Vec::from([u8(1), 2, 3, 4, 5, 6, 7, 8])))
    // One `Buffers` of two; no bytes, no commands.
    w.write_u32(1)
    w.write_u32(2)
    w.write_u32(4)
    w.write_u32(5)
    none(mut w)
    none(mut w)
    // One `Running`; a line, two dropped; a trap in tick 20, at step 3.
    w.write_u32(1)
    w.write_str("src/b")
    w.write_u32(1)
    w.write_str("hello")
    w.write_u32(2)
    w.write_u8(0)
    w.write_u8(1)
    w.write_str("in tick 20: panic: no")
    w.write_str("no")
    w.write_str("main.wrela:9:5")
    w.write_u8(2)
    w.write_u32(20)
    w.write_u32(3)
    let Ok(seen) = Seen::read(take w.into_bytes()) else { panic("what steps saw") }
    let ran = seen.ran[0].clone()
    assert(ran.started == 1.5 && ran.elapsed == 0.25 && ran.spans.len() == 1)
    let Scalar::I32(x) = ran.results[0] else { panic("an i32") }
    assert(x == -3)
    assert(seen.captures[0].width == 2 && seen.captures[0].height == 1)
    let Data::Blob(id) = seen.captures[0].rgba.clone() else { panic("a blob") }
    assert(id.id() == 9)
    assert(seen.hashes.len() == 2 && seen.hashes[1] == 8)
    assert(seen.phases[0][0].name.as_str() == "survey" && seen.phases[0][0].times == 3)
    let Some(Data::Bytes(t)) = seen.audio[0].times.clone() else { panic("times") }
    assert(t.len() == 8)
    assert(seen.buffers[0].len() == 2 && seen.buffers[0][1] == 5)
    assert(seen.bytes.is_empty() && seen.commands.is_empty())
    assert(seen.running[0].as_str() == "src/b")
    assert(seen.lines[0].as_str() == "hello" && seen.dropped_lines == 2 && seen.log.is_none())
    let Some(trap) = seen.trap else { panic("a trap") }
    assert(trap.stage == Stage::Tick && trap.number == 20 && trap.step == 3)
    assert(trap.panic.as_str() == "no")
    assert(Seen::read(Vec::from([u8(1)])).is_err(), "a short answer")
}

@test
fn posts_read_back() {
    var w = Writer::new()
    w.write_u32(1)
    w.write_u32(7)
    w.write_str("notes/edit")
    write_data(mut w, Data::Bytes(Vec::from([u8(123), 125])))
    let Ok(posts) = Vec::<Post>::read(take w.into_bytes()) else { panic("posts") }
    assert(posts.len() == 1 && posts[0].id == 7 && posts[0].url.as_str() == "notes/edit")
    let Data::Bytes(b) = posts[0].body.clone() else { panic("bytes") }
    assert(b.len() == 2 && b[0] == 123)
    assert(Vec::<Post>::read(Vec::from([u8(1), 0, 0, 0])).is_err(), "a short answer")
}

@test
fn steps_are_written_as_the_host_reads_them() {
    var w = Writer::new()
    write_steps(
        mut w,
        [
            Step::Init,
            Step::FrameAt(0.5),
            Step::Call(String::from("add"), Vec::from([Scalar::I32(2)])),
            Step::Hash,
        ],
    )
    let bytes = take w.into_bytes()
    // 4 steps; 0; 2 and the time's bits; 4, "add", one i32; 7.
    assert(bytes.len() == 4 + 1 + 5 + (1 + 4 + 3 + 4 + 9) + 1)
    assert(bytes[0] == 4 && bytes[4] == 0 && bytes[5] == 2 && bytes[bytes.len() - 1] == 7)
}

@test
fn a_logs_lines_are_split_at_its_newlines() {
    var w = Writer::new()
    for _ in 0..9 {
        w.write_u32(0)
    }
    w.write_u32(0)
    w.write_u32(0)
    w.write_u8(1)
    write_data(mut w, Data::Bytes(Vec::from([u8(97), 10, 10, 98, 99, 10])))
    w.write_u8(0)
    let Ok(seen) = Seen::read(take w.into_bytes()) else { panic("what steps saw") }
    let Some(Data::Bytes(log)) = seen.log.clone() else { panic("a log") }
    let Some(all) = split_lines(take log) else { panic("lines") }
    assert(split_lines(Vec::from([u8(255), 10])).is_none(), "not UTF-8")
    assert(all.len() == 3 && all[0].as_str() == "a" && all[1].is_empty() && all[2].as_str() == "bc")
}
