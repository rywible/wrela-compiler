// A tool's toolchain (language.md §15.5): builds, tests, checks, formatting, queries and the
// reference docs of packages in the tool's roots, by the compiler's own code, in the tool host's
// process: what `wrela build`, `test`, `check`, `fmt`, `query` and `doc --export` do. A package
// and an output are root paths (`NAME/rel`); an output is in a write root.
//
// A lifted build's literals (§23) are a tool's to read and write: `literals` gives their values
// in the files as they are now (a live tool sends them to the running program), and `edit`
// writes new values of them by their index in the build through `wrela edit`'s code.
//
// The compiler reads only through the tool's roots: the package, its dependencies (one outside
// the roots is an error), its workspace's manifest and members, and the files it embeds. Its
// constants' cache is the host's, never beside a package. Each request has a deadline, 300 s
// unless it asks for another (at most 600 s, or the run's `--timeout` if that is longer), from
// when the host takes it; past it, or when the tool ends, the host stops the work (a constant
// being computed within about 10 ms), and kills `wasm-opt`'s process group if it runs.
//
// A program's errors aren't the request's: a build or a check with errors answers with them
// (`ok` false). A request fails for what the host can't do: a path outside the roots, a
// deadline passed.

use std::serialize::{Reader, Writer}
use std::tool::{Answer, Call, ToolError, ask, malformed, read_list, read_strings}

/// A diagnostic: whether it's an error (else a warning), its code (`E0220`), its message, where
/// it is (`file:line:column`, or empty), and the whole of it as `wrela check` shows it.
pub struct Diagnostic: Clone {
    pub error: bool,
    pub code: String,
    pub message: String,
    pub at: String,
    pub rendered: String,
}

/// A dependency read from another package than its manifest names: the dependency's name,
/// wherever a manifest declares it, and the package's directory (a root path).
pub struct Override: Clone {
    pub name: String,
    pub dir: String,
}

/// A constant of the program's root module given another value (`wrela build --set
/// NAME=VALUE`, §13): its name, and the value as the command line writes it (`8`, `true`,
/// `Medium`, `"cel"`).
pub struct Set: Clone {
    pub name: String,
    pub value: String,
}

/// How to build: through Binaryen's `wasm-opt` (`wrela build --optimize`), lifting the literals
/// of these packages (`--lift`), with dependencies read from other packages, with SIMD or
/// without, as a debug build or not, as a test build with the program's `@testing` exports or
/// not (`--testing`, §9), how long it may take in seconds (0: 300 s), and with constants set
/// (`--set`).
pub struct BuildOptions: Clone {
    pub optimize: bool,
    pub lift: Vec<String>,
    pub overrides: Vec<Override>,
    pub simd: bool,
    pub debug: bool,
    pub testing: bool,
    pub timeout: f64,
    pub set: Vec<Set> = Vec::new(),
}

/// What `wrela build` makes: no optimizing, lifting or overrides, SIMD, a release build, no
/// `@testing` exports.
pub fn options() -> BuildOptions {
    BuildOptions {
        optimize: false,
        lift: Vec::new(),
        overrides: Vec::new(),
        simd: true,
        debug: false,
        testing: false,
        timeout: 0.0,
        set: Vec::new(),
    }
}

/// A build: whether it has no errors, the files it wrote into its output (by their paths
/// there), its diagnostics, and how many constants it computed and read from the cache.
pub struct Built: Clone {
    pub ok: bool,
    pub files: Vec<String>,
    pub diagnostics: Vec<Diagnostic>,
    pub computed: u32,
    pub cached: u32,
}

/// One test's result: its name, where it is, whether it passed, why it failed (as `wrela test`
/// shows it), and what it printed.
pub struct TestResult: Clone {
    pub name: String,
    pub at: String,
    pub passed: bool,
    pub message: String,
    pub printed: Vec<String>,
}

/// A test run: whether every test passed, each test's result, the errors that kept the tests
/// from running, and how many the filter left out.
pub struct Tested: Clone {
    pub passed: bool,
    pub results: Vec<TestResult>,
    pub diagnostics: Vec<Diagnostic>,
    pub filtered_out: u32,
}

/// A check: whether it found no errors, what it found, and (with no errors) the pipelines the
/// package's build makes, as `wrela pipelines` counts them.
pub struct Checked: Clone {
    pub ok: bool,
    pub diagnostics: Vec<Diagnostic>,
    pub pipelines: Vec<Pipeline>,
}

/// A pipeline of a build (`wrela pipelines --json`): `compute` or `render`, its entry points
/// with their type arguments (`shade::<f32>`), and where CPU code dispatches or draws it
/// (`file:line:column`). A test asserts what a program reaches with them: no pipeline it didn't
/// reach before, say.
pub struct Pipeline: Clone {
    pub kind: String,
    pub entries: Vec<String>,
    pub sites: Vec<String>,
}

/// A file `fmt` couldn't format, and why (its syntax errors).
pub struct Unformatted: Clone {
    pub path: String,
    pub why: String,
}

/// What `fmt` did: the files it changed (or that a check found not formatted), and those it
/// couldn't format.
pub struct Formatted: Clone {
    pub changed: Vec<String>,
    pub failed: Vec<Unformatted>,
}

/// Builds the package at `pkg` into `out`, a directory in a write root, as `wrela build -o`
/// does: the same files, byte for byte. A file an earlier build wrote there and this one doesn't
/// is removed, and one no build wrote is left, and stops the build.
@tool
pub fn build(pkg: str, out: str, options: BuildOptions) -> Call<Built> {
    var w = Writer::new()
    w.write_str(pkg)
    w.write_str(out)
    w.write_u8(if options.optimize { 1 } else { 0 })
    w.write_u8(if options.simd { 1 } else { 0 })
    w.write_u8(if options.debug { 1 } else { 0 })
    w.write_u8(if options.testing { 1 } else { 0 })
    w.write_u32(options.lift.len())
    for l in options.lift {
        w.write_str(l.as_str())
    }
    write_overrides(mut w, options.overrides)
    w.write_u32(options.set.len())
    for s in options.set {
        w.write_str(s.name.as_str())
        w.write_str(s.value.as_str())
    }
    w.write_u64(bitcast_u64(options.timeout))
    ask("toolchain/build", take w.into_bytes())
}

/// Runs the tests of the package at `pkg` whose names hold `filter` (all, for ""), as `wrela
/// test` does. A tool test isn't run here (it needs `wrela
/// test`'s processes): it fails, saying so.
@tool
pub fn test(pkg: str, filter: str, timeout: f64 = 0.0) -> Call<Tested> {
    let none: [Override; 0] = []
    test_with(pkg, filter, none, timeout)
}

/// `test`, its dependencies read from other packages as `overrides` says (as a build's are).
@tool
pub fn test_with(pkg: str, filter: str, overrides: [Override], timeout: f64 = 0.0) -> Call<Tested> {
    var w = Writer::new()
    w.write_str(pkg)
    w.write_str(filter)
    write_overrides(mut w, overrides)
    w.write_u64(bitcast_u64(timeout))
    ask("toolchain/test", take w.into_bytes())
}

/// Checks the package at `pkg`, as `wrela check` does.
@tool
pub fn check(pkg: str, timeout: f64 = 0.0) -> Call<Checked> {
    let none: [Override; 0] = []
    check_with(pkg, none, timeout)
}

/// `check`, its dependencies read from other packages as `overrides` says (as a build's are).
@tool
pub fn check_with(pkg: str, overrides: [Override], timeout: f64 = 0.0) -> Call<Checked> {
    var w = Writer::new()
    w.write_str(pkg)
    write_overrides(mut w, overrides)
    w.write_u64(bitcast_u64(timeout))
    ask("toolchain/check", take w.into_bytes())
}

/// Each override's dependency name and package, after their count.
fn write_overrides(w: mut Writer, overrides: [Override]) {
    w.write_u32(overrides.len())
    for o in overrides {
        w.write_str(o.name.as_str())
        w.write_str(o.dir.as_str())
    }
}

/// Formats the `.wrela` files at `paths` (root paths of files, or of directories, each package's
/// files as `wrela check` reads them), as `wrela fmt` does; with `check`, writes nothing and
/// only says which aren't formatted (`wrela fmt --check`).
@tool
pub fn fmt(paths: [String], check: bool, timeout: f64 = 0.0) -> Call<Formatted> {
    var w = Writer::new()
    w.write_u32(paths.len())
    for p in paths {
        w.write_str(p.as_str())
    }
    w.write_u8(if check { 1 } else { 0 })
    w.write_u64(bitcast_u64(timeout))
    ask("toolchain/fmt", take w.into_bytes())
}

/// Writes the reference docs of std and `packages` into `out`, a new or empty directory in a
/// write root, as `wrela doc --export` does: their source is `repository` at `revision` ("" for
/// `main`), each package's files named by their paths in its root.
@tool
pub fn doc_export(
    packages: [String],
    out: str,
    repository: str,
    revision: str,
    timeout: f64 = 0.0,
) -> Call<u32> {
    var w = Writer::new()
    w.write_u32(packages.len())
    for p in packages {
        w.write_str(p.as_str())
    }
    w.write_str(out)
    w.write_str(repository)
    w.write_str(revision)
    w.write_u64(bitcast_u64(timeout))
    ask("toolchain/doc_export", take w.into_bytes())
}

/// Answers `queries` (as `wrela query` takes them: `type main.wrela:3:9`, `fields
/// main.wrela:3:9`, `callees main::step`) on the package at `pkg`, with one check, its
/// dependencies read from other packages as `overrides` says (as a build's are):
/// `wrela query --json`'s JSON.
@tool
pub fn query(
    pkg: str,
    queries: [String],
    overrides: [Override],
    timeout: f64 = 0.0,
) -> Call<String> {
    var w = Writer::new()
    w.write_str(pkg)
    w.write_u32(queries.len())
    for q in queries {
        w.write_str(q.as_str())
    }
    write_overrides(mut w, overrides)
    w.write_u64(bitcast_u64(timeout))
    ask("toolchain/query", take w.into_bytes())
}

/// The literals of the lifted build in `build` (a directory with its `lift.json`) of the program
/// at `program`: their values as the build has them, and in the files it lifted as they are now.
@tool
pub fn literals(program: str, build: str, timeout: f64 = 0.0) -> Call<Literals> {
    var w = Writer::new()
    w.write_str(program)
    w.write_str(build)
    w.write_u64(bitcast_u64(timeout))
    ask("toolchain/literals", take w.into_bytes())
}

/// Writes new values of the literals of the lifted build in `build` of the program at
/// `program`, each by its index in the build, into the files as they are now, through `wrela
/// edit`'s code: each literal keeps its form, and nothing is written if a file has changed past
/// its literals since the build, or if `wrela edit` refuses. The files are in write roots, and
/// each is replaced whole. The answer is `wrela edit --json`'s, on one line,
/// with `written` true, or `{"file", "why", "written": false}`.
@tool
pub fn edit(program: str, build: str, edits: [(u32, f32)], timeout: f64 = 0.0) -> Call<String> {
    var w = Writer::new()
    w.write_str(program)
    w.write_str(build)
    w.write_u32(edits.len())
    for e in edits {
        let (i, v) = e
        w.write_u32(i)
        w.write_u32(bitcast_u32(v))
    }
    w.write_u64(bitcast_u64(timeout))
    ask("toolchain/edit", take w.into_bytes())
}

/// A lifted build's literals now: the files it lifted (root paths), the literals' values as the
/// build has them, and their values in the files as they are now, or `None` if a file has
/// changed past its literals (it needs a new build).
pub struct Literals: Clone {
    pub files: Vec<String>,
    pub built: Vec<f32>,
    pub values: Option<Vec<f32>>,
}

/// A diagnostic: whether it's an error, its code, message, place and text.
fn read_diagnostic(r: mut Reader) -> Option<Diagnostic> {
    let Ok(error) = r.read_u8() else { return None }
    let Ok(code) = r.read_string() else { return None }
    let Ok(message) = r.read_string() else { return None }
    let Ok(at) = r.read_string() else { return None }
    let Ok(rendered) = r.read_string() else { return None }
    Some(Diagnostic { error: error != 0, code, message, at, rendered })
}

fn read_pipeline(r: mut Reader) -> Option<Pipeline> {
    let Ok(kind) = r.read_string() else { return None }
    let Some(entries) = read_strings(mut r) else { return None }
    let Some(sites) = read_strings(mut r) else { return None }
    Some(Pipeline { kind, entries, sites })
}

/// A `build` answer.
impl Answer for Built {
    fn read(bytes: take Vec<u8>) -> Result<Built, ToolError> {
        var r = Reader::new(take bytes)
        let Ok(ok) = r.read_u8() else { return Err(malformed("a build")) }
        let Some(files) = read_strings(mut r) else { return Err(malformed("a build")) }
        let Some(diagnostics) = read_list(mut r, read_diagnostic) else {
            return Err(malformed("a build"))
        }
        let Ok(computed) = r.read_u32() else { return Err(malformed("a build")) }
        let Ok(cached) = r.read_u32() else { return Err(malformed("a build")) }
        if !r.at_end() {
            return Err(malformed("a build"))
        }
        Ok(Built { ok: ok != 0, files, diagnostics, computed, cached })
    }
}

/// A `test` answer.
impl Answer for Tested {
    fn read(bytes: take Vec<u8>) -> Result<Tested, ToolError> {
        var r = Reader::new(take bytes)
        let Ok(passed) = r.read_u8() else { return Err(malformed("a test run")) }
        let Some(results) = read_list(mut r, read_result) else {
            return Err(malformed("a test run"))
        }
        let Some(diagnostics) = read_list(mut r, read_diagnostic) else {
            return Err(malformed("a test run"))
        }
        let Ok(filtered_out) = r.read_u32() else { return Err(malformed("a test run")) }
        if !r.at_end() {
            return Err(malformed("a test run"))
        }
        Ok(Tested { passed: passed != 0, results, diagnostics, filtered_out })
    }
}

/// A test's result: its name, place, whether it passed, its message and what it printed.
fn read_result(r: mut Reader) -> Option<TestResult> {
    let Ok(name) = r.read_string() else { return None }
    let Ok(at) = r.read_string() else { return None }
    let Ok(ok) = r.read_u8() else { return None }
    let Ok(message) = r.read_string() else { return None }
    let printed = read_strings(mut r)?
    Some(TestResult { name, at, passed: ok != 0, message, printed })
}

/// A `check` answer.
impl Answer for Checked {
    fn read(bytes: take Vec<u8>) -> Result<Checked, ToolError> {
        var r = Reader::new(take bytes)
        let Ok(ok) = r.read_u8() else { return Err(malformed("a check")) }
        let Some(diagnostics) = read_list(mut r, read_diagnostic) else {
            return Err(malformed("a check"))
        }
        let Some(pipelines) = read_list(mut r, read_pipeline) else {
            return Err(malformed("a check"))
        }
        if !r.at_end() {
            return Err(malformed("a check"))
        }
        Ok(Checked { ok: ok != 0, diagnostics, pipelines })
    }
}

/// A `fmt` answer.
impl Answer for Formatted {
    fn read(bytes: take Vec<u8>) -> Result<Formatted, ToolError> {
        var r = Reader::new(take bytes)
        let Some(changed) = read_strings(mut r) else { return Err(malformed("what was formatted")) }
        let Some(failed) = read_list(mut r, read_unformatted) else {
            return Err(malformed("what was formatted"))
        }
        if !r.at_end() {
            return Err(malformed("what was formatted"))
        }
        Ok(Formatted { changed, failed })
    }
}

/// A file `fmt` couldn't format: its path and why.
fn read_unformatted(r: mut Reader) -> Option<Unformatted> {
    let Ok(path) = r.read_string() else { return None }
    let Ok(why) = r.read_string() else { return None }
    Some(Unformatted { path, why })
}

/// A `literals` answer: the files, whether the values follow, then their count and each.
impl Answer for Literals {
    fn read(bytes: take Vec<u8>) -> Result<Literals, ToolError> {
        var r = Reader::new(take bytes)
        let Some(files) = read_strings(mut r) else { return Err(malformed("literals")) }
        let Some(built) = read_floats(mut r) else { return Err(malformed("literals")) }
        let Ok(has) = r.read_u8() else { return Err(malformed("literals")) }
        var values: Option<Vec<f32>> = None
        if has == 1 {
            let Some(v) = read_floats(mut r) else { return Err(malformed("literals")) }
            values = Some(take v)
        }
        if !r.at_end() {
            return Err(malformed("literals"))
        }
        Ok(Literals { files, built, values })
    }
}

/// A count of `f32`s, then each's bits, or `None`.
fn read_floats(r: mut Reader) -> Option<Vec<f32>> {
    read_list(mut r, |r| Some(bitcast_f32(r.read_u32().ok()?)))
}

@test
fn a_build_reads_back() {
    var w = Writer::new()
    w.write_u8(1)
    w.write_u32(1)
    w.write_str("game.wasm")
    w.write_u32(1)
    w.write_u8(0)
    w.write_str("W0003")
    w.write_str("a warning")
    w.write_str("main.wrela:1:1")
    w.write_str("warning[W0003]: a warning")
    w.write_u32(2)
    w.write_u32(3)
    let Ok(built) = Built::read(take w.into_bytes()) else { panic("a build") }
    assert(built.ok && built.files.len() == 1 && built.files[0].as_str() == "game.wasm")
    assert(built.diagnostics.len() == 1 && !built.diagnostics[0].error)
    assert(built.computed == 2 && built.cached == 3)
    assert(Built::read(Vec::from([u8(1), 9, 0, 0, 0])).is_err(), "more files than bytes")
}

@test
fn a_test_run_reads_back() {
    var w = Writer::new()
    w.write_u8(0)
    w.write_u32(1)
    w.write_str("fails")
    w.write_str("main.wrela:3:4")
    w.write_u8(0)
    w.write_str("on purpose")
    w.write_u32(1)
    w.write_str("a line")
    w.write_u32(0)
    w.write_u32(2)
    let Ok(t) = Tested::read(take w.into_bytes()) else { panic("a run") }
    assert(!t.passed && t.results.len() == 1 && !t.results[0].passed)
    assert(t.results[0].printed.len() == 1 && t.filtered_out == 2)
}

@test
fn literals_read_back() {
    var w = Writer::new()
    w.write_u32(1)
    w.write_str("ws/content/ball/subject.wrela")
    w.write_u32(2)
    w.write_u32(bitcast_u32(0.5))
    w.write_u32(bitcast_u32(-1.5))
    w.write_u8(1)
    w.write_u32(2)
    w.write_u32(bitcast_u32(0.25))
    w.write_u32(bitcast_u32(-1.5))
    let Ok(l) = Literals::read(take w.into_bytes()) else { panic("literals") }
    assert(l.files.len() == 1 && l.files[0].as_str() == "ws/content/ball/subject.wrela")
    assert(l.built.len() == 2 && l.built[0] == 0.5, "the build's values")
    let Some(v) = l.values else { panic("values") }
    assert(v.len() == 2 && v[0] == 0.25 && v[1] == -1.5)
    var x = Writer::new()
    x.write_u32(0)
    x.write_u32(0)
    x.write_u8(0)
    let Ok(stale) = Literals::read(take x.into_bytes()) else { panic("no values") }
    assert(stale.values.is_none(), "a file changed past its literals")
    assert(
        Literals::read(Vec::from([u8(0), 0, 0, 0, 0, 0, 0, 0, 1, 9])).is_err(),
        "a short answer",
    )
}
